{{!-- One sheet for every item type; the sections below switch on the type.
     DocumentSheetV2 supplies the <form> itself, as it does for the actor
     templates, so this part must not open one of its own. --}}
<div class="isheet">

  <header class="ihead blueprint">
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
    {{!-- The button carries the action and nothing else. A [data-edit] on it
         would be read by the form on every submit -- as the button's inner
         HTML, since it is not an <img> -- and sent to the item as its image,
         which no item could be saved with. --}}
    {{#if editable}}
      <button type="button" class="iimgbtn" data-action="editItemImage"
              aria-label="{{localize 'GWORLD.Item.EditImage'}}"
              title="{{localize 'GWORLD.Item.EditImage'}}">
        <img class="iimg editable" src="{{item.img}}" alt="" />
      </button>
    {{else}}
      <img class="iimg" src="{{item.img}}" alt="" />
    {{/if}}
    <div class="ihead-fields">
      <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'GWORLD.Item.Name'}}"
             aria-label="{{localize 'GWORLD.Item.Name'}}"
             {{#unless editable}}disabled{{/unless}} />
      <span class="itype">{{localize (concat "TYPES.Item." type)}}</span>
    </div>
  </header>

  <div class="isbody">
    {{> "gworld.addonSheetSections" sections=addonSheetSections.start}}

    {{#if isSkill}}
      <div class="ifields">
        <label>{{localize "GWORLD.Column.Attribute"}}
          <select name="system.attribute" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.attributes selected=system.attribute localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Column.Difficulty"}}
          <select name="system.difficulty" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.difficulties selected=system.difficulty localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Column.Pts"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Bonus"}}
          <input type="number" name="system.bonus" value="{{system.bonus}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.TechLevel"}}
          <input type="text" name="system.techLevel" value="{{system.techLevel}}" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>

      <div class="isub">
        <div class="isub-head">
          {{localize "GWORLD.Skill.Defaults"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addDefault">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each system.defaults as |d i|}}
          <div class="irow" data-index="{{i}}">
            <select name="system.defaults.{{i}}.from" aria-label="{{localize 'GWORLD.Skill.DefaultSource'}}" {{#unless @root.editable}}disabled{{/unless}}>
              <option value="attribute" {{#if (eq d.from "attribute")}}selected{{/if}}>{{localize "GWORLD.Skill.FromAttribute"}}</option>
              <option value="skill" {{#if (eq d.from "skill")}}selected{{/if}}>{{localize "GWORLD.Skill.FromSkill"}}</option>
            </select>
            <select name="system.defaults.{{i}}.attribute" aria-label="{{localize 'GWORLD.Column.Attribute'}}" {{#unless @root.editable}}disabled{{/unless}}>
              {{selectOptions @root.choices.attributes selected=d.attribute localize=true}}
            </select>
            <input type="text" name="system.defaults.{{i}}.skill" value="{{d.skill}}" aria-label="{{localize 'GWORLD.Column.Skill'}}"
                   placeholder="{{localize 'GWORLD.Column.Skill'}}" {{#unless @root.editable}}disabled{{/unless}} />
            <input type="number" name="system.defaults.{{i}}.modifier" value="{{d.modifier}}" aria-label="{{localize 'GWORLD.Item.DefaultModifier'}}" step="1"
                   {{#unless @root.editable}}disabled{{/unless}} />
            {{#if @root.editable}}
              <button type="button" class="rollable iconbtn" data-action="deleteDefault"
                    title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
            {{/if}}
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Skill.NoDefaultsYet"}}</p>
        {{/each}}
      </div>
    {{/if}}

    {{#if isTechnique}}
      <div class="ifields">
        <label>{{localize "GWORLD.Column.Difficulty"}}
          <select name="system.difficulty" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.techniqueDifficulties selected=system.difficulty localize=true}}
          </select>
        </label>
        {{#if (or choices.techniqueKinds.length system.kind)}}
          <label>{{localize "GWORLD.Technique.Kind"}}
            <select name="system.kind" {{#unless editable}}disabled{{/unless}}>
              <option value="">{{localize "GWORLD.Technique.KindStandard"}}</option>
              {{#each choices.techniqueKinds as |kind|}}
                <option value="{{kind.key}}" {{#if (eq kind.key @root.system.kind)}}selected{{/if}}>{{kind.label}}</option>
              {{/each}}
            </select>
          </label>
        {{/if}}
        <label>{{localize "GWORLD.Technique.DefaultFrom"}}
          <select name="system.defaultFrom" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.techniqueDefaultFrom selected=system.defaultFrom localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Technique.Prerequisite"}}
          <input type="text" name="system.prerequisite" value="{{system.prerequisite}}"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Technique.DefaultModifier"}}
          <input type="number" name="system.defaultModifier" value="{{system.defaultModifier}}" step="1" max="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Pts"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Technique.MaxRelative"}}
          <input type="number" name="system.maxRelativeToPrerequisite"
                 value="{{system.maxRelativeToPrerequisite}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Technique.MaxRelativeHint"}}</p>
      {{!-- A technique written for a kind of skill, whose skill is chosen when a
           character takes it (Characters p. 230). --}}
      <div class="ish">{{localize "GWORLD.Technique.Open.Kinds"}}</div>
      <div class="irow iflags">
        {{#each choices.skillFamilies as |label kind|}}
          <label class="icheck"><input type="checkbox" name="system.skillFamilies.{{kind}}"
                 {{#if (lookup @root.choices.familiesTicked kind)}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
            {{localize label}}</label>
        {{/each}}
      </div>
      <label class="ifull">{{localize "GWORLD.Technique.Open.Choices"}}
        <input type="text" name="system.skillChoices" value="{{join system.skillChoices ", "}}" placeholder="Brawling, Karate"
               {{#unless editable}}disabled{{/unless}} />
      </label>
      <p class="ihint">{{localize "GWORLD.Technique.Open.Hint"}}</p>
      {{!-- Further defaults, the best of which is used. --}}
      <div class="ish">{{localize "GWORLD.Technique.AlternateDefaults"}}
        {{#if editable}}
          <button type="button" class="ibtn tiny" data-action="addTechniqueDefault">{{localize "GWORLD.Technique.AddDefault"}}</button>
        {{/if}}
      </div>
      {{#each system.alternateDefaults as |d i|}}
        <div class="irow" data-index="{{i}}">
          <select name="system.alternateDefaults.{{i}}.from" aria-label="{{localize 'GWORLD.Technique.DefaultFrom'}}" {{#unless @root.editable}}disabled{{/unless}}>
            {{selectOptions @root.choices.techniqueDefaultFrom selected=d.from localize=true}}
          </select>
          <input type="text" name="system.alternateDefaults.{{i}}.skill" value="{{d.skill}}" aria-label="{{localize 'GWORLD.Column.Skill'}}"
                 placeholder="{{localize 'GWORLD.Column.Skill'}}" {{#unless @root.editable}}disabled{{/unless}} />
          <input type="number" name="system.alternateDefaults.{{i}}.modifier" value="{{d.modifier}}" step="1" max="0"
                 aria-label="{{localize 'GWORLD.Technique.DefaultModifier'}}" {{#unless @root.editable}}disabled{{/unless}} />
          {{#if @root.editable}}
            <button type="button" class="rollable iconbtn" data-action="deleteTechniqueDefault" data-index="{{i}}"
                    title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
          {{/if}}
        </div>
      {{/each}}
    {{/if}}

    {{#if isSpell}}
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Spell.Colleges"}}
          <input type="text" name="system.colleges" value="{{collegesText}}"
                 placeholder="Fire, Movement" {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Difficulty"}}
          <select name="system.difficulty" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.spellDifficulties selected=system.difficulty localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Column.Pts"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Bonus"}}
          <input type="number" name="system.bonus" value="{{system.bonus}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Spell.MageryRequired"}}
          <input type="number" name="system.mageryRequired" value="{{system.mageryRequired}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Spell.ResistedBy"}}
          <input type="text" name="system.resistedBy" value="{{system.resistedBy}}" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>

      <p class="ihint">{{localize "GWORLD.Spell.ClassesHint"}}</p>
      <div class="ichecks">
        {{#each choices.spellClasses as |cls|}}
          <label class="icheck">
            <input type="checkbox" name="system.classes" value="{{cls}}"
                   {{#if (includes @root.system.classes cls)}}checked{{/if}}
                   {{#unless @root.editable}}disabled{{/unless}} />
            {{localize (concat "GWORLD.Spell.Class." cls)}}
          </label>
        {{/each}}
      </div>

      {{!-- Each figure the casting rules read sits beside the book's own
           wording for it, because "1 to Magery" and "Varies" are wordings a
           number cannot carry. --}}
      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Spell.Casting"}}</div>
        <div class="ifields">
          <label>{{localize "GWORLD.Spell.EnergyText"}}
            <input type="text" name="system.energy.text" value="{{system.energy.text}}"
                   placeholder="3/1" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.EnergyCast"}}
            <input type="number" name="system.energy.cast" value="{{system.energy.cast}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.EnergyCastMax"}}
            <input type="number" name="system.energy.castMax" value="{{system.energy.castMax}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.EnergyMaintain"}}
            <input type="number" name="system.energy.maintain" value="{{system.energy.maintain}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.TimeText"}}
            <input type="text" name="system.castingTime.text" value="{{system.castingTime.text}}"
                   placeholder="1 sec." {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.TimeSeconds"}}
            <input type="number" name="system.castingTime.seconds" value="{{system.castingTime.seconds}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.DurationText"}}
            <input type="text" name="system.duration.text" value="{{system.duration.text}}"
                   placeholder="1 min." {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.DurationSeconds"}}
            <input type="number" name="system.duration.seconds" value="{{system.duration.seconds}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Spell.CastingHint"}}</p>
      </div>

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Spell.Prerequisites"}}</div>
        <div class="ifields">
          <label class="wide">{{localize "GWORLD.Spell.PrerequisitesText"}}
            <input type="text" name="system.prerequisites" value="{{system.prerequisites}}"
                   placeholder="Magery 1, Create Fire, Shape Fire" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.PrerequisiteCount"}}
            <input type="number" name="system.prerequisiteCount" value="{{system.prerequisiteCount}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Spell.PrerequisitesHint"}}</p>
      </div>

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Spell.Attack"}}</div>
        <div class="ifields">
          <label>{{localize "GWORLD.Column.Skill"}}
            <input type="text" name="system.attack.skill" value="{{system.attack.skill}}"
                   placeholder="Innate Attack (Projectile)" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.DamagePerEnergy"}}
            <input type="text" name="system.attack.damage" value="{{system.attack.damage}}"
                   placeholder="1d" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Item.DamageType"}}
            <select name="system.attack.damageType" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.spellDamageTypes selected=system.attack.damageType localize=true}}
            </select>
          </label>
          <label>{{localize "GWORLD.Column.Acc"}}
            <input type="number" name="system.attack.accuracy" value="{{system.attack.accuracy}}" step="1"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.HalfDamageRange"}}
            <input type="number" name="system.attack.halfDamageRange" value="{{system.attack.halfDamageRange}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.MaxRange"}}
            <input type="number" name="system.attack.maxRange" value="{{system.attack.maxRange}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label class="icheck">
            <input type="checkbox" name="system.attack.explosive" {{#if system.attack.explosive}}checked{{/if}}
                   {{#unless editable}}disabled{{/unless}} />
            {{localize "GWORLD.Spell.Explosive"}}
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Spell.AttackHint"}}</p>
      </div>
    {{/if}}

    {{#if isTrait}}
      <div class="ifields">
        <label>{{localize "GWORLD.Trait.Category"}}
          <select name="system.category" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.categories selected=system.category localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Trait.Points"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.Levels"}}
          <input type="number" name="system.levels" value="{{system.levels}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.PointsPerLevel"}}
          <input type="number" name="system.pointsPerLevel" value="{{system.pointsPerLevel}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.MaxLevels"}}
          <input type="number" name="system.maxLevels" value="{{system.maxLevels}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.Reaction"}}
          <input type="number" name="system.reactionModifier" value="{{system.reactionModifier}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.Specialty"}}
          <input type="text" name="system.specialty" value="{{system.specialty}}"
                 placeholder="{{localize 'GWORLD.Trait.SpecialtyPlaceholder'}}" {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.NeedsSpecialty"}}
          <input type="checkbox" name="system.needsSpecialty" {{checked system.needsSpecialty}}
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.SpecialtyFieldHint"}}</p>
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.CostTable"}}
          <input type="text" name="system.costTable" value="{{costTableText}}"
                 placeholder="10/20/30/50/75" {{#unless editable}}disabled{{/unless}} />
        </label>
        <label class="wide">{{localize "GWORLD.Trait.LevelNames"}}
          <textarea name="system.levelNames" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{levelNamesText}}</textarea>
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.CostTableHint"}}</p>
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.TalentSkills"}}
          <textarea name="system.talentSkills" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{talentSkillsText}}</textarea>
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.TalentSkillsHint"}}</p>
      {{#if showsMasteredWeapons}}
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.MasteredWeapons"}}
          <textarea name="system.masteredWeapons" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{masteredWeaponsText}}</textarea>
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.MasteredWeaponsHint"}}</p>
      {{/if}}
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.Power"}}
          <input type="text" name="system.power" value="{{system.power}}"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.PowerTalent"}}
          <input type="checkbox" name="system.powerTalent" {{checked system.powerTalent}}
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.PowerHint"}}</p>

      {{!-- Enhancements and limitations, and the self-control number: what
           changes a trait's cost from the figure the book prints. --}}
      <div class="isub">
        <div class="isub-head">
          {{localize "GWORLD.Trait.Modifiers"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addModifier">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
            <button type="button" class="ibtn" data-action="browseModifiers"
                    data-tooltip="{{localize 'GWORLD.Modifier.BrowseHint'}}">
              {{> "gworld.search"}} {{localize "GWORLD.Modifier.Browse"}}
            </button>
          {{/if}}
        </div>
        {{#each system.modifiers as |m i|}}
          <div class="irow" data-index="{{i}}">
            <input type="text" name="system.modifiers.{{i}}.name" value="{{m.name}}"
                   aria-label="{{localize 'GWORLD.Trait.ModifierName'}}"
                   placeholder="{{localize 'GWORLD.Trait.ModifierName'}}" {{#unless @root.editable}}disabled{{/unless}} />
            <input type="number" name="system.modifiers.{{i}}.value" value="{{m.value}}" step="5"
                   aria-label="{{localize 'GWORLD.Trait.ModifierValue'}}" {{#unless @root.editable}}disabled{{/unless}} />
            <span class="wmode">%</span>
            {{#if @root.editable}}
              <button type="button" class="rollable iconbtn" data-action="deleteModifier"
                    title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
            {{/if}}
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Trait.NoModifiers"}}</p>
        {{/each}}
        <div class="ifields">
          <label>{{localize "GWORLD.Trait.SelfControl"}}
            {{!-- Options are listed, not built from a choices object: None has
                  to come first, and an object cannot keep it there. --}}
            <select name="system.selfControl" {{#unless editable}}disabled{{/unless}}>
              {{#each selfControlOptions as |option|}}
                <option value="{{option.value}}" title="{{localize option.hint}}"
                        {{#if option.selected}}selected{{/if}}>{{localize option.label}}{{#if option.standard}} {{localize "GWORLD.Trait.SelfControlStandard"}}{{/if}}</option>
              {{/each}}
            </select>
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Trait.ModifiersHint"}}</p>
      </div>

      <p class="ihint">
        {{localize "GWORLD.Trait.TotalHint"}} <strong>{{system.totalPoints}}</strong>
        {{#if hasModifiers}}<span class="ilevel">({{signed netModifier}}%)</span>{{/if}}
        {{#if levelName}}<span class="ilevel">({{levelName}})</span>{{/if}}
        {{#if isTabled}}<span class="ilevel">{{localize "GWORLD.Trait.TabledNote"}}</span>{{/if}}
      </p>
    {{/if}}

    {{#if isLanguage}}
      <div class="ifields">
        <label>{{localize "GWORLD.Language.Spoken"}}
          <select name="system.spoken" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.comprehension selected=system.spoken localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Language.Written"}}
          <select name="system.written" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.comprehension selected=system.written localize=true}}
          </select>
        </label>
        <label class="icheck">
          <input type="checkbox" name="system.isNative" {{#if system.isNative}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Language.IsNative"}}
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Language.NativeHint"}} <strong>{{system.totalPoints}}</strong></p>
    {{/if}}

    {{#if isArmor}}
      <div class="ifields">
        <label>{{localize "GWORLD.Armor.DR"}}
          <input type="number" name="system.dr" value="{{system.dr}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <div class="irow iflags">
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.FlexibleHint'}}">
          <input type="checkbox" name="system.flexible" {{#if system.flexible}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.Flexible"}}
        </label>
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.FrontOnlyHint'}}">
          <input type="checkbox" name="system.frontOnly" {{#if system.frontOnly}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.FrontOnly"}}
        </label>
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.ConcealableHint'}}">
          <input type="checkbox" name="system.concealable" {{#if system.concealable}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.Concealable"}}
        </label>
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.NoPeripheralHint'}}">
          <input type="checkbox" name="system.blocksPeripheralVision" {{#if system.blocksPeripheralVision}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.NoPeripheral"}}
        </label>
      </div>
      <div class="ifields">
        <label data-tooltip="{{localize 'GWORLD.Armor.SoleHint'}}">{{localize "GWORLD.Armor.SoleDR"}}
          <input type="number" name="system.soleDr" value="{{system.soleDr}}" step="1" min="0" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Armor.EnvironmentSuitHint'}}">{{localize "GWORLD.Armor.EnvironmentSuit"}}
          <select name="system.environmentSuit" {{#unless editable}}disabled{{/unless}}>
            <option value="" {{#unless system.environmentSuit}}selected{{/unless}}>—</option>
            <option value="Battlesuit" {{#if (eq system.environmentSuit "Battlesuit")}}selected{{/if}}>Battlesuit</option>
            <option value="Diving Suit" {{#if (eq system.environmentSuit "Diving Suit")}}selected{{/if}}>Diving Suit</option>
            <option value="NBC Suit" {{#if (eq system.environmentSuit "NBC Suit")}}selected{{/if}}>NBC Suit</option>
            <option value="Vacc Suit" {{#if (eq system.environmentSuit "Vacc Suit")}}selected{{/if}}>Vacc Suit</option>
          </select>
        </label>
      </div>
      {{!-- What the DR is made of, beyond how much of it there is
            (Characters p. 47). --}}
      <div class="ifields">
        <label data-tooltip="{{localize 'GWORLD.Armor.HardenedHint'}}">{{localize "GWORLD.Armor.Hardened"}}
          <input type="number" name="system.hardened" value="{{system.hardened}}" step="1" min="0" max="6"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Armor.AblativeHint'}}">{{localize "GWORLD.Armor.Ablative.Label"}}
          <select name="system.ablative" {{#unless editable}}disabled{{/unless}}>
            {{#each choices.ablative as |kind|}}
              <option value="{{kind}}" {{#if (eq @root.system.ablative kind)}}selected{{/if}}>
                {{localize (concat "GWORLD.Armor.Ablative." kind)}}
              </option>
            {{/each}}
          </select>
        </label>
        <label data-tooltip="{{localize 'GWORLD.Armor.DrLostHint'}}">{{localize "GWORLD.Armor.DrLost"}}
          <input type="number" name="system.drLost" value="{{system.drLost}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <div class="irow iflags">
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.ForceFieldHint'}}">
          <input type="checkbox" name="system.forceField" {{#if system.forceField}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.ForceField"}}
        </label>
      </div>

      {{!-- Places the piece armours differently from the rest of itself: a
            suit whose torso is better armoured than its limbs, a helmet whose
            skull is better armoured than its face. --}}
      <div class="isub" data-mode-path="drByLocation">
        <p class="ihint">{{localize "GWORLD.Armor.DrByLocationHint"}}</p>
        {{#each system.drByLocation as |exception i|}}
          <div class="irow" data-index="{{i}}">
            <label>{{localize "GWORLD.Armor.DR"}}
              <input type="number" name="system.drByLocation.{{i}}.dr" value="{{exception.dr}}" step="1" min="0"
                     {{#unless @root.editable}}disabled{{/unless}} />
            </label>
            <div class="ichecks">
              {{#each @root.choices.hitLocations as |loc|}}
                <label class="icheck">
                  <input type="checkbox" name="system.drByLocation.{{i}}.locations" value="{{loc}}"
                         {{#if (includes exception.locations loc)}}checked{{/if}}
                         {{#unless @root.editable}}disabled{{/unless}} />
                  {{localize (concat "GWORLD.HitLocation." loc)}}
                </label>
              {{/each}}
            </div>
            {{#if @root.editable}}
              <button type="button" class="ibtn tiny" data-action="deleteMode"
                      aria-label="{{localize 'GWORLD.Armor.RemoveDrByLocation'}}">&times;</button>
            {{/if}}
          </div>
        {{/each}}
        {{#if editable}}
          <button type="button" class="ibtn tiny" data-action="addMode">{{localize "GWORLD.Armor.AddDrByLocation"}}</button>
        {{/if}}
      </div>
      <p class="ihint">{{localize "GWORLD.Armor.LocationsHint"}}</p>
      <div class="ichecks">
        {{#each choices.hitLocations as |loc|}}
          <label class="icheck">
            <input type="checkbox" name="system.locations" value="{{loc}}"
                   {{#if (includes @root.system.locations loc)}}checked{{/if}}
                   {{#unless @root.editable}}disabled{{/unless}} />
            {{localize (concat "GWORLD.HitLocation." loc)}}
          </label>
        {{/each}}
      </div>

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Armor.SplitDR"}}</div>
        <p class="ihint">{{localize "GWORLD.Armor.SplitHint"}}</p>
        <div class="ifields">
          <label>{{localize "GWORLD.Armor.SplitValue"}}
            <input type="number" name="system.drSplit" value="{{system.drSplit}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        <div class="ichecks">
          {{#each choices.damageTypeList as |dt|}}
            <label class="icheck">
              <input type="checkbox" name="system.drSplitAppliesTo" value="{{dt}}"
                     {{#if (includes @root.system.drSplitAppliesTo dt)}}checked{{/if}}
                     {{#unless @root.editable}}disabled{{/unless}} />
              {{localize (concat "GWORLD.DamageType." dt)}}
            </label>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if weapon.showObject}}
      <div class="isub">
        <div class="isub-head">
          {{localize "GWORLD.Item.ObjectStats"}}
          {{#if editable}}
            {{#if weapon.repairs}}
              {{#if weapon.facts.hpLost}}
                <button type="button" class="ibtn" data-action="repairWeapon" data-tooltip="{{localize 'GWORLD.Item.RepairHint'}}">
                  {{localize "GWORLD.Item.Repair"}} &middot; {{localize weapon.repairLabel}}
                </button>
              {{/if}}
              <button type="button" class="ibtn" data-action="exposureCheck" data-tooltip="{{localize 'GWORLD.Repair.ExposureHint'}}">
                {{localize "GWORLD.Repair.ExposureAction"}}
              </button>
            {{/if}}
          {{/if}}
        </div>
        <div class="ifields">
          <label>{{localize "GWORLD.Column.DR"}}
            <input type="number" value="{{weapon.facts.dr}}" disabled />
          </label>
          <label>{{localize "GWORLD.Secondary.HP"}}
            <input type="number" value="{{weapon.facts.hp}}" disabled />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Item.HpLostHint'}}">{{localize "GWORLD.Item.HpLost"}}
            <input type="number" name="system.hpLost" value="{{system.hpLost}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Item.MissedMaintenanceHint'}}">{{localize "GWORLD.Item.MissedMaintenance"}}
            <input type="number" name="system.missedMaintenance" value="{{system.missedMaintenance}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Item.Condition"}}
            <input type="text" value="{{localize weapon.conditionLabel}}" disabled />
          </label>
        </div>
        {{#if weapon.mustRollInUse}}
          <p class="ihint warn">{{localize "GWORLD.Item.MustRollInUse"}}</p>
        {{/if}}
      </div>
    {{/if}}

    {{#if isShield}}
      <div class="ifields">
        <label>{{localize "GWORLD.Shield.DB"}}
          <input type="number" name="system.db" value="{{system.db}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Skill"}}
          <input type="text" name="system.skill" value="{{system.skill}}"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Shield.DRHint'}}">{{localize "GWORLD.Shield.DR"}}
          <input type="number" name="system.dr" value="{{system.dr}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Shield.DRHint'}}">{{localize "GWORLD.Shield.HP"}}
          <input type="number" name="system.hp" value="{{system.hp}}" step="1" min="0" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Shield.HardenedHint'}}">{{localize "GWORLD.Shield.Hardened"}}
          <input type="number" name="system.hardened" value="{{system.hardened}}" step="1" min="0" max="6"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Shield.CompositionHint'}}">{{localize "GWORLD.Shield.Composition"}}
          <select name="system.composition" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.shieldCompositions selected=system.composition localize=true}}
          </select>
        </label>
      </div>
    {{/if}}

    {{#if isTemplate}}
      <div class="ifields">
        <label>{{localize "GWORLD.Template.Kind"}}
          <select name="system.kind" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.templateKinds selected=system.kind localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Template.StatedCost"}}
          <input type="number" name="system.statedCost" value="{{system.statedCost}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Template.AddsUpTo"}}
          <input type="number" value="{{templateCost}}" disabled />
        </label>
      </div>
      {{#unless costMatches}}
        <p class="ihint warn">{{localize "GWORLD.Template.Mismatch"}}</p>
      {{/unless}}

      <div class="isub">
        <div class="isub-head">
          {{#if isRacial}}
            {{localize "GWORLD.Template.AttributeModifiers"}}
          {{else}}
            {{localize "GWORLD.Template.AttributeScores"}}
          {{/if}}
        </div>
        <div class="ifields">
          {{#each choices.attributeKeys as |key|}}
            <label>{{localize (concat "GWORLD.Attribute." key)}}
              <input type="number" name="system.attributes.{{key}}"
                     value="{{lookup @root.system.attributes key}}" step="1"
                     {{#unless @root.editable}}disabled{{/unless}} />
            </label>
          {{/each}}
        </div>
        <div class="ifields">
          {{#each choices.secondaryKeys as |sec|}}
            <label>{{localize sec.label}}
              <input type="number" name="system.secondary.{{sec.key}}"
                     value="{{lookup @root.system.secondary sec.key}}" step="1"
                     {{#unless @root.editable}}disabled{{/unless}} />
            </label>
          {{/each}}
          <label>{{localize "GWORLD.Field.SizeModifier"}}
            <input type="number" name="system.sizeModifier" value="{{system.sizeModifier}}" step="1"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        {{#if isRacial}}
          <label class="ifull">{{localize "GWORLD.Template.AttributeCost"}}
            <input type="number" name="system.attributeCost" value="{{system.attributeCost}}" step="1"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <p class="ihint">{{localize "GWORLD.Template.AttributeCostHint"}}</p>
        {{/if}}
      </div>

      <div class="isub" data-mode-path="entries">
        <div class="isub-head">
          {{localize "GWORLD.Template.Required"}}
          {{#if editable}}
            <button type="button" class="ibtn tiny" data-action="addEntry" data-group="">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each requiredEntries as |entry|}}
          {{> "gworld.templateEntry" entry=entry}}
        {{else}}
          <p class="ihint">{{localize "GWORLD.Template.NoEntries"}}</p>
        {{/each}}
      </div>

      <div class="isub" data-mode-path="choices">
        <div class="isub-head">
          {{localize "GWORLD.Template.Choices"}}
          {{#if editable}}
            <button type="button" class="ibtn tiny" data-action="addChoice">
              {{localize "GWORLD.Template.AddChoice"}}
            </button>
          {{/if}}
        </div>
        {{#each choiceGroups as |group i|}}
          <div class="irow" data-index="{{i}}">
            <div class="ifields">
              <label>{{localize "GWORLD.Template.GroupLabel"}}
                <input type="text" name="system.choices.{{i}}.label" value="{{group.label}}"
                       {{#unless @root.editable}}disabled{{/unless}} />
              </label>
              <label>{{localize "GWORLD.Template.GroupKind"}}
                <select name="system.choices.{{i}}.kind" {{#unless @root.editable}}disabled{{/unless}}>
                  {{selectOptions @root.choices.choiceKinds selected=group.kind localize=true}}
                </select>
              </label>
              <label>{{localize "GWORLD.Template.GroupRequired"}}
                <input type="number" name="system.choices.{{i}}.required" value="{{group.required}}"
                       step="1" {{#unless @root.editable}}disabled{{/unless}} />
              </label>
              {{#if @root.editable}}
                <button type="button" class="ibtn tiny" data-action="deleteMode" data-index="{{i}}"
                        aria-label="{{localize "GWORLD.Action.Delete"}}"
                        title="{{localize "GWORLD.Action.Delete"}}">
                  {{> "gworld.trash"}}
                </button>
              {{/if}}
            </div>
            <div data-mode-path="entries">
              {{#each group.options as |entry|}}
                {{> "gworld.templateEntry" entry=entry}}
              {{/each}}
              {{#if @root.editable}}
                <button type="button" class="ibtn tiny" data-action="addEntry" data-group="{{group.id}}">
                  {{localize "GWORLD.Template.AddOption"}}
                </button>
              {{/if}}
            </div>
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Template.NoChoices"}}</p>
        {{/each}}
      </div>

      {{#if orphanEntries.length}}
        <div class="isub" data-mode-path="entries">
          <div class="isub-head warn">{{localize "GWORLD.Template.Orphans"}}</div>
          {{#each orphanEntries as |entry|}}
            {{> "gworld.templateEntry" entry=entry}}
          {{/each}}
        </div>
      {{/if}}

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Template.FreeNotes"}}</div>
        <label class="ifull">{{localize "GWORLD.Template.Features"}}
          <textarea name="featuresText" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{featuresText}}</textarea>
        </label>
        <label class="ifull">{{localize "GWORLD.Template.Taboo"}}
          <textarea name="tabooText" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{tabooText}}</textarea>
        </label>
        <p class="ihint">{{localize "GWORLD.Template.FreeHint"}}</p>
      </div>
    {{/if}}

    {{#if isPhysical}}
      <div class="ifields">
        <label>{{localize "GWORLD.Column.Quantity"}}
          <input type="number" name="system.quantity" value="{{system.quantity}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Weight"}}
          <input type="number" name="system.weight" value="{{system.weight}}" step="0.01" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Cost"}}
          <input type="number" name="system.cost" value="{{system.cost}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.TechLevel"}}
          <input type="text" name="system.tl" value="{{system.tl}}" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Legality.Hint'}}">{{localize "GWORLD.Column.LC"}}
          <input type="number" name="system.lc" value="{{system.lc}}" step="1" min="0" max="4" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label class="icheck">
          <input type="checkbox" name="system.carried" {{#if system.carried}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Column.Carried"}}
        </label>
        <label class="icheck">
          <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Column.Equipped"}}
        </label>
      </div>
      {{#if isEquipment}}
        <div class="ifields">
          <label>{{localize "GWORLD.Gear.Category"}}
            <select name="system.category" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.equipmentCategories selected=system.category localize=true}}
            </select>
          </label>
          {{#if (eq system.category "ammunition")}}
            {{!-- A box of rounds: what the weapon fires it as, and what it fits. The rounds are the quantity. --}}
            <label data-tooltip="{{localize 'GWORLD.Ammunition.KindHint'}}">{{localize "GWORLD.Ammunition.Kind"}}
              <select name="system.ammunition.kind" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.ammunition selected=system.ammunition.kind localize=true}}
              </select>
            </label>
            <label data-tooltip="{{localize 'GWORLD.Ammunition.FitsHint'}}">{{localize "GWORLD.Ammunition.Fits"}}
              <input type="text" name="system.ammunition.fits" value="{{system.ammunition.fits}}" placeholder="9mm, .40, 12G, arrow"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
        </div>
        {{#if (eq system.category "ammunition")}}<p class="ihint">{{localize "GWORLD.Ammunition.ItemHint"}}</p>{{/if}}
        <div class="ifields">
          <label data-tooltip="{{localize 'GWORLD.Item.CostOfLivingHint'}}">{{localize "GWORLD.Item.CostOfLivingPercent"}}
            <input type="number" name="system.costOfLivingPercent" value="{{system.costOfLivingPercent}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          {{#if license}}
            <p class="ihint ifull">{{localize "GWORLD.Item.LicenseCost" low=license.low high=license.high}}</p>
          {{/if}}
          <label data-tooltip="{{localize 'GWORLD.Item.EquipmentQualityHint'}}">{{localize "GWORLD.Item.EquipmentQuality"}}
            <select name="system.equipmentQuality" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.equipmentQualities selected=system.equipmentQuality localize=true}}
            </select>
          </label>
          <label data-tooltip="{{localize 'GWORLD.Item.EquipmentModifierHint'}}">{{localize "GWORLD.Item.EquipmentModifier"}}
            <input type="number" name="system.equipmentModifier" value="{{system.equipmentModifier}}" step="1" placeholder="—"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label class="ifull" data-tooltip="{{localize 'GWORLD.Item.ForSkillsHint'}}">{{localize "GWORLD.Item.ForSkills"}}
            <input type="text" name="system.forSkills" value="{{join system.forSkills ", "}}" placeholder="Surgery, First Aid"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        {{#if weapon.showQuality}}
          <div class="ifields">
            <label data-tooltip="{{localize 'GWORLD.Item.QualityHint'}}">{{localize "GWORLD.Item.Quality"}}
              <select name="system.quality" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions weapon.qualities selected=system.quality localize=true}}
              </select>
            </label>
            <label data-tooltip="{{localize 'GWORLD.Item.MaterialHint'}}">{{localize "GWORLD.Item.Material"}}
              <select name="system.material" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.materials selected=system.material localize=true}}
              </select>
            </label>
            <label data-tooltip="{{localize 'GWORLD.Item.WeaponClassHint'}}">{{localize "GWORLD.Item.WeaponClass"}}
              <select name="system.weaponClass" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.weaponClasses selected=system.weaponClass localize=true}}
              </select>
            </label>
            <label data-tooltip="{{localize 'GWORLD.Item.ListCostHint'}}">{{localize "GWORLD.Item.ListCost"}}
              <input type="number" name="system.listCost" value="{{system.listCost}}" step="1" min="0"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          </div>
          {{#if weapon.multiplier}}
            <p class="ihint">{{localize "GWORLD.Item.QualityPrice" multiplier=weapon.multiplier}}</p>
          {{/if}}
        {{/if}}
        <p class="ihint">{{localize "GWORLD.Gear.CategoryHint"}}</p>
        <label data-tooltip="{{localize 'GWORLD.Gear.ComplexityHint'}}">
          {{localize "GWORLD.Gear.Complexity"}}
          <input type="number" name="system.complexity" value="{{system.complexity}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        {{#if complexity}}
          <div class="inote">
            {{> "gworld.info"}}
            <span>
              {{localize "GWORLD.Gear.Runs"}}
              {{#each complexity.runs as |row|}}
                {{row.count}} &times; C{{row.program}}{{#unless @last}}, {{/unless}}
              {{/each}}
            </span>
          </div>
        {{/if}}
        {{#if isVehicle}}
          {{!-- The stat line as the tables print it (Campaigns pp. 462-465). --}}
          <div class="isub">
            <div class="isub-head">
              {{localize "GWORLD.Vehicle.Statistics"}}
              {{#if editable}}
                {{!-- The catalogue entry is what a car costs; this makes the
                     car (Campaigns pp. 462-469). --}}
                <button type="button" class="ibtn tiny" data-action="putOnTheRoad"
                        data-tooltip="{{localize 'GWORLD.Vehicle.PutOnTheRoadHint'}}">
                  {{localize "GWORLD.Vehicle.PutOnTheRoad"}}
                </button>
              {{/if}}
            </div>
            <div class="ifields">
              <label>{{localize "GWORLD.Vehicle.StHp"}}
                <input type="number" name="system.vehicle.stHp" value="{{system.vehicle.stHp}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Handling"}}
                <input type="number" name="system.vehicle.handling" value="{{system.vehicle.handling}}" step="1" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Stability"}}
                <input type="number" name="system.vehicle.stability" value="{{system.vehicle.stability}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.HT"}}
                <input type="number" name="system.vehicle.ht" value="{{system.vehicle.ht}}" step="1" min="1" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Acceleration"}}
                <input type="number" name="system.vehicle.acceleration" value="{{system.vehicle.acceleration}}" step="0.1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.TopSpeed"}}
                <input type="number" name="system.vehicle.topSpeed" value="{{system.vehicle.topSpeed}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.LoadedWeight"}}
                <input type="number" name="system.vehicle.loadedWeight" value="{{system.vehicle.loadedWeight}}" step="0.01" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Load"}}
                <input type="number" name="system.vehicle.load" value="{{system.vehicle.load}}" step="0.01" min="0" {{#unless editable}}disabled{{/unless}} /></label>
