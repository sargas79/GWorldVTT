{{!-- One sheet for every item type; the sections below switch on the type.
     DocumentSheetV2 supplies the <form> itself, as it does for the actor
     templates, so this part must not open one of its own. --}}
<div class="isheet">

  <header class="ihead blueprint">
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
    {{!-- The button carries the action and nothing else. A [data-edit] on it
         would be read by the form on every submit -- as the button's inner
         HTML, since it is not an <img> -- and sent to the item as its image,
         which no item could be saved with. --}}
    {{#if editable}}
      <button type="button" class="iimgbtn" data-action="editItemImage"
              aria-label="{{localize 'GWORLD.Item.EditImage'}}"
              title="{{localize 'GWORLD.Item.EditImage'}}">
        <img class="iimg editable" src="{{item.img}}" alt="" />
      </button>
    {{else}}
      <img class="iimg" src="{{item.img}}" alt="" />
    {{/if}}
    <div class="ihead-fields">
      <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'GWORLD.Item.Name'}}"
             aria-label="{{localize 'GWORLD.Item.Name'}}"
             {{#unless editable}}disabled{{/unless}} />
      <span class="itype">{{localize (concat "TYPES.Item." type)}}</span>
    </div>
  </header>

  <div class="isbody">

    {{#if isSkill}}
      <div class="ifields">
        <label>{{localize "GWORLD.Column.Attribute"}}
          <select name="system.attribute" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.attributes selected=system.attribute localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Column.Difficulty"}}
          <select name="system.difficulty" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.difficulties selected=system.difficulty localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Column.Pts"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Bonus"}}
          <input type="number" name="system.bonus" value="{{system.bonus}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.TechLevel"}}
          <input type="text" name="system.techLevel" value="{{system.techLevel}}" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>

      <div class="isub">
        <div class="isub-head">
          {{localize "GWORLD.Skill.Defaults"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addDefault">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each system.defaults as |d i|}}
          <div class="irow" data-index="{{i}}">
            <select name="system.defaults.{{i}}.from" aria-label="{{localize 'GWORLD.Skill.DefaultSource'}}" {{#unless @root.editable}}disabled{{/unless}}>
              <option value="attribute" {{#if (eq d.from "attribute")}}selected{{/if}}>{{localize "GWORLD.Skill.FromAttribute"}}</option>
              <option value="skill" {{#if (eq d.from "skill")}}selected{{/if}}>{{localize "GWORLD.Skill.FromSkill"}}</option>
            </select>
            <select name="system.defaults.{{i}}.attribute" aria-label="{{localize 'GWORLD.Column.Attribute'}}" {{#unless @root.editable}}disabled{{/unless}}>
              {{selectOptions @root.choices.attributes selected=d.attribute localize=true}}
            </select>
            <input type="text" name="system.defaults.{{i}}.skill" value="{{d.skill}}" aria-label="{{localize 'GWORLD.Column.Skill'}}"
                   placeholder="{{localize 'GWORLD.Column.Skill'}}" {{#unless @root.editable}}disabled{{/unless}} />
            <input type="number" name="system.defaults.{{i}}.modifier" value="{{d.modifier}}" aria-label="{{localize 'GWORLD.Item.DefaultModifier'}}" step="1"
                   {{#unless @root.editable}}disabled{{/unless}} />
            {{#if @root.editable}}
              <button type="button" class="rollable iconbtn" data-action="deleteDefault"
                    title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
            {{/if}}
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Skill.NoDefaultsYet"}}</p>
        {{/each}}
      </div>
    {{/if}}

    {{#if isTechnique}}
      <div class="ifields">
        <label>{{localize "GWORLD.Column.Difficulty"}}
          <select name="system.difficulty" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.techniqueDifficulties selected=system.difficulty localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Technique.Prerequisite"}}
          <input type="text" name="system.prerequisite" value="{{system.prerequisite}}"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Technique.DefaultModifier"}}
          <input type="number" name="system.defaultModifier" value="{{system.defaultModifier}}" step="1" max="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Pts"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Technique.MaxRelative"}}
          <input type="number" name="system.maxRelativeToPrerequisite"
                 value="{{system.maxRelativeToPrerequisite}}" step="1" max="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Technique.MaxRelativeHint"}}</p>
    {{/if}}

    {{#if isRitual}}
      {{!-- A ritual's energy (Monster Hunters 1 pp. 33-35): its effects and
           modifiers, times a factor for its Greater effects, kept up to date
           as the definition changes. On a character, the Path every roll for
           it is against (p. 35). --}}
      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Ritual.Cost"}}</div>
        <div class="npcline" style="gap: 14px; align-items: baseline; flex-wrap: wrap">
          <span class="ritual-cost" data-tooltip="{{localize 'GWORLD.Ritual.CostHint'}}">
            ({{ritual.cost.effects}} + {{ritual.cost.modifiers}}) &times; {{ritual.cost.multiplier}}
            {{#if ritual.trappings}}&minus; {{system.casting.trappingsPercent}}%{{/if}}
            = <strong class="lvl">{{ritual.cost.total}}</strong> {{localize "GWORLD.Ritual.Energy"}}
          </span>
          {{#if ritual.skill}}
            <span class="ritual-skill">
              <span class="fl">{{localize "GWORLD.Ritual.Skill"}}</span>
              <strong>{{ritual.skill.name}}{{#if ritual.skill.level}}-{{ritual.skill.level}}{{/if}}</strong>
              {{#if ritual.skill.penalty}}
                <span class="tag" data-tooltip="{{localize 'GWORLD.Ritual.PathPenaltyHint'}}">{{signed ritual.skill.penalty}}</span>
              {{/if}}
              {{#if ritual.skill.uncastable}}
                <span class="tag tag-danger">{{localize "GWORLD.Ritual.Uncastable"}}</span>
              {{/if}}
            </span>
          {{/if}}
          {{#if ritual.cost.durationConflict}}
            <span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Ritual.DurationConflictHint'}}">{{localize "GWORLD.Ritual.DurationConflict"}}</span>
          {{/if}}
        </div>
        {{!-- Bonuses for this ritual as defined (pp. 25, 39). --}}
        <div class="npcline" style="gap: 10px; align-items: center; flex-wrap: wrap">
          {{#if ritual.mastery.held}}
            {{#if ritual.mastery.bonus}}
              <span class="tag tag-accent" data-tooltip="{{localize 'GWORLD.Ritual.MasteryHint'}}">{{localize "GWORLD.Ritual.Mastery"}} +{{ritual.mastery.bonus}}</span>
            {{else if ritual.mastery.changed}}
              <span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Ritual.MasteryChangedHint'}}">{{localize "GWORLD.Ritual.MasteryChanged"}}</span>
            {{/if}}
            {{#if editable}}{{#unless ritual.mastery.bonus}}
              <button type="button" class="ibtn" data-action="recordMastery" data-tooltip="{{localize 'GWORLD.Ritual.RecordMasteryHint'}}">{{localize "GWORLD.Ritual.RecordMastery"}}</button>
            {{/unless}}{{/if}}
          {{/if}}
          {{#if ritual.grimoire}}
            <span class="tag tag-accent">{{ritual.grimoire.name}} +{{ritual.grimoire.bonus}}</span>
          {{/if}}
          <label class="icheck" data-tooltip="{{localize 'GWORLD.Ritual.BlockingHint'}}">
            <input type="checkbox" name="system.blocking" {{#if system.blocking}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
            {{localize "GWORLD.Ritual.Blocking"}}
          </label>
        </div>
      </div>

      <div class="isub" data-mode-path="effects">
        <div class="isub-head">
          {{localize "GWORLD.Ritual.Effects"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addMode">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each system.effects as |e i|}}
          <div class="irow" data-index="{{i}}">
            <label class="icheck"><input type="checkbox" name="system.effects.{{i}}.greater"
                   {{#if e.greater}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
              {{localize "GWORLD.Ritual.Greater"}}</label>
            <select name="system.effects.{{i}}.effect" aria-label="{{localize 'GWORLD.Ritual.EffectLabel'}}" {{#unless @root.editable}}disabled{{/unless}}>
              {{selectOptions @root.choices.ritualEffects selected=e.effect localize=true}}
            </select>
            <select name="system.effects.{{i}}.path" aria-label="{{localize 'GWORLD.Ritual.Path'}}" {{#unless @root.editable}}disabled{{/unless}}>
              {{selectOptions @root.choices.ritualPaths selected=e.path}}
            </select>
            {{#if @root.editable}}
              <button type="button" class="rollable iconbtn" data-action="deleteMode"
                      title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
            {{/if}}
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Ritual.NoEffects"}}</p>
        {{/each}}
      </div>

      {{!-- What makes it this ritual (p. 39): change any of it and Ritual
           Mastery or a grimoire no longer applies. --}}
      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Ritual.Definition"}}</div>
        <p class="ihint">{{localize "GWORLD.Ritual.DefinitionHint"}}</p>
        <div class="ichecks">
          {{#each choices.ritualUses as |key|}}
            <label class="icheck">
              <input type="checkbox" name="system.definition.{{key}}"
                     {{#if (lookup @root.system.definition key)}}checked{{/if}}
                     {{#unless @root.editable}}disabled{{/unless}} />
              {{localize (concat "GWORLD.Ritual.Uses." key)}}
            </label>
          {{/each}}
        </div>
        <div class="ifields">
          <label>{{localize "GWORLD.Ritual.Affliction"}}
            <input type="text" name="system.definition.affliction" value="{{system.definition.affliction}}"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Ritual.AfflictionPercentHint'}}">{{localize "GWORLD.Ritual.AfflictionPercent"}}
            <input type="number" name="system.definition.afflictionPercent" value="{{system.definition.afflictionPercent}}"
                   step="5" min="0" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label class="wide">{{localize "GWORLD.Ritual.Traits"}}
            <input type="text" name="system.definition.traits" value="{{system.definition.traits}}"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Ritual.BonusScope.label"}}
            <select name="system.definition.bonusScope" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.ritualBonusScopes selected=system.definition.bonusScope localize=true}}
            </select>
          </label>
          {{#if system.definition.bonusScope}}
            <label>{{localize "GWORLD.Ritual.BonusRolls"}}
              <input type="text" name="system.definition.bonusRolls" value="{{system.definition.bonusRolls}}"
                     placeholder="—" {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          {{#if system.definition.damage}}
            <label>{{localize "GWORLD.Item.DamageType"}}
              <select name="system.definition.damageType" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.spellDamageTypes selected=system.definition.damageType localize=true}}
              </select>
            </label>
            <label>{{localize "GWORLD.Ritual.DamageKind.label"}}
              <select name="system.definition.damageKind" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.ritualDamageKinds selected=system.definition.damageKind localize=true}}
              </select>
            </label>
            <label>{{localize "GWORLD.Ritual.Delivery.label"}}
              <select name="system.definition.damageDelivery" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.ritualDeliveries selected=system.definition.damageDelivery localize=true}}
              </select>
            </label>
          {{/if}}
        </div>
      </div>

      {{!-- What "can be varied freely" or changed "on the fly" (p. 39). --}}
      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Ritual.Casting"}}</div>
        <div class="ifields">
          {{#if system.definition.area}}
            <label>{{localize "GWORLD.Ritual.AreaRadius"}}
              <input type="number" name="system.casting.areaRadius" value="{{system.casting.areaRadius}}" min="0"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
            <label>{{localize "GWORLD.Ritual.Excluded"}}
              <input type="number" name="system.casting.excludedSubjects" value="{{system.casting.excludedSubjects}}" step="1" min="0"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          <label data-tooltip="{{localize 'GWORLD.Ritual.TraitsAddedHint'}}">{{localize "GWORLD.Ritual.TraitsAdded"}}
            <input type="number" name="system.casting.traitsAdded" value="{{system.casting.traitsAdded}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Ritual.TraitsRemovedHint'}}">{{localize "GWORLD.Ritual.TraitsRemoved"}}
            <input type="number" name="system.casting.traitsRemoved" value="{{system.casting.traitsRemoved}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          {{#if system.definition.bonusScope}}
            <label>{{localize "GWORLD.Ritual.BonusAmount"}}
              <input type="number" name="system.casting.bonusAmount" value="{{system.casting.bonusAmount}}" step="1"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          {{#if system.definition.damage}}
            <label>{{localize "GWORLD.Ritual.DamageDice"}}
              <input type="text" name="system.casting.damageDice" value="{{system.casting.damageDice}}" placeholder="3d"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          {{#if system.definition.healing}}
            <label>{{localize "GWORLD.Ritual.HealingDice"}}
              <input type="text" name="system.casting.healingDice" value="{{system.casting.healingDice}}" placeholder="2d"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          {{#if system.definition.metaMagic}}
            <label data-tooltip="{{localize 'GWORLD.Ritual.MetaMagicHint'}}">{{localize "GWORLD.Ritual.MetaMagic"}}
              <input type="number" name="system.casting.metaMagic" value="{{system.casting.metaMagic}}" step="1" min="0"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          {{#if system.definition.speed}}
            <label>{{localize "GWORLD.Ritual.SpeedYards"}}
              <input type="number" name="system.casting.speedYards" value="{{system.casting.speedYards}}" min="0"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          <label>{{localize "GWORLD.Column.Duration"}}
            <select name="system.casting.durationStep" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.ritualDurations selected=ritual.durationStep localize=true}}
            </select>
          </label>
          {{#if ritual.lastDuration}}
            <label>{{localize "GWORLD.Ritual.ExtraMonths"}}
              <input type="number" name="system.casting.extraMonths" value="{{system.casting.extraMonths}}" step="1" min="0"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          {{/if}}
          <label data-tooltip="{{localize 'GWORLD.Ritual.YearsHint'}}">{{localize "GWORLD.Ritual.Years"}}
            <input type="number" name="system.casting.years" value="{{system.casting.years}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Ritual.RangeKind.label"}}
            <select name="system.casting.rangeKind" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.ritualRangeKinds selected=system.casting.rangeKind localize=true}}
            </select>
          </label>
          <label>{{localize (concat "GWORLD.Ritual.RangeUnit." system.casting.rangeKind)}}
            <input type="number" name="system.casting.rangeYards" value="{{system.casting.rangeYards}}" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Ritual.Dimensions"}}
            <input type="number" name="system.casting.dimensions" value="{{system.casting.dimensions}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Ritual.SubjectWeightHint'}}">{{localize "GWORLD.Ritual.SubjectWeight"}}
            <input type="number" name="system.casting.subjectWeight" value="{{system.casting.subjectWeight}}" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Ritual.ExtraEnergy"}}
            <input type="number" name="system.casting.extraEnergy" value="{{system.casting.extraEnergy}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Ritual.TrappingsHint'}}">{{localize "GWORLD.Ritual.Trappings"}}
            <input type="number" name="system.casting.trappingsPercent" value="{{system.casting.trappingsPercent}}" step="5" min="0" max="25"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
      </div>
    {{/if}}

    {{#if isSpell}}
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Spell.Colleges"}}
          <input type="text" name="system.colleges" value="{{collegesText}}"
                 placeholder="Fire, Movement" {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Difficulty"}}
          <select name="system.difficulty" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.spellDifficulties selected=system.difficulty localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Column.Pts"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Bonus"}}
          <input type="number" name="system.bonus" value="{{system.bonus}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Spell.MageryRequired"}}
          <input type="number" name="system.mageryRequired" value="{{system.mageryRequired}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Spell.ResistedBy"}}
          <input type="text" name="system.resistedBy" value="{{system.resistedBy}}" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>

      <p class="ihint">{{localize "GWORLD.Spell.ClassesHint"}}</p>
      <div class="ichecks">
        {{#each choices.spellClasses as |cls|}}
          <label class="icheck">
            <input type="checkbox" name="system.classes" value="{{cls}}"
                   {{#if (includes @root.system.classes cls)}}checked{{/if}}
                   {{#unless @root.editable}}disabled{{/unless}} />
            {{localize (concat "GWORLD.Spell.Class." cls)}}
          </label>
        {{/each}}
      </div>

      {{!-- Each figure the casting rules read sits beside the book's own
           wording for it, because "1 to Magery" and "Varies" are wordings a
           number cannot carry. --}}
      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Spell.Casting"}}</div>
        <div class="ifields">
          <label>{{localize "GWORLD.Spell.EnergyText"}}
            <input type="text" name="system.energy.text" value="{{system.energy.text}}"
                   placeholder="3/1" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.EnergyCast"}}
            <input type="number" name="system.energy.cast" value="{{system.energy.cast}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.EnergyCastMax"}}
            <input type="number" name="system.energy.castMax" value="{{system.energy.castMax}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.EnergyMaintain"}}
            <input type="number" name="system.energy.maintain" value="{{system.energy.maintain}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.TimeText"}}
            <input type="text" name="system.castingTime.text" value="{{system.castingTime.text}}"
                   placeholder="1 sec." {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.TimeSeconds"}}
            <input type="number" name="system.castingTime.seconds" value="{{system.castingTime.seconds}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.DurationText"}}
            <input type="text" name="system.duration.text" value="{{system.duration.text}}"
                   placeholder="1 min." {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.DurationSeconds"}}
            <input type="number" name="system.duration.seconds" value="{{system.duration.seconds}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Spell.CastingHint"}}</p>
      </div>

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Spell.Prerequisites"}}</div>
        <div class="ifields">
          <label class="wide">{{localize "GWORLD.Spell.PrerequisitesText"}}
            <input type="text" name="system.prerequisites" value="{{system.prerequisites}}"
                   placeholder="Magery 1, Create Fire, Shape Fire" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.PrerequisiteCount"}}
            <input type="number" name="system.prerequisiteCount" value="{{system.prerequisiteCount}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Spell.PrerequisitesHint"}}</p>
      </div>

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Spell.Attack"}}</div>
        <div class="ifields">
          <label>{{localize "GWORLD.Column.Skill"}}
            <input type="text" name="system.attack.skill" value="{{system.attack.skill}}"
                   placeholder="Innate Attack (Projectile)" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.DamagePerEnergy"}}
            <input type="text" name="system.attack.damage" value="{{system.attack.damage}}"
                   placeholder="1d" {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Item.DamageType"}}
            <select name="system.attack.damageType" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.spellDamageTypes selected=system.attack.damageType localize=true}}
            </select>
          </label>
          <label>{{localize "GWORLD.Column.Acc"}}
            <input type="number" name="system.attack.accuracy" value="{{system.attack.accuracy}}" step="1"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.HalfDamageRange"}}
            <input type="number" name="system.attack.halfDamageRange" value="{{system.attack.halfDamageRange}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Spell.MaxRange"}}
            <input type="number" name="system.attack.maxRange" value="{{system.attack.maxRange}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label class="icheck">
            <input type="checkbox" name="system.attack.explosive" {{#if system.attack.explosive}}checked{{/if}}
                   {{#unless editable}}disabled{{/unless}} />
            {{localize "GWORLD.Spell.Explosive"}}
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Spell.AttackHint"}}</p>
      </div>
    {{/if}}

    {{#if isTrait}}
      <div class="ifields">
        <label>{{localize "GWORLD.Trait.Category"}}
          <select name="system.category" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.categories selected=system.category localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Trait.Points"}}
          <input type="number" name="system.points" value="{{system.points}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.Levels"}}
          <input type="number" name="system.levels" value="{{system.levels}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.PointsPerLevel"}}
          <input type="number" name="system.pointsPerLevel" value="{{system.pointsPerLevel}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.MaxLevels"}}
          <input type="number" name="system.maxLevels" value="{{system.maxLevels}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.Reaction"}}
          <input type="number" name="system.reactionModifier" value="{{system.reactionModifier}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.CostTable"}}
          <input type="text" name="system.costTable" value="{{costTableText}}"
                 placeholder="10/20/30/50/75" {{#unless editable}}disabled{{/unless}} />
        </label>
        <label class="wide">{{localize "GWORLD.Trait.LevelNames"}}
          <textarea name="system.levelNames" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{levelNamesText}}</textarea>
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.CostTableHint"}}</p>
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.TalentSkills"}}
          <textarea name="system.talentSkills" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{talentSkillsText}}</textarea>
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.TalentSkillsHint"}}</p>
      <div class="ifields">
        <label class="wide">{{localize "GWORLD.Trait.Power"}}
          <input type="text" name="system.power" value="{{system.power}}"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Trait.PowerTalent"}}
          <input type="checkbox" name="system.powerTalent" {{checked system.powerTalent}}
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Trait.PowerHint"}}</p>

      {{!-- Enhancements and limitations, and the self-control number: what
           changes a trait's cost from the figure the book prints. --}}
      <div class="isub">
        <div class="isub-head">
          {{localize "GWORLD.Trait.Modifiers"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addModifier">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
            <button type="button" class="ibtn" data-action="browseModifiers"
                    data-tooltip="{{localize 'GWORLD.Modifier.BrowseHint'}}">
              {{> "gworld.search"}} {{localize "GWORLD.Modifier.Browse"}}
            </button>
          {{/if}}
        </div>
        {{#each system.modifiers as |m i|}}
          <div class="irow" data-index="{{i}}">
            <input type="text" name="system.modifiers.{{i}}.name" value="{{m.name}}"
                   aria-label="{{localize 'GWORLD.Trait.ModifierName'}}"
                   placeholder="{{localize 'GWORLD.Trait.ModifierName'}}" {{#unless @root.editable}}disabled{{/unless}} />
            <input type="number" name="system.modifiers.{{i}}.value" value="{{m.value}}" step="5"
                   aria-label="{{localize 'GWORLD.Trait.ModifierValue'}}" {{#unless @root.editable}}disabled{{/unless}} />
            <span class="wmode">%</span>
            {{#if @root.editable}}
              <button type="button" class="rollable iconbtn" data-action="deleteModifier"
                    title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
            {{/if}}
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Trait.NoModifiers"}}</p>
        {{/each}}
        <div class="ifields">
          <label>{{localize "GWORLD.Trait.SelfControl"}}
            <select name="system.selfControl" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.selfControl selected=system.selfControl localize=true}}
            </select>
          </label>
        </div>
        <p class="ihint">{{localize "GWORLD.Trait.ModifiersHint"}}</p>
      </div>

      <p class="ihint">
        {{localize "GWORLD.Trait.TotalHint"}} <strong>{{system.totalPoints}}</strong>
        {{#if hasModifiers}}<span class="ilevel">({{signed netModifier}}%)</span>{{/if}}
        {{#if levelName}}<span class="ilevel">({{levelName}})</span>{{/if}}
        {{#if isTabled}}<span class="ilevel">{{localize "GWORLD.Trait.TabledNote"}}</span>{{/if}}
      </p>
    {{/if}}

    {{#if isLanguage}}
      <div class="ifields">
        <label>{{localize "GWORLD.Language.Spoken"}}
          <select name="system.spoken" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.comprehension selected=system.spoken localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Language.Written"}}
          <select name="system.written" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.comprehension selected=system.written localize=true}}
          </select>
        </label>
        <label class="icheck">
          <input type="checkbox" name="system.isNative" {{#if system.isNative}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Language.IsNative"}}
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Language.NativeHint"}} <strong>{{system.totalPoints}}</strong></p>
    {{/if}}

    {{#if isArmor}}
      <div class="ifields">
        <label>{{localize "GWORLD.Armor.DR"}}
          <input type="number" name="system.dr" value="{{system.dr}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <div class="irow iflags">
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.FlexibleHint'}}">
          <input type="checkbox" name="system.flexible" {{#if system.flexible}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.Flexible"}}
        </label>
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.FrontOnlyHint'}}">
          <input type="checkbox" name="system.frontOnly" {{#if system.frontOnly}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.FrontOnly"}}
        </label>
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.ConcealableHint'}}">
          <input type="checkbox" name="system.concealable" {{#if system.concealable}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.Concealable"}}
        </label>
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Armor.NoPeripheralHint'}}">
          <input type="checkbox" name="system.blocksPeripheralVision" {{#if system.blocksPeripheralVision}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Armor.NoPeripheral"}}
        </label>
      </div>
      <div class="ifields">
        <label data-tooltip="{{localize 'GWORLD.Armor.SoleHint'}}">{{localize "GWORLD.Armor.SoleDR"}}
          <input type="number" name="system.soleDr" value="{{system.soleDr}}" step="1" min="0" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
      </div>
      <p class="ihint">{{localize "GWORLD.Armor.LocationsHint"}}</p>
      <div class="ichecks">
        {{#each choices.hitLocations as |loc|}}
          <label class="icheck">
            <input type="checkbox" name="system.locations" value="{{loc}}"
                   {{#if (includes @root.system.locations loc)}}checked{{/if}}
                   {{#unless @root.editable}}disabled{{/unless}} />
            {{localize (concat "GWORLD.HitLocation." loc)}}
          </label>
        {{/each}}
      </div>

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Armor.SplitDR"}}</div>
        <p class="ihint">{{localize "GWORLD.Armor.SplitHint"}}</p>
        <div class="ifields">
          <label>{{localize "GWORLD.Armor.SplitValue"}}
            <input type="number" name="system.drSplit" value="{{system.drSplit}}" step="1" min="0"
                   placeholder="—" {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        <div class="ichecks">
          {{#each choices.damageTypeList as |dt|}}
            <label class="icheck">
              <input type="checkbox" name="system.drSplitAppliesTo" value="{{dt}}"
                     {{#if (includes @root.system.drSplitAppliesTo dt)}}checked{{/if}}
                     {{#unless @root.editable}}disabled{{/unless}} />
              {{localize (concat "GWORLD.DamageType." dt)}}
            </label>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if weapon.showObject}}
      <div class="isub">
        <div class="isub-head">
          {{localize "GWORLD.Item.ObjectStats"}}
          {{#if editable}}
            {{#if weapon.repairs}}
              {{#if weapon.facts.hpLost}}
                <button type="button" class="ibtn" data-action="repairWeapon" data-tooltip="{{localize 'GWORLD.Item.RepairHint'}}">
                  {{localize "GWORLD.Item.Repair"}} &middot; {{localize weapon.repairLabel}}
                </button>
              {{/if}}
              <button type="button" class="ibtn" data-action="exposureCheck" data-tooltip="{{localize 'GWORLD.Repair.ExposureHint'}}">
                {{localize "GWORLD.Repair.ExposureAction"}}
              </button>
            {{/if}}
          {{/if}}
        </div>
        <div class="ifields">
          <label>{{localize "GWORLD.Column.DR"}}
            <input type="number" value="{{weapon.facts.dr}}" disabled />
          </label>
          <label>{{localize "GWORLD.Secondary.HP"}}
            <input type="number" value="{{weapon.facts.hp}}" disabled />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Item.HpLostHint'}}">{{localize "GWORLD.Item.HpLost"}}
            <input type="number" name="system.hpLost" value="{{system.hpLost}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label data-tooltip="{{localize 'GWORLD.Item.MissedMaintenanceHint'}}">{{localize "GWORLD.Item.MissedMaintenance"}}
            <input type="number" name="system.missedMaintenance" value="{{system.missedMaintenance}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <label>{{localize "GWORLD.Item.Condition"}}
            <input type="text" value="{{localize weapon.conditionLabel}}" disabled />
          </label>
        </div>
        {{#if weapon.mustRollInUse}}
          <p class="ihint warn">{{localize "GWORLD.Item.MustRollInUse"}}</p>
        {{/if}}
      </div>
    {{/if}}

    {{#if isShield}}
      <div class="ifields">
        <label>{{localize "GWORLD.Shield.DB"}}
          <input type="number" name="system.db" value="{{system.db}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Skill"}}
          <input type="text" name="system.skill" value="{{system.skill}}"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Shield.DRHint'}}">{{localize "GWORLD.Shield.DR"}}
          <input type="number" name="system.dr" value="{{system.dr}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Shield.DRHint'}}">{{localize "GWORLD.Shield.HP"}}
          <input type="number" name="system.hp" value="{{system.hp}}" step="1" min="0" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Shield.CompositionHint'}}">{{localize "GWORLD.Shield.Composition"}}
          <select name="system.composition" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.shieldCompositions selected=system.composition localize=true}}
          </select>
        </label>
      </div>
    {{/if}}

    {{#if isTemplate}}
      <div class="ifields">
        <label>{{localize "GWORLD.Template.Kind"}}
          <select name="system.kind" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions choices.templateKinds selected=system.kind localize=true}}
          </select>
        </label>
        <label>{{localize "GWORLD.Template.StatedCost"}}
          <input type="number" name="system.statedCost" value="{{system.statedCost}}" step="1"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Template.AddsUpTo"}}
          <input type="number" value="{{templateCost}}" disabled />
        </label>
      </div>
      {{#unless costMatches}}
        <p class="ihint warn">{{localize "GWORLD.Template.Mismatch"}}</p>
      {{/unless}}

      <div class="isub">
        <div class="isub-head">
          {{#if isRacial}}
            {{localize "GWORLD.Template.AttributeModifiers"}}
          {{else}}
            {{localize "GWORLD.Template.AttributeScores"}}
          {{/if}}
        </div>
        <div class="ifields">
          {{#each choices.attributeKeys as |key|}}
            <label>{{localize (concat "GWORLD.Attribute." key)}}
              <input type="number" name="system.attributes.{{key}}"
                     value="{{lookup @root.system.attributes key}}" step="1"
                     {{#unless @root.editable}}disabled{{/unless}} />
            </label>
          {{/each}}
        </div>
        <div class="ifields">
          {{#each choices.secondaryKeys as |sec|}}
            <label>{{localize sec.label}}
              <input type="number" name="system.secondary.{{sec.key}}"
                     value="{{lookup @root.system.secondary sec.key}}" step="1"
                     {{#unless @root.editable}}disabled{{/unless}} />
            </label>
          {{/each}}
          <label>{{localize "GWORLD.Field.SizeModifier"}}
            <input type="number" name="system.sizeModifier" value="{{system.sizeModifier}}" step="1"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
        </div>
        {{#if isRacial}}
          <label class="ifull">{{localize "GWORLD.Template.AttributeCost"}}
            <input type="number" name="system.attributeCost" value="{{system.attributeCost}}" step="1"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          <p class="ihint">{{localize "GWORLD.Template.AttributeCostHint"}}</p>
        {{/if}}
      </div>

      <div class="isub" data-mode-path="entries">
        <div class="isub-head">
          {{localize "GWORLD.Template.Required"}}
          {{#if editable}}
            <button type="button" class="ibtn tiny" data-action="addEntry" data-group="">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each requiredEntries as |entry|}}
          {{> "gworld.templateEntry" entry=entry}}
        {{else}}
          <p class="ihint">{{localize "GWORLD.Template.NoEntries"}}</p>
        {{/each}}
      </div>

      <div class="isub" data-mode-path="choices">
        <div class="isub-head">
          {{localize "GWORLD.Template.Choices"}}
          {{#if editable}}
            <button type="button" class="ibtn tiny" data-action="addChoice">
              {{localize "GWORLD.Template.AddChoice"}}
            </button>
          {{/if}}
        </div>
        {{#each choiceGroups as |group i|}}
          <div class="irow" data-index="{{i}}">
            <div class="ifields">
              <label>{{localize "GWORLD.Template.GroupLabel"}}
                <input type="text" name="system.choices.{{i}}.label" value="{{group.label}}"
                       {{#unless @root.editable}}disabled{{/unless}} />
              </label>
              <label>{{localize "GWORLD.Template.GroupKind"}}
                <select name="system.choices.{{i}}.kind" {{#unless @root.editable}}disabled{{/unless}}>
                  {{selectOptions @root.choices.choiceKinds selected=group.kind localize=true}}
                </select>
              </label>
              <label>{{localize "GWORLD.Template.GroupRequired"}}
                <input type="number" name="system.choices.{{i}}.required" value="{{group.required}}"
                       step="1" {{#unless @root.editable}}disabled{{/unless}} />
              </label>
              {{#if @root.editable}}
                <button type="button" class="ibtn tiny" data-action="deleteMode" data-index="{{i}}"
                        aria-label="{{localize "GWORLD.Action.Delete"}}"
                        title="{{localize "GWORLD.Action.Delete"}}">
                  {{> "gworld.trash"}}
                </button>
              {{/if}}
            </div>
            <div data-mode-path="entries">
              {{#each group.options as |entry|}}
                {{> "gworld.templateEntry" entry=entry}}
              {{/each}}
              {{#if @root.editable}}
                <button type="button" class="ibtn tiny" data-action="addEntry" data-group="{{group.id}}">
                  {{localize "GWORLD.Template.AddOption"}}
                </button>
              {{/if}}
            </div>
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Template.NoChoices"}}</p>
        {{/each}}
      </div>

      {{#if orphanEntries.length}}
        <div class="isub" data-mode-path="entries">
          <div class="isub-head warn">{{localize "GWORLD.Template.Orphans"}}</div>
          {{#each orphanEntries as |entry|}}
            {{> "gworld.templateEntry" entry=entry}}
          {{/each}}
        </div>
      {{/if}}

      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.Template.FreeNotes"}}</div>
        <label class="ifull">{{localize "GWORLD.Template.Features"}}
          <textarea name="featuresText" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{featuresText}}</textarea>
        </label>
        <label class="ifull">{{localize "GWORLD.Template.Taboo"}}
          <textarea name="tabooText" rows="3"
                    {{#unless editable}}disabled{{/unless}}>{{tabooText}}</textarea>
        </label>
        <p class="ihint">{{localize "GWORLD.Template.FreeHint"}}</p>
      </div>
    {{/if}}

    {{#if isPhysical}}
      <div class="ifields">
        <label>{{localize "GWORLD.Column.Quantity"}}
          <input type="number" name="system.quantity" value="{{system.quantity}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Weight"}}
          <input type="number" name="system.weight" value="{{system.weight}}" step="0.01" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.Cost"}}
          <input type="number" name="system.cost" value="{{system.cost}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label>{{localize "GWORLD.Column.TechLevel"}}
          <input type="text" name="system.tl" value="{{system.tl}}" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label data-tooltip="{{localize 'GWORLD.Legality.Hint'}}">{{localize "GWORLD.Column.LC"}}
          <input type="number" name="system.lc" value="{{system.lc}}" step="1" min="0" max="4" placeholder="—"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        <label class="icheck">
          <input type="checkbox" name="system.carried" {{#if system.carried}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Column.Carried"}}
        </label>
        <label class="icheck">
          <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}
                 {{#unless editable}}disabled{{/unless}} />
          {{localize "GWORLD.Column.Equipped"}}
        </label>
      </div>
      {{#if gadget}}
        {{!-- Cost factors (Monster Hunters 1 pp. 53-54, 59): each improvement
             adds to the factor, and the price and weight are worked out from
             the list figures. --}}
        <div class="isub">
          <div class="isub-head">{{localize "GWORLD.Gadget.Title"}}</div>
          <div class="ichecks">
            <label class="icheck" data-tooltip="{{localize 'GWORLD.Gadget.CuttingEdgeHint'}}"><input type="checkbox" name="system.improvements.cuttingEdge" {{#if system.improvements.cuttingEdge}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Gadget.CuttingEdge"}}</label>
            <label class="icheck" data-tooltip="{{localize 'GWORLD.Gadget.DisguisedHint'}}"><input type="checkbox" name="system.improvements.disguised" {{#if system.improvements.disguised}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Gadget.Disguised"}}</label>
            <label class="icheck" data-tooltip="{{localize 'GWORLD.Gadget.RuggedHint'}}"><input type="checkbox" name="system.improvements.rugged" {{#if system.improvements.rugged}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Gadget.Rugged"}}</label>
            {{#if gadget.clothing}}
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Gadget.ScentMaskingHint'}}"><input type="checkbox" name="system.improvements.scentMasking" {{#if system.improvements.scentMasking}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Gadget.ScentMasking"}}</label>
            {{/if}}
            <label class="icheck"><input type="checkbox" name="system.signature" {{#if system.signature}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Gadget.Signature"}}</label>
          </div>
          <div class="ifields">
            {{#if gadget.clothing}}
              <label data-tooltip="{{localize 'GWORLD.Gadget.UndercoverHint'}}">{{localize "GWORLD.Gadget.Undercover"}}
                <select name="system.improvements.undercover" {{#unless editable}}disabled{{/unless}}>
                  {{selectOptions gadget.undercover selected=gadget.undercoverValue localize=true}}
                </select>
              </label>
            {{/if}}
            <label data-tooltip="{{localize 'GWORLD.Gadget.HoldoutHint'}}">{{localize "GWORLD.Gadget.Holdout"}}
              <input type="number" name="system.holdout" value="{{system.holdout}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} />
            </label>
          </div>
          <p class="ihint">{{localize "GWORLD.Gadget.Priced" cf=gadget.costFactor weight=gadget.weightFactor cost=gadget.listCost listWeight=gadget.listWeight}}</p>
        </div>
      {{/if}}
      {{#if isEquipment}}
        <div class="ifields">
          <label>{{localize "GWORLD.Gear.Category"}}
            <select name="system.category" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.equipmentCategories selected=system.category localize=true}}
            </select>
          </label>
        </div>
        <div class="ifields">
          <label data-tooltip="{{localize 'GWORLD.Item.CostOfLivingHint'}}">{{localize "GWORLD.Item.CostOfLivingPercent"}}
            <input type="number" name="system.costOfLivingPercent" value="{{system.costOfLivingPercent}}" step="1" min="0"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          {{#if license}}
            <p class="ihint ifull">{{localize "GWORLD.Item.LicenseCost" low=license.low high=license.high}}</p>
          {{/if}}
          <label data-tooltip="{{localize 'GWORLD.Item.EquipmentQualityHint'}}">{{localize "GWORLD.Item.EquipmentQuality"}}
            <select name="system.equipmentQuality" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions choices.equipmentQualities selected=system.equipmentQuality localize=true}}
            </select>
          </label>
          <label class="ifull" data-tooltip="{{localize 'GWORLD.Item.ForSkillsHint'}}">{{localize "GWORLD.Item.ForSkills"}}
            <input type="text" name="system.forSkills" value="{{join system.forSkills ", "}}" placeholder="Surgery, First Aid"
                   {{#unless editable}}disabled{{/unless}} />
          </label>
          {{#if holyAttacks}}
            <label class="icheck" data-tooltip="{{localize 'GWORLD.Holy.ContactHint'}}">
              <input type="checkbox" name="system.holy" {{#if system.holy}}checked{{/if}}
                     {{#unless editable}}disabled{{/unless}} />
              {{localize "GWORLD.Item.Holy"}}</label>
          {{/if}}
        </div>
        {{#if weapon.showQuality}}
          <div class="ifields">
            <label data-tooltip="{{localize 'GWORLD.Item.QualityHint'}}">{{localize "GWORLD.Item.Quality"}}
              <select name="system.quality" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions weapon.qualities selected=system.quality localize=true}}
              </select>
            </label>
            <label data-tooltip="{{localize 'GWORLD.Item.MaterialHint'}}">{{localize "GWORLD.Item.Material"}}
              <select name="system.material" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.materials selected=system.material localize=true}}
              </select>
            </label>
            <label data-tooltip="{{localize 'GWORLD.Item.WeaponClassHint'}}">{{localize "GWORLD.Item.WeaponClass"}}
              <select name="system.weaponClass" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions choices.weaponClasses selected=system.weaponClass localize=true}}
              </select>
            </label>
            <label data-tooltip="{{localize 'GWORLD.Item.ListCostHint'}}">{{localize "GWORLD.Item.ListCost"}}
              <input type="number" name="system.listCost" value="{{system.listCost}}" step="1" min="0"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
          </div>
          {{#if weapon.improvements}}
            {{!-- Monster Hunters 1's weapon options (pp. 59-61): each a cost
                 factor, priced from the list figures. --}}
            <div class="ichecks">
              {{#unless weapon.improvements.bow}}{{#if weapon.improvements.melee}}
                <label class="icheck" data-tooltip="{{localize 'GWORLD.WeaponImprovement.BalancedHint'}}"><input type="checkbox" name="system.weaponImprovements.balanced" {{#if system.weaponImprovements.balanced}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.WeaponImprovement.Balanced"}}</label>
                <label class="icheck" data-tooltip="{{localize 'GWORLD.WeaponImprovement.TitaniumHint'}}"><input type="checkbox" name="system.weaponImprovements.titanium" {{#if system.weaponImprovements.titanium}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.WeaponImprovement.Titanium"}}</label>
                {{#if weapon.improvements.twoHandedAxe}}
                  <label class="icheck" data-tooltip="{{localize 'GWORLD.WeaponImprovement.WeightedHint'}}"><input type="checkbox" name="system.weaponImprovements.weighted" {{#if system.weaponImprovements.weighted}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.WeaponImprovement.Weighted"}}</label>
                {{/if}}
              {{/if}}{{/unless}}
              {{#if weapon.improvements.bow}}
                <label class="icheck" data-tooltip="{{localize 'GWORLD.WeaponImprovement.BalancedBowHint'}}"><input type="checkbox" name="system.weaponImprovements.balanced" {{#if system.weaponImprovements.balanced}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.WeaponImprovement.Balanced"}}</label>
                <label class="icheck" data-tooltip="{{localize 'GWORLD.WeaponImprovement.CompoundHint'}}"><input type="checkbox" name="system.weaponImprovements.compound" {{#if system.weaponImprovements.compound}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.WeaponImprovement.Compound"}}</label>
              {{/if}}
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Gadget.DisguisedHint'}}"><input type="checkbox" name="system.weaponImprovements.disguised" {{#if system.weaponImprovements.disguised}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Gadget.Disguised"}}</label>
            </div>
            <div class="ifields">
              <label data-tooltip="{{localize 'GWORLD.WeaponImprovement.ImprovisedHint'}}">{{localize "GWORLD.WeaponImprovement.Improvised"}}
                <input type="number" name="system.improvisedPenalty" value="{{system.improvisedPenalty}}" step="1" max="0" {{#unless editable}}disabled{{/unless}} />
              </label>
            </div>
            <p class="ihint">{{localize "GWORLD.WeaponImprovement.Priced" cf=weapon.improvements.costFactor cost=weapon.improvements.listCost weight=weapon.improvements.listWeight}}</p>
            {{#each weapon.improvements.problems as |p|}}<p class="ihint bad">{{localize p}}</p>{{/each}}
          {{else if weapon.multiplier}}
            <p class="ihint">{{localize "GWORLD.Item.QualityPrice" multiplier=weapon.multiplier}}</p>
          {{/if}}
        {{/if}}
        <p class="ihint">{{localize "GWORLD.Gear.CategoryHint"}}</p>
        <label data-tooltip="{{localize 'GWORLD.Gear.ComplexityHint'}}">
          {{localize "GWORLD.Gear.Complexity"}}
          <input type="number" name="system.complexity" value="{{system.complexity}}" step="1" min="0"
                 {{#unless editable}}disabled{{/unless}} />
        </label>
        {{#if complexity}}
          <div class="inote">
            {{> "gworld.info"}}
            <span>
              {{localize "GWORLD.Gear.Runs"}}
              {{#each complexity.runs as |row|}}
                {{row.count}} &times; C{{row.program}}{{#unless @last}}, {{/unless}}
              {{/each}}
            </span>
          </div>
        {{/if}}
        {{#if isVehicle}}
          {{!-- The stat line as the tables print it (Campaigns pp. 462-465). --}}
          <div class="isub">
            <div class="isub-head">
              {{localize "GWORLD.Vehicle.Statistics"}}
              {{#if editable}}
                {{!-- The catalogue entry is what a car costs; this makes the
                     car (Campaigns pp. 462-469). --}}
                <button type="button" class="ibtn tiny" data-action="putOnTheRoad"
                        data-tooltip="{{localize 'GWORLD.Vehicle.PutOnTheRoadHint'}}">
                  {{localize "GWORLD.Vehicle.PutOnTheRoad"}}
                </button>
              {{/if}}
            </div>
            <div class="ifields">
              <label>{{localize "GWORLD.Vehicle.StHp"}}
                <input type="number" name="system.vehicle.stHp" value="{{system.vehicle.stHp}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Handling"}}
                <input type="number" name="system.vehicle.handling" value="{{system.vehicle.handling}}" step="1" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Stability"}}
                <input type="number" name="system.vehicle.stability" value="{{system.vehicle.stability}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.HT"}}
                <input type="number" name="system.vehicle.ht" value="{{system.vehicle.ht}}" step="1" min="1" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Acceleration"}}
                <input type="number" name="system.vehicle.acceleration" value="{{system.vehicle.acceleration}}" step="0.1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.TopSpeed"}}
                <input type="number" name="system.vehicle.topSpeed" value="{{system.vehicle.topSpeed}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.LoadedWeight"}}
                <input type="number" name="system.vehicle.loadedWeight" value="{{system.vehicle.loadedWeight}}" step="0.01" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Load"}}
                <input type="number" name="system.vehicle.load" value="{{system.vehicle.load}}" step="0.01" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.SM"}}
                <input type="number" name="system.vehicle.sm" value="{{system.vehicle.sm}}" step="1" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Occupants"}}
                <input type="text" name="system.vehicle.occupants" value="{{system.vehicle.occupants}}" placeholder="1+3" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.DR"}}
                <input type="number" name="system.vehicle.dr" value="{{system.vehicle.dr}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Range"}}
                <input type="number" name="system.vehicle.range" value="{{system.vehicle.range}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Skill"}}
                <input type="text" name="system.vehicle.skill" value="{{system.vehicle.skill}}" placeholder="Driving (Automobile)" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.Locations"}}
                <input type="text" name="system.vehicle.locations" value="{{system.vehicle.locations}}" placeholder="G4W" {{#unless editable}}disabled{{/unless}} /></label>
              <label>{{localize "GWORLD.Vehicle.LocomotionLabel"}}
                <select name="system.vehicle.locomotion" {{#unless editable}}disabled{{/unless}}>
                  {{#each locomotions as |l|}}
                    <option value="{{l.key}}" {{#if l.selected}}selected{{/if}}>{{l.label}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="icheck"><input type="checkbox" name="system.vehicle.roadBound" {{#if system.vehicle.roadBound}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
                {{localize "GWORLD.Vehicle.RoadBound"}}</label>
            </div>
            <p class="ihint">{{localize "GWORLD.Vehicle.Hint"}}</p>
          </div>
        {{/if}}
      {{/if}}
    {{/if}}

    {{#if isModifier}}
      {{!-- An enhancement or limitation as the book prices it (Characters pp. 101-117). --}}
      <div class="ifields">
        <label>{{localize "GWORLD.Modifier.Kind"}}
          <select name="system.kind" {{#unless editable}}disabled{{/unless}}>
            {{#each modifierKinds as |k|}}
              <option value="{{k.key}}" {{#if k.selected}}selected{{/if}}>{{k.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>{{localize "GWORLD.Modifier.Value"}}
          <input type="number" name="system.value" value="{{system.value}}" step="5" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "GWORLD.Modifier.MaxLevels"}}
          <input type="number" name="system.maxLevels" value="{{system.maxLevels}}" step="1" min="0" {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "GWORLD.Modifier.Group"}}
          <input type="text" name="system.group" value="{{system.group}}" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
      <p class="ihint">{{localize "GWORLD.Modifier.Hint"}}</p>
      <div class="ifields">
        <label>{{localize "GWORLD.Modifier.CostTable"}}
          <input type="text" name="system.costTable" value="{{join system.costTable "/"}}" placeholder="50/100/150"
                 {{#unless editable}}disabled{{/unless}} /></label>
        <label>{{localize "GWORLD.Modifier.LevelNames"}}
          <input type="text" name="system.levelNames" value="{{join system.levelNames "; "}}" placeholder="x3; x10; x30"
                 {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    {{/if}}

    {{#if charm}}
      {{!-- A charm (Monster Hunters 1 pp. 38-39): the conditional ritual bound
           to this object, set off by breaking it. --}}
      <div class="isub">
        <div class="isub-head">{{localize "GWORLD.RitualCast.CharmTitle"}}</div>
        <div class="npcline" style="gap: 10px; align-items: center; flex-wrap: wrap">
          <strong>{{system.charm.ritual}}</strong>
          <span class="tag">{{localize "GWORLD.RitualCast.Margin"}} {{system.charm.margin}}</span>
          {{#if system.charm.condition}}<span class="sub">{{system.charm.condition}}</span>{{/if}}
          {{#if charm.mayBreak}}
            <button type="button" class="ibtn" data-action="breakCharm" data-tooltip="{{localize 'GWORLD.RitualCast.BreakHint'}}">{{localize "GWORLD.RitualCast.Break"}}</button>
          {{/if}}
        </div>
      </div>
    {{/if}}

    {{#if grimoire}}
      {{!-- A grimoire (Monster Hunters 1 pp. 39, 56-57): the rituals it
           teaches, each with its bonus, and what it takes to read. On a
           character, a ritual is chosen from theirs and remembered as it is
           defined now. --}}
      <div class="isub" data-mode-path="grimoire.rituals">
        <div class="isub-head">
          {{localize "GWORLD.Grimoire.Title"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addMode">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each grimoire.entries as |g|}}
          <div class="irow" data-index="{{g.index}}">
            {{#if @root.grimoire.rituals}}
              <select name="system.grimoire.rituals.{{g.index}}.ritual" aria-label="{{localize 'TYPES.Item.ritual'}}" {{#unless @root.editable}}disabled{{/unless}}>
                <option value="" {{#unless g.ritual}}selected{{/unless}}>—</option>
                {{#each @root.grimoire.rituals as |name|}}<option value="{{name}}" {{#if (eq name g.ritual)}}selected{{/if}}>{{name}}</option>{{/each}}
                {{#if g.missing}}<option value="{{g.ritual}}" selected>{{g.ritual}}</option>{{/if}}
              </select>
            {{else}}
              <input type="text" name="system.grimoire.rituals.{{g.index}}.ritual" value="{{g.ritual}}"
                     placeholder="{{localize 'TYPES.Item.ritual'}}" {{#unless @root.editable}}disabled{{/unless}} />
            {{/if}}
            <input type="number" name="system.grimoire.rituals.{{g.index}}.bonus" value="{{g.bonus}}" min="0" max="10" step="1"
                   aria-label="{{localize 'GWORLD.Column.Bonus'}}" style="width: 56px" {{#unless @root.editable}}disabled{{/unless}} />
            {{#if g.changed}}<span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Grimoire.ChangedHint'}}">{{localize "GWORLD.Grimoire.Changed"}}</span>{{/if}}
            {{#if @root.editable}}
              <button type="button" class="rollable iconbtn" data-action="deleteMode"
                      title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
            {{/if}}
          </div>
        {{/each}}
        {{#if grimoire.entries.length}}
          <div class="ifields">
            <label data-tooltip="{{localize 'GWORLD.Grimoire.DeadLanguageHint'}}">{{localize "GWORLD.Grimoire.DeadLanguage"}}
              <input type="text" name="system.grimoire.deadLanguage" value="{{system.grimoire.deadLanguage}}" placeholder="—"
                     {{#unless editable}}disabled{{/unless}} />
            </label>
            {{#if system.grimoire.deadLanguage}}
              <label>{{localize "GWORLD.Grimoire.Translation"}}
                <select name="system.grimoire.translation" {{#unless editable}}disabled{{/unless}}>
                  {{selectOptions choices.comprehension selected=system.grimoire.translation localize=true}}
                </select>
              </label>
            {{/if}}
          </div>
          <div class="ichecks">
            <label class="icheck"><input type="checkbox" name="system.grimoire.encrypted" {{#if system.grimoire.encrypted}}checked{{/if}}
                   {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Grimoire.Encrypted"}}</label>
            {{#if system.grimoire.encrypted}}
              <label class="icheck"><input type="checkbox" name="system.grimoire.decoded" {{#if system.grimoire.decoded}}checked{{/if}}
                     {{#unless editable}}disabled{{/unless}} /> {{localize "GWORLD.Grimoire.Decoded"}}</label>
            {{/if}}
          </div>
          {{#if grimoire.price}}
            <p class="ihint">{{localize "GWORLD.Grimoire.Price" cost=grimoire.price.cost weight=grimoire.price.weight}}</p>
          {{/if}}
        {{else}}
          <p class="ihint">{{localize "GWORLD.Grimoire.Hint"}}</p>
        {{/if}}
      </div>
    {{/if}}

    {{#if isPhysical}}
      {{!-- What is enchanted onto it (Campaigns pp. 480-482): each spell
           with its own Power. Six names are effects on the item itself;
           any other is a spell the wearer has or the user casts. --}}
      <div class="isub">
        <div class="isub-head">
          {{localize "GWORLD.Enchant.OnItem"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addEnchantment">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each system.enchantments as |e i|}}
          <div class="imode" data-index="{{i}}">
            <div class="irow">
              <input type="text" name="system.enchantments.{{i}}.spell" value="{{e.spell}}"
                     aria-label="{{localize 'GWORLD.Enchant.Spell'}}" placeholder="{{localize 'GWORLD.Enchant.Spell'}}"
                     {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.enchantments.{{i}}.level" value="{{e.level}}" step="1" min="0"
                     aria-label="{{localize 'GWORLD.Enchant.Level'}}" title="{{localize 'GWORLD.Enchant.Level'}}"
                     {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.enchantments.{{i}}.power" value="{{e.power}}" step="1" min="0"
                     aria-label="{{localize 'GWORLD.Enchant.Power'}}" title="{{localize 'GWORLD.Enchant.Power'}}"
                     {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.enchantments.{{i}}.energy" value="{{e.energy}}" step="1" min="0"
                     aria-label="{{localize 'GWORLD.Enchant.Energy'}}" title="{{localize 'GWORLD.Enchant.Energy'}}"
                     {{#unless @root.editable}}disabled{{/unless}} />
              {{#if @root.editable}}
                <button type="button" class="rollable iconbtn" data-action="deleteEnchantment"
                      title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
              {{/if}}
            </div>
            <div class="irow iflags">
              <label class="icheck"><input type="checkbox" name="system.enchantments.{{i}}.alwaysOn"
                     {{#if e.alwaysOn}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Enchant.AlwaysOnTag"}}</label>
              <label class="icheck"><input type="checkbox" name="system.enchantments.{{i}}.mageOnly"
                     {{#if e.mageOnly}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Enchant.MageOnly"}}</label>
            </div>
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Enchant.NoneOnItem"}}</p>
        {{/each}}
        <p class="ihint">{{localize "GWORLD.Enchant.OnItemHint"}}</p>
      </div>
    {{/if}}

    {{#if isArmed}}
      <div class="isub" data-mode-path="meleeModes">
        <div class="isub-head">
          {{localize "GWORLD.Item.MeleeModes"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addMode">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each system.meleeModes as |m i|}}
          <div class="imode" data-index="{{i}}">
            <div class="irow">
              <input type="text" name="system.meleeModes.{{i}}.name" value="{{m.name}}" aria-label="{{localize 'GWORLD.Item.ModeName'}}"
                     placeholder="{{localize 'GWORLD.Item.ModeName'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="text" name="system.meleeModes.{{i}}.skill" value="{{m.skill}}" aria-label="{{localize 'GWORLD.Column.Skill'}}"
                     placeholder="{{localize 'GWORLD.Column.Skill'}}" {{#unless @root.editable}}disabled{{/unless}} />
              {{#if @root.editable}}
                <button type="button" class="rollable iconbtn" data-action="deleteMode"
                      title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
              {{/if}}
            </div>
            <div class="irow">
              <select name="system.meleeModes.{{i}}.damageBase" aria-label="{{localize 'GWORLD.Item.DamageBase'}}" {{#unless @root.editable}}disabled{{/unless}}>
                {{selectOptions @root.choices.damageBases selected=m.damageBase localize=true}}
              </select>
              <input type="number" name="system.meleeModes.{{i}}.damageModifier" value="{{m.damageModifier}}" aria-label="{{localize 'GWORLD.Item.DamageModifier'}}" step="1"
                     {{#unless @root.editable}}disabled{{/unless}} />
              <input type="text" name="system.meleeModes.{{i}}.damageFormula" value="{{m.damageFormula}}" aria-label="{{localize 'GWORLD.Item.DamageFormula'}}"
                     placeholder="2d+1" {{#unless @root.editable}}disabled{{/unless}} />
              <select name="system.meleeModes.{{i}}.damageType" aria-label="{{localize 'GWORLD.Item.DamageType'}}" {{#unless @root.editable}}disabled{{/unless}}>
                {{selectOptions @root.choices.damageTypes selected=m.damageType localize=true}}
              </select>
            </div>
            <div class="irow">
              <input type="text" name="system.meleeModes.{{i}}.reach" value="{{m.reach}}" aria-label="{{localize 'GWORLD.Column.Reach'}}"
                     placeholder="{{localize 'GWORLD.Column.Reach'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.meleeModes.{{i}}.parryModifier" value="{{m.parryModifier}}" aria-label="{{localize 'GWORLD.Item.ParryModifier'}}" step="1"
                     {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.meleeModes.{{i}}.minSt" value="{{m.minSt}}" aria-label="{{localize 'GWORLD.Item.MinSt'}}" step="1"
                     placeholder="ST" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.meleeModes.{{i}}.armorDivisor" value="{{m.armorDivisor}}" aria-label="{{localize 'GWORLD.Item.ArmorDivisor'}}" step="0.5" min="0.1"
                     {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.meleeModes.{{i}}.damageExtraDice" value="{{m.damageExtraDice}}" aria-label="{{localize 'GWORLD.Item.ExtraDice'}}" step="1" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.ExtraDiceHint'}}" {{#unless @root.editable}}disabled{{/unless}} />
            </div>
            <div class="irow iflags">
              <label class="icheck"><input type="checkbox" name="system.meleeModes.{{i}}.canParry"
                     {{#if m.canParry}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.CanParry"}}</label>
              <label class="icheck"><input type="checkbox" name="system.meleeModes.{{i}}.unbalanced"
                     {{#if m.unbalanced}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.Unbalanced"}}</label>
              <label class="icheck"><input type="checkbox" name="system.meleeModes.{{i}}.isFencing"
                     {{#if m.isFencing}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.Fencing"}}</label>
              <label class="icheck"><input type="checkbox" name="system.meleeModes.{{i}}.twoHanded"
                     {{#if m.twoHanded}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.TwoHanded"}}</label>
              <label class="icheck"><input type="checkbox" name="system.meleeModes.{{i}}.isFlail"
                     {{#if m.isFlail}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.Flail"}}</label>
              <label class="icheck"><input type="checkbox" name="system.meleeModes.{{i}}.unreadyAfterAttack"
                     {{#if m.unreadyAfterAttack}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.UnreadyAfterAttack"}}</label>
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.SpecialDamageHint'}}"><input type="checkbox" name="system.meleeModes.{{i}}.damageSpecial"
                     {{#if m.damageSpecial}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.SpecialDamage"}}</label>
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.SurgeHint'}}"><input type="checkbox" name="system.meleeModes.{{i}}.surge"
                     {{#if m.surge}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.Surge"}}</label>
            </div>
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Item.NoModesYet"}}</p>
        {{/each}}
      </div>

      {{#if isArmed}}
      <div class="isub" data-mode-path="rangedModes">
        <div class="isub-head">
          {{localize "GWORLD.Item.RangedModes"}}
          {{#if editable}}
            <button type="button" class="ibtn" data-action="addMode">
              {{> "gworld.plus"}} {{localize "GWORLD.Action.Add"}}
            </button>
          {{/if}}
        </div>
        {{#each system.rangedModes as |m i|}}
          <div class="imode" data-index="{{i}}">
            <div class="irow">
              <input type="text" name="system.rangedModes.{{i}}.name" value="{{m.name}}" aria-label="{{localize 'GWORLD.Item.ModeName'}}"
                     placeholder="{{localize 'GWORLD.Item.ModeName'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="text" name="system.rangedModes.{{i}}.skill" value="{{m.skill}}" aria-label="{{localize 'GWORLD.Column.Skill'}}"
                     placeholder="{{localize 'GWORLD.Column.Skill'}}" {{#unless @root.editable}}disabled{{/unless}} />
              {{#if @root.editable}}
                <button type="button" class="rollable iconbtn" data-action="deleteMode"
                      title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
              {{/if}}
            </div>
            <div class="irow">
              <select name="system.rangedModes.{{i}}.damageBase" aria-label="{{localize 'GWORLD.Item.DamageBase'}}" {{#unless @root.editable}}disabled{{/unless}}>
                {{selectOptions @root.choices.damageBases selected=m.damageBase localize=true}}
              </select>
              <input type="number" name="system.rangedModes.{{i}}.damageModifier" value="{{m.damageModifier}}" aria-label="{{localize 'GWORLD.Item.DamageModifier'}}" step="1"
                     data-tooltip="{{localize 'GWORLD.Item.DamageModifier'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="text" name="system.rangedModes.{{i}}.damageFormula" value="{{m.damageFormula}}" aria-label="{{localize 'GWORLD.Item.DamageFormula'}}"
                     placeholder="2d+1" {{#unless @root.editable}}disabled{{/unless}} />
              <select name="system.rangedModes.{{i}}.damageType" aria-label="{{localize 'GWORLD.Item.DamageType'}}" {{#unless @root.editable}}disabled{{/unless}}>
                {{selectOptions @root.choices.damageTypes selected=m.damageType localize=true}}
              </select>
              <input type="number" name="system.rangedModes.{{i}}.armorDivisor" value="{{m.armorDivisor}}" aria-label="{{localize 'GWORLD.Item.ArmorDivisor'}}" step="0.5" min="0.1"
                     data-tooltip="{{localize 'GWORLD.Item.ArmorDivisor'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.damageExtraDice" value="{{m.damageExtraDice}}" aria-label="{{localize 'GWORLD.Item.ExtraDice'}}" step="1" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.ExtraDiceHint'}}" {{#unless @root.editable}}disabled{{/unless}} />
            </div>
            <div class="irow">
              <input type="number" name="system.rangedModes.{{i}}.accuracy" value="{{m.accuracy}}" aria-label="{{localize 'GWORLD.Column.Acc'}}" step="1"
                     data-tooltip="{{localize 'GWORLD.Column.Acc'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.scopeBonus" value="{{m.scopeBonus}}" aria-label="{{localize 'GWORLD.Item.ScopeBonus'}}" step="1" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.ScopeBonus'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.halfDamageRange" value="{{m.halfDamageRange}}" aria-label="{{localize 'GWORLD.Item.HalfDamageRange'}}" step="1" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.HalfDamageRange'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.maxRange" value="{{m.maxRange}}" aria-label="{{localize 'GWORLD.Item.MaxRange'}}" step="1" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.MaxRange'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.rateOfFire" value="{{m.rateOfFire}}" aria-label="{{localize 'GWORLD.Column.RoF'}}" step="1" min="1"
                     data-tooltip="{{localize 'GWORLD.Column.RoF'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="text" name="system.rangedModes.{{i}}.shots" value="{{m.shots}}" aria-label="{{localize 'GWORLD.Column.Shots'}}"
                     placeholder="{{localize 'GWORLD.Column.Shots'}}" data-tooltip="{{localize 'GWORLD.Column.Shots'}}" {{#unless @root.editable}}disabled{{/unless}} />
            </div>
            <div class="irow">
              <input type="number" name="system.rangedModes.{{i}}.minSt" value="{{m.minSt}}" aria-label="{{localize 'GWORLD.Item.MinSt'}}" step="1" placeholder="ST"
                     data-tooltip="{{localize 'GWORLD.Item.MinSt'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.weaponSt" value="{{m.weaponSt}}" aria-label="{{localize 'GWORLD.Item.WeaponSt'}}" step="1" placeholder="—"
                     data-tooltip="{{localize 'GWORLD.Item.WeaponStHint'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.bulk" value="{{m.bulk}}" aria-label="{{localize 'GWORLD.Item.Bulk'}}" step="1" max="0"
                     data-tooltip="{{localize 'GWORLD.Item.Bulk'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.recoil" value="{{m.recoil}}" aria-label="{{localize 'GWORLD.Item.Recoil'}}" step="1" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.Recoil'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.malfunction" value="{{m.malfunction}}" aria-label="{{localize 'GWORLD.Item.Malfunction'}}" step="1" min="3" max="18" placeholder="—"
                     data-tooltip="{{localize 'GWORLD.Item.MalfunctionHint'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <select name="system.rangedModes.{{i}}.mount" aria-label="{{localize 'GWORLD.Item.Mount'}}" data-tooltip="{{localize 'GWORLD.Item.MountHint'}}" {{#unless @root.editable}}disabled{{/unless}}>
                {{selectOptions @root.choices.mounts selected=m.mount localize=true}}
              </select>
            </div>
            <div class="irow">
              <select name="system.rangedModes.{{i}}.guidance" aria-label="{{localize 'GWORLD.Item.Guidance'}}" data-tooltip="{{localize 'GWORLD.Item.GuidanceHint'}}" {{#unless @root.editable}}disabled{{/unless}}>
                {{selectOptions @root.choices.guidance selected=m.guidance localize=true}}
              </select>
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.AreaAttackHint'}}"><input type="checkbox" name="system.rangedModes.{{i}}.areaAttack"
                     {{#if m.areaAttack}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.AreaAttack"}}</label>
              {{#if m.areaAttack}}
                <input type="number" name="system.rangedModes.{{i}}.coneMaxWidth" value="{{m.coneMaxWidth}}" aria-label="{{localize 'GWORLD.Item.ConeMaxWidth'}}" step="1" min="0"
                       data-tooltip="{{localize 'GWORLD.Item.ConeMaxWidthHint'}}" {{#unless @root.editable}}disabled{{/unless}} />
              {{/if}}
            </div>
            <div class="irow">
              <input type="number" name="system.rangedModes.{{i}}.loaded" value="{{m.loaded}}" aria-label="{{localize 'GWORLD.Item.Loaded'}}" step="1" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.LoadedHint'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <input type="number" name="system.rangedModes.{{i}}.reloadWeight" value="{{m.reloadWeight}}" aria-label="{{localize 'GWORLD.Item.ReloadWeight'}}" step="0.01" min="0"
                     data-tooltip="{{localize 'GWORLD.Item.ReloadWeightHint'}}" {{#unless @root.editable}}disabled{{/unless}} />
              <select name="system.rangedModes.{{i}}.ammunition" aria-label="{{localize 'GWORLD.Item.Ammunition'}}" data-tooltip="{{localize 'GWORLD.Item.AmmunitionHint'}}" {{#unless @root.editable}}disabled{{/unless}}>
                {{selectOptions (lookup @root.ammunitionFor i) selected=m.ammunition localize=true}}
              </select>
              {{#with (lookup @root.weapon.reloads i)}}
                <span class="wmode" data-tooltip="{{localize 'GWORLD.Item.ReloadCostHint'}}">{{localize "GWORLD.Item.ReloadCost" cost=this}}</span>
              {{/with}}
            </div>
            <div class="irow iflags">
              <label class="icheck"><input type="checkbox" name="system.rangedModes.{{i}}.twoHanded"
                     {{#if m.twoHanded}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.TwoHanded"}}</label>
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.ThrownHint'}}"><input type="checkbox" name="system.rangedModes.{{i}}.thrown"
                     {{#if m.thrown}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.Thrown"}}</label>
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.StMultipleHint'}}"><input type="checkbox" name="system.rangedModes.{{i}}.rangeIsStMultiple"
                     {{#if m.rangeIsStMultiple}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.StMultiple"}}</label>
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.SpecialDamageHint'}}"><input type="checkbox" name="system.rangedModes.{{i}}.damageSpecial"
                     {{#if m.damageSpecial}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.SpecialDamage"}}</label>
              <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.SurgeHint'}}"><input type="checkbox" name="system.rangedModes.{{i}}.surge"
                     {{#if m.surge}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                {{localize "GWORLD.Item.Surge"}}</label>
              {{#if @root.isTrait}}
                <label class="icheck" data-tooltip="{{localize 'GWORLD.Item.PerLevelHint'}}"><input type="checkbox" name="system.rangedModes.{{i}}.perLevel"
                       {{#if m.perLevel}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}} />
                  {{localize "GWORLD.Item.PerLevel"}}</label>
                <label class="icheck" data-tooltip="{{localize 'GWORLD.Malediction.RangeHint'}}">{{localize "GWORLD.Item.Malediction"}}
                  <input type="number" name="system.rangedModes.{{i}}.malediction" value="{{m.malediction}}" step="1" min="0" max="3"
                         aria-label="{{localize 'GWORLD.Item.Malediction'}}" {{#unless @root.editable}}disabled{{/unless}} /></label>
              {{/if}}
            </div>
          </div>
        {{else}}
          <p class="ihint">{{localize "GWORLD.Item.NoRangedModesYet"}}</p>
        {{/each}}
      </div>
      {{/if}}
    {{/if}}

    <div class="isub">
      <div class="isub-head">{{localize "GWORLD.Column.Description"}}</div>
      <prose-mirror class="box editor prose" name="system.description"
                    value="{{system.description}}" toggled
                    {{#unless editable}}disabled{{/unless}}>{{{enrichedDescription}}}</prose-mirror>
      <label class="ifull">{{localize "GWORLD.Item.Reference"}}
        <input type="text" name="system.reference" value="{{system.reference}}"
               {{#unless editable}}disabled{{/unless}} />
      </label>
    </div>

  </div>
</div>
