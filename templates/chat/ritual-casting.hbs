<div class="gworld gworld-chat gworld-ritual">
  <div class="gc-head">
    <span class="gc-label">{{name}}</span>
    <span class="gc-target">{{localize "GWORLD.RitualCast.Cost" cost=cost}}</span>
  </div>

  {{!-- Energy against cost, and how long it has taken (Monster Hunters 1 p. 35). --}}
  <div class="gc-mods">
    <span><strong>{{energy}}</strong> / {{cost}} {{localize "GWORLD.RitualCast.Energy"}}</span>
    <span class="gc-mod">{{elapsed}}</span>
    {{#if attempts}}<span class="gc-mod">{{localize "GWORLD.RitualCast.Attempts" count=attempts}}</span>{{/if}}
    {{#if quirks}}<span class="gc-mod">{{localize "GWORLD.RitualCast.Quirks" count=quirks}}</span>{{/if}}
    {{#if information}}<span class="gc-mod">{{localize "GWORLD.RitualCast.Information"}}</span>{{/if}}
  </div>
  <div class="gc-meter" style="align-self: stretch; width: 100%; height: 6px; background: rgba(0,0,0,0.15); border-radius: 3px; overflow: hidden">
    <div style="width: {{percent}}%; height: 100%; background: var(--color-level-success, #4a8)"></div>
  </div>

  {{!-- Who is working it (p. 39): each with the Path they roll, adept or
       not, and what Ritual Mastery and a grimoire give them. --}}
  <div class="gc-casters" style="display: flex; flex-direction: column; gap: 2px">
    {{#each casters as |c|}}
      <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap">
        {{#if (and @root.open @root.together)}}
          <input type="radio" name="ritual-acting-{{@root.itemId}}" value="{{c.index}}" data-ritual-setting="acting" {{#if c.acting}}checked{{/if}}
                 aria-label="{{localize 'GWORLD.RitualCast.Acting'}}">
        {{/if}}
        <strong>{{c.name}}</strong>
        <span class="gc-mod">{{c.skillName}}-{{c.skill}}</span>
        {{#if c.adept}}<span class="gc-mod">{{localize "GWORLD.RitualPath.Adept"}}</span>{{else}}<span class="gc-mod">{{localize "GWORLD.RitualPath.NonAdept"}}</span>{{/if}}
        {{#if c.mastery}}<span class="gc-mod">{{localize "GWORLD.Ritual.Mastery"}} +{{c.mastery}}</span>{{/if}}
        {{#if c.grimoire}}
          {{#if @root.open}}
            <label style="display: inline-flex; gap: 4px; align-items: center" data-tooltip="{{localize 'GWORLD.RitualCast.UseGrimoireHint'}}">
              <input type="checkbox" data-ritual-setting="grimoire:{{c.index}}" {{#if c.useGrimoire}}checked{{/if}}>
              {{c.grimoire.name}} +{{c.grimoire.bonus}}
            </label>
          {{else if c.useGrimoire}}
            <span class="gc-mod">{{c.grimoire.name}} +{{c.grimoire.bonus}}</span>
          {{/if}}
        {{/if}}
        {{#if (and @root.together c.last)}}<span class="gc-mod">{{localize "GWORLD.RitualCast.FinalBy"}}</span>{{/if}}
      </div>
    {{/each}}
  </div>

  {{#if log.length}}
    <ol class="gc-log" style="margin: 4px 0; padding-left: 18px">
      {{#each log as |entry|}}
        <li class="gc-log-{{entry.kind}}">{{entry.text}}</li>
      {{/each}}
    </ol>
  {{/if}}

  {{#if open}}
    {{!-- What the GM says about where and how it is worked (p. 36). --}}
    <div class="gc-settings" data-ritual-settings style="display: flex; flex-direction: column; gap: 3px">
      {{#if anyNonAdept}}
        <label style="display: flex; gap: 6px; align-items: center">
          <input type="checkbox" data-ritual-setting="connected" data-ritual-gm {{#if connected}}checked{{/if}}>
          {{localize "GWORLD.RitualCast.Connected"}}
        </label>
        <label style="display: flex; gap: 6px; align-items: center; justify-content: space-between">
          <span style="white-space: nowrap">{{localize "GWORLD.RitualCast.ConsecrationLabel"}}</span>
          <select data-ritual-setting="consecration" data-ritual-gm>
            {{#each consecrations as |c|}}<option value="{{c.value}}" {{#if c.selected}}selected{{/if}}>{{c.label}}</option>{{/each}}
          </select>
        </label>
        <label style="display: flex; gap: 6px; align-items: center">
          <input type="checkbox" data-ritual-setting="adeptTimes" {{#if adeptTimes}}checked{{/if}}>
          {{localize "GWORLD.RitualCast.AdeptTimes"}}
        </label>
      {{/if}}
      <label style="display: flex; gap: 6px; align-items: center; justify-content: space-between">
        <span style="white-space: nowrap">{{localize "GWORLD.RitualCast.SiteLabel"}}</span>
        <select data-ritual-setting="siteYears" data-ritual-gm>
          {{#each sites as |s|}}<option value="{{s.value}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>{{/each}}
        </select>
      </label>
      {{!-- Held back until a condition is met, and perhaps bound to a charm (pp. 38-39). --}}
      {{#if mayBeConditional}}
        <label style="display: flex; gap: 6px; align-items: center">
          <input type="checkbox" data-ritual-setting="conditional" {{#if conditional}}checked{{/if}}>
          {{localize "GWORLD.RitualCast.Conditional"}}
        </label>
        {{#if conditional}}
          <input type="text" data-ritual-setting="condition" value="{{condition}}" placeholder="{{localize 'GWORLD.RitualCast.ConditionPlaceholder'}}">
          <label style="display: flex; gap: 6px; align-items: center; justify-content: space-between">
            <span style="white-space: nowrap">{{localize "GWORLD.RitualCast.CharmLabel"}}</span>
            <select data-ritual-setting="charm">
              <option value="" {{#unless charmItemId}}selected{{/unless}}>—</option>
              {{#each charms as |c|}}<option value="{{c.id}}" {{#if c.selected}}selected{{/if}}>{{c.name}}</option>{{/each}}
            </select>
          </label>
          {{#if charmItemId}}
            <label style="display: flex; gap: 6px; align-items: center; justify-content: space-between">
              <span style="white-space: nowrap">{{localize "GWORLD.RitualCast.WorkspaceLabel"}}</span>
              <select data-ritual-setting="workspace">
                {{#each workspaces as |w|}}<option value="{{w.value}}" {{#if w.selected}}selected{{/if}}>{{w.label}}</option>{{/each}}
              </select>
            </label>
          {{/if}}
        {{/if}}
      {{/if}}
      {{#if anyQuick}}
        <label style="display: flex; gap: 6px; align-items: center; justify-content: space-between">
          <span style="white-space: nowrap">{{localize "GWORLD.RitualCast.HurriedLabel"}}</span>
          <input type="number" data-ritual-setting="hurriedTo" value="{{hurriedTo}}" min="1" max="5" step="1" style="width: 48px">
        </label>
      {{/if}}
    </div>

    <div class="gc-actions" data-ritual-controls style="display: flex; flex-direction: column; gap: 4px">
      {{#if enough}}
        <button type="button" class="gc-apply-button" data-ritual-action="cast">
          {{localize "GWORLD.RitualCast.CastAction" target=final.target}}{{#if together}} ({{final.name}}){{/if}}
        </button>
        {{#if final.modifiers.length}}
          <div class="gc-note">{{#each final.modifiers as |m|}}{{m.label}} {{signed m.value}}{{#unless @last}}, {{/unless}}{{/each}}</div>
        {{/if}}
      {{else}}
        {{#if desecrated}}
          <div class="gc-note">{{localize "GWORLD.RitualCast.DesecratedHint"}}</div>
        {{else}}
          <button type="button" class="gc-apply-button" data-ritual-action="gather">
            {{localize "GWORLD.RitualCast.GatherAction" target=gathering.target time=gathering.time}}
          </button>
          {{#if gathering.modifiers.length}}
            <div class="gc-note">{{#each gathering.modifiers as |m|}}{{m.label}} {{signed m.value}}{{#unless @last}}, {{/unless}}{{/each}}</div>
          {{/if}}
        {{/if}}
        {{#if reserve}}
          <button type="button" class="gc-apply-button" data-ritual-action="reserve">
            {{localize "GWORLD.RitualCast.ReserveAction" reserve=reserve time=tap.time}}{{#if tap.roll}} ({{localize "GWORLD.RitualCast.TapRoll" target=tap.target}}){{/if}}
          </button>
        {{/if}}
        <button type="button" class="gc-apply-button" data-ritual-action="sacrifice">
          {{localize "GWORLD.RitualCast.SacrificeAction" time=tap.time}}{{#if tap.roll}} ({{localize "GWORLD.RitualCast.TapRoll" target=tap.target}}){{/if}}
        </button>
        <button type="button" class="gc-apply-button" data-ritual-action="join" data-tooltip="{{localize 'GWORLD.RitualCast.JoinHint'}}">
          {{localize "GWORLD.RitualCast.JoinAction"}}
        </button>
      {{/if}}
      <button type="button" class="gc-apply-button" data-ritual-action="abandon">{{localize "GWORLD.RitualCast.AbandonAction"}}</button>
    </div>
  {{/if}}
</div>
