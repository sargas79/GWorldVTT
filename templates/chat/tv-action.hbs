{{!-- A failed defense bought back (Campaigns p. 417). --}}
<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{localize "GWORLD.Cinematic.TvActionTitle" name=name}}</span>
    <span class="gc-target">{{attack}}</span>
  </div>
  <div class="gc-result success">{{localize "GWORLD.Cinematic.Averted"}}</div>
  <div class="gc-mods">
    <span class="gc-mod">{{localize "GWORLD.Cinematic.Cost" fp=fp}}</span>
    <span class="gc-warn">{{localize "GWORLD.Cinematic.LosesTurn"}}</span>
  </div>
</div>
