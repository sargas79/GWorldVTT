<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{label}}</span>
    <span class="gc-target">{{localize "GWORLD.Chat.Target"}} {{effective}}</span>
  </div>

  {{#if modifiers.length}}
    <div class="gc-mods">
      <span>{{base}} {{localize "GWORLD.Chat.Base"}}</span>
      {{#each modifiers as |mod|}}
        <span class="gc-mod">{{signed mod.value}} {{mod.label}}</span>
      {{/each}}
    </div>
  {{/if}}

  <div class="gc-dice">
    {{#each outcome.dice as |die|}}<span class="gc-die">{{die}}</span>{{/each}}
    <span class="gc-total">{{outcome.roll}}</span>
  </div>

  <div class="gc-result {{resultClass}}">{{resultLabel}}</div>

  {{#if criticalHit}}
    <div class="gc-result crit-success">{{localize "GWORLD.Critical.NoDefense"}}</div>
  {{/if}}

  {{#if criticalMiss}}
    <div class="gc-result crit-failure">
      {{localize "GWORLD.Critical.Fumbled" roll=criticalMiss.total}}
      &mdash; {{criticalMiss.effect}}
      {{#if criticalMiss.gmDecides}}<span class="gc-mod">{{localize "GWORLD.Critical.GmDecides"}}</span>{{/if}}
      {{#if criticalMiss.again}}
        <span class="gc-mod">{{localize "GWORLD.Critical.ResistantAgain" roll=criticalMiss.again.total}}</span>
      {{/if}}
    </div>
  {{/if}}

  {{#if hits}}
    <div class="gc-result">
      {{localize "GWORLD.Chat.Hits" hits=hits shots=shotsFired}}
    </div>
  {{/if}}

  {{#if guidance}}
    <div class="gc-mods gc-guidance">
      {{#if guidance.falls}}
        <span class="gc-warn">{{localize "GWORLD.Guided.Falls"}}</span>
      {{else if guidance.hitsThisTurn}}
        {{#unless guidance.area}}
          <span>{{localize "GWORLD.Guided.ArrivesNow"}}</span>
        {{/unless}}
      {{else}}
        <span>{{localize "GWORLD.Guided.Arrives" seconds=guidance.seconds}}</span>
      {{/if}}
      {{#if guidance.speedNotDamage}}
        <span class="gc-mod">{{localize "GWORLD.Guided.SpeedNotDamage"}}</span>
      {{/if}}
      {{#if guidance.ignoresFirer}}
        <span class="gc-mod">{{localize "GWORLD.Guided.IgnoresFirer"}}</span>
      {{/if}}
      {{#if guidance.mustSteer}}
        <span class="gc-warn">{{localize "GWORLD.Guided.MustSteer"}}</span>
      {{/if}}
      {{#if guidance.area}}
        <span class="gc-mod">{{localize "GWORLD.Guided.NoDefense"}}</span>
        {{#if guidance.coneYards}}
          <span class="gc-mod">{{localize "GWORLD.Guided.ConeWidth" yards=guidance.coneYards}}</span>
        {{/if}}
        {{#if guidance.damageHoldsUp}}
          <span class="gc-mod">{{localize "GWORLD.Guided.DamageHoldsUp"}}</span>
        {{/if}}
        {{#if guidance.coneMayCatch}}
          <span class="gc-mod">{{localize "GWORLD.Guided.MayStillCatch"}}</span>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}

  {{#if jam}}
    <div class="gc-result crit-failure">
      {{localize "GWORLD.Malfunction.Jammed"}} &mdash; {{jam.label}}
      <span class="gc-mod">{{jam.repair}}</span>
    </div>
    {{#if jam.fires}}
      <div class="gc-mods"><span>{{localize "GWORLD.Malfunction.FiredFirst"}}</span></div>
    {{/if}}
    {{#if jam.explodes}}
      <div class="gc-result crit-failure">{{localize "GWORLD.Malfunction.Exploded"}}</div>
    {{/if}}
  {{/if}}
</div>
