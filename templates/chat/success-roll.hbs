<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{label}}</span>
    <span class="gc-target">{{localize "GWORLD.Chat.Target"}} {{effective}}</span>
  </div>

  {{#if modifiers.length}}
    <div class="gc-mods">
      <span>{{base}} {{localize "GWORLD.Chat.Base"}}</span>
      {{#each modifiers as |mod|}}
        <span class="gc-mod">{{signed mod.value}} {{mod.label}}</span>
      {{/each}}
    </div>
  {{/if}}

  <div class="gc-dice">
    {{#each outcome.dice as |die|}}<span class="gc-die">{{die}}</span>{{/each}}
    <span class="gc-total">{{outcome.roll}}</span>
  </div>

  <div class="gc-result {{resultClass}}">{{resultLabel}}</div>

  {{#if criticalHit}}
    <div class="gc-result crit-success">{{localize "GWORLD.Critical.NoDefense"}}</div>
  {{/if}}

  {{#if criticalMiss}}
    <div class="gc-result crit-failure">
      {{localize "GWORLD.Critical.Fumbled" roll=criticalMiss.total}}
      &mdash; {{criticalMiss.effect}}
      {{#if criticalMiss.gmDecides}}<span class="gc-mod">{{localize "GWORLD.Critical.GmDecides"}}</span>{{/if}}
    </div>
  {{/if}}

  {{#if hits}}
    <div class="gc-result">
      {{localize "GWORLD.Chat.Hits" hits=hits shots=shotsFired}}
    </div>
  {{/if}}
</div>
