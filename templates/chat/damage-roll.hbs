<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{label}}</span>
    <span class="gc-target">{{formula}} {{localize (concat "GWORLD.DamageType." damageType)}}</span>
  </div>

  <div class="gc-dice">
    <span class="gc-total">{{basicDamage}}</span>
    <span class="gc-mod">{{localize "GWORLD.Chat.BasicDamage"}}</span>
  </div>

  <div class="gc-mods">
    {{#if modifiedFrom}}
      {{!-- Modifying Dice + Adds (Characters p. 269): the adds rolled as dice. --}}
      <span class="gc-mod">{{localize "GWORLD.Chat.ModifiedDice" formula=modifiedFrom}}</span>
    {{/if}}
    {{#if halvedFrom}}
      <span class="gc-mod">{{localize "GWORLD.Chat.HalfDamage" full=halvedFrom}}</span>
    {{/if}}
    {{#if massMultiplier}}
      <span class="gc-mod">{{localize "GWORLD.Chat.MassShot" times=massMultiplier}}</span>
    {{/if}}
    <span>{{localize "GWORLD.Chat.WoundingModifier"}} &times;{{woundingModifier}}</span>
    {{#each modifiers as |mod|}}<span class="gc-mod">{{signed mod.value}} {{mod.label}}</span>{{/each}}
    {{#if hasArmorDivisor}}
      <span class="gc-mod">{{localize "GWORLD.Chat.ArmorDivisor"}} ({{armorDivisor}})</span>
    {{/if}}
  </div>

  <div class="gc-result">
    {{localize "GWORLD.Chat.InjuryUnarmored"}} <strong>{{injuryIfUnarmored}}</strong>
  </div>

  {{#if largeArea}}
    {{!-- Averaged DR and no hit location (Campaigns p. 400). --}}
    <div class="gc-mods"><span class="gc-mod">{{localize "GWORLD.LargeArea.Label"}}</span></div>
  {{/if}}

  {{#if explosive}}
    <div class="gc-mods">
      <span>{{localize "GWORLD.Chat.Blast" yards=blastRadius}}</span>
      {{#if fragmentation}}
        <span>{{localize "GWORLD.Chat.Fragments" dice=fragmentation yards=fragmentationRadius}}</span>
        {{#if fragmentLingers}}
          {{!-- Hot fragments go on burning (Campaigns p. 414). --}}
          <span class="gc-mod">{{fragmentLingers}}</span>
        {{/if}}
      {{/if}}
      {{#if blastPlacement}}
        <span class="gc-mod">{{blastPlacement}}</span>
      {{/if}}
      {{#if cinematicBlast}}
        {{!-- The rolled figure buys knockback and nothing else (p. 417). --}}
        <span class="gc-mod">{{localize "GWORLD.Cinematic.BlastNoDamage"}}</span>
      {{/if}}
    </div>
  {{/if}}

  <div class="gc-foot">
    {{#if hasArmorDivisor}}
      {{localize "GWORLD.Chat.SubtractDRDivisor" divisor=armorDivisor}}
    {{else}}
      {{localize "GWORLD.Chat.SubtractDR"}}
    {{/if}}
  </div>
</div>
