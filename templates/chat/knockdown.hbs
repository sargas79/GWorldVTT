<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{name}}</span>
    <span class="gc-target">
      {{#if recovery}}{{localize "GWORLD.Knockdown.RecoveryTitle"}}{{else}}{{localize "GWORLD.Knockdown.Title"}}{{/if}}
    </span>
  </div>

  <div class="gc-mods">
    <span>{{#if attribute}}{{attribute}}{{else}}HT{{/if}} {{ht}}</span>
    {{#if modifier}}<span class="gc-mod">{{signed modifier}}</span>{{/if}}
    <span class="gc-mod">{{localize "GWORLD.Chat.Target"}} {{target}}</span>
  </div>

  <div class="gc-dice">
    {{#each dice as |die|}}<span class="gc-die">{{die}}</span>{{/each}}
    <span class="gc-total">{{roll}}</span>
  </div>

  <div class="gc-result {{#if unconscious}}crit-failure{{else if failed}}failure{{else}}success{{/if}}">
    {{outcome}}
  </div>
</div>
