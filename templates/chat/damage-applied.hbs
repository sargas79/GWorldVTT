<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{label}}</span>
    <span class="gc-target">{{localize "GWORLD.Chat.DamageApplied"}}</span>
  </div>

  {{#if critical}}
    <div class="gc-result crit-success">
      {{localize "GWORLD.Critical.RolledOn" table=critical.table roll=critical.roll}}
      &mdash; {{critical.effect}}
      {{#if critical.gmDecides}}<span class="gc-mod">{{localize "GWORLD.Critical.GmDecides"}}</span>{{/if}}
    </div>
  {{/if}}

  {{#each results as |r|}}
    <div class="gc-applied">
      <div class="gc-applied-head">
        <strong>{{r.actorName}}</strong>
        <span class="gc-mod">{{r.location}}</span>
      </div>

      {{#if r.criticalDamage}}
        <div class="gc-mods">
          <span class="gc-mod">{{localize "GWORLD.Critical.BasicDamage"}} {{r.criticalDamage}}</span>
        </div>
      {{/if}}

      {{#if r.collapsed}}
        {{!-- A mook, who drops at the first thing that gets through (p. 417). --}}
        <div class="gc-result failure">{{localize "GWORLD.Cinematic.Collapses" name=r.actorName}}</div>
      {{else if r.cinematicBlast}}
        {{!-- A blast that does no direct damage: a token point a yard (p. 417). --}}
        <div class="gc-mods">
          <span>{{localize "GWORLD.Cinematic.BlastNoDamage"}}</span>
        </div>
        <div class="gc-result">
          <strong>{{r.injury}}</strong> {{r.pool}}
          <span class="gc-mod">{{r.previous}} &rarr; {{r.current}} / {{r.max}}</span>
          <span class="gc-mod">{{r.status}}</span>
        </div>
      {{else if r.stopped}}
        <div class="gc-result">
          {{localize "GWORLD.Chat.Stopped" dr=r.effectiveDr}}
        </div>
        {{#if r.forceFieldStopped}}
          {{!-- A field that held keeps a touch effect out too (Characters p. 47). --}}
          <div class="gc-mods">
            <span>{{localize "GWORLD.Armor.FieldStopped" dr=r.forceFieldStopped}}</span>
            {{#unless r.touchEffectsReach}}
              <span>{{localize "GWORLD.Armor.NoTouchEffects"}}</span>
            {{/unless}}
          </div>
        {{/if}}
      {{else}}
        <div class="gc-mods">
          {{#if r.forceFieldStopped}}
            <span>{{localize "GWORLD.Armor.FieldStopped" dr=r.forceFieldStopped}}</span>
          {{/if}}
          <span>{{localize "GWORLD.Chat.DrSubtracted"}} {{r.effectiveDr}}</span>
          <span>{{localize "GWORLD.Chat.Penetrating"}} {{r.penetrating}}</span>
          {{#if r.bluntTrauma}}
            {{!-- Nothing got through: what it cost was the bruise. --}}
            <span>{{localize "GWORLD.Armor.BluntTrauma"}} {{r.bluntTrauma}}</span>
          {{else}}
            <span>&times;{{r.woundingModifier}}</span>
          {{/if}}
        </div>
        <div class="gc-result">
          <strong>{{r.injury}}</strong> {{r.pool}}
          <span class="gc-mod">{{r.previous}} &rarr; {{r.current}} / {{r.max}}</span>
          <span class="gc-mod">{{r.status}}</span>
        </div>
        <div class="gc-mods">
          {{#if r.hasShock}}<span class="gc-mod">{{localize "GWORLD.Chat.Shock"}} {{r.shock}}</span>{{/if}}
          {{#if r.crippled}}<span class="gc-warn">{{localize "GWORLD.Chat.Crippled"}}</span>{{/if}}
          {{#if r.majorWound}}
            <span class="gc-warn">
              {{localize "GWORLD.Chat.MajorWound"}} {{r.knockdownModifier}}
            </span>
          {{/if}}
          {{#if r.unconsciousCheck}}
            <span class="gc-warn">{{localize "GWORLD.Chat.ConsciousnessRoll"}} {{r.unconsciousPenalty}}</span>
          {{/if}}
          {{#if r.deathCheck}}
            <span class="gc-warn">
              {{localize "GWORLD.Chat.DeathCheck"}} {{r.survivalModifier}}
            </span>
          {{/if}}
        </div>
      {{/if}}

      {{#if r.knockback}}
        <div class="gc-mods">
          <span class="gc-warn">{{localize "GWORLD.Knockback.Pushed" yards=r.knockback.yards}}</span>
          {{#if r.knockback.fallRollPenalty}}
            <span class="gc-mod">{{localize "GWORLD.Knockback.StayUp"}} {{r.knockback.fallRollPenalty}}</span>
          {{/if}}
          {{#if r.knockbackStun}}
            {{!-- "must make an IQ roll or be mentally stunned" (p. 417). --}}
            <span class="gc-warn">
              {{localize "GWORLD.Cinematic.StunRoll"}} {{r.knockbackStun.penalty}}
            </span>
          {{/if}}
        </div>
      {{/if}}
    </div>
  {{/each}}
</div>
