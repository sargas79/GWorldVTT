<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{name}}</span>
    <span class="gc-target">{{localize "GWORLD.Fright.Title"}}</span>
  </div>

  <div class="gc-mods">
    <span>{{localize "GWORLD.Secondary.Will"}} {{will}}</span>
    {{#if modifier}}<span class="gc-mod">{{signed modifier}}</span>{{/if}}
    {{#if traitBonus}}
      <span class="gc-mod">{{signed traitBonus}} {{localize "GWORLD.Fright.Traits"}}</span>
    {{/if}}
    <span class="gc-mod">{{localize "GWORLD.Chat.Target"}} {{effective}}</span>
    {{#if capped}}
      <span class="gc-mod">{{localize "GWORLD.Fright.RuleOf14" ceiling=ceiling}}</span>
    {{/if}}
  </div>

  <div class="gc-dice">
    {{#each dice as |die|}}<span class="gc-die">{{die}}</span>{{/each}}
    <span class="gc-total">{{roll}}</span>
  </div>

  {{#if success}}
    <div class="gc-result success">{{localize "GWORLD.Fright.Held"}}</div>
  {{else}}
    <div class="gc-result failure">
      {{localize "GWORLD.Fright.Failed" margin=margin}}
    </div>
    <div class="gc-applied">
      <div class="gc-applied-head">
        <strong>{{localize "GWORLD.Fright.TableTitle"}}</strong>
        <span class="gc-mod">
          {{result.roll}} + {{result.margin}} = {{result.total}}
        </span>
      </div>
      <div class="gc-result crit-failure">
        {{result.effect}}
        {{#if result.gmDecides}}
          <span class="gc-mod">{{localize "GWORLD.Fright.GmDecides"}}</span>
        {{/if}}
      </div>
    </div>
  {{/if}}
</div>
