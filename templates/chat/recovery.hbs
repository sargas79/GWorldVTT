<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{name}}</span>
    <span class="gc-target">{{kind}}</span>
  </div>

  <div class="gc-mods">
    <span>{{detail}}</span>
    {{#if target}}<span class="gc-mod">{{localize "GWORLD.Chat.Target"}} {{target}}</span>{{/if}}
  </div>

  {{#if dice}}
    <div class="gc-dice">
      {{#each dice as |die|}}<span class="gc-die">{{die}}</span>{{/each}}
      <span class="gc-total">{{roll}}</span>
    </div>
  {{/if}}

  {{#if lines}}
    {{!-- A doctor's roll says several things rather than moving one number:
         what the tools were worth, what the operation did, what still has to
         be checked (Campaigns pp. 424-425). --}}
    <div class="gc-result {{#if good}}success{{/if}}{{#if bad}}failure{{/if}}">
      {{#each lines as |line|}}<div>{{line}}</div>{{/each}}
    </div>
  {{else if full}}
    <div class="gc-result">{{localize "GWORLD.Recovery.AlreadyWell"}}</div>
  {{else if gained}}
    <div class="gc-result {{#if criticalFailure}}crit-failure{{else}}success{{/if}}">
      {{#if criticalSuccess}}{{localize "GWORLD.Recovery.CriticalSuccess"}} &mdash; {{/if}}
      {{#if criticalFailure}}{{localize "GWORLD.Recovery.CriticalFailure"}} &mdash; {{/if}}
      <strong>{{signed gained}}</strong> {{pool}}
      <span class="gc-mod">{{previous}} &rarr; {{now}} / {{max}}</span>
    </div>
  {{else}}
    <div class="gc-result failure">{{localize "GWORLD.Recovery.NoBetter"}}</div>
  {{/if}}

  {{#if warn}}<div class="gc-result crit-failure">{{warn}}</div>{{/if}}
</div>
