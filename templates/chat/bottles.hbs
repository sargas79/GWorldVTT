{{!-- Falling with bottles on the belt (Campaigns p. 411). --}}
<div class="gworld gworld-chat">
  <div class="gc-head">
    <span class="gc-label">{{localize "GWORLD.Molotov.BottlesTitle" name=name bottles=bottles}}</span>
  </div>
  <div class="gc-dice">
    {{#each dice as |die|}}<span class="gc-die">{{die}}</span>{{/each}}
  </div>
  <div class="gc-result {{#if broken}}failure{{else}}success{{/if}}">
    {{#if broken}}{{localize "GWORLD.Molotov.Broken" broken=broken}}{{else}}{{localize "GWORLD.Molotov.Intact"}}{{/if}}
  </div>
</div>
