<div class="gb">
  {{!-- The same header as the character sheet: who is being built, the step,
       and the points, so the ledger reads the way it does on the sheet. --}}
  <header class="v2-header gb-header">
    <div class="v2-portrait">
      <img src="{{#if actor.img}}{{actor.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="{{actor.name}}">
    </div>
    <div class="v2-identity">
      <div class="v2-eyebrow">
        <span>{{localize "GWORLD.Builder.Open"}}</span>
        <span aria-hidden="true">&mdash;</span>
        <span class="gb-actor">{{actor.name}}</span>
      </div>
      <h1 class="v2-title">{{localize (concat "GWORLD.Builder.Heading." stepId)}}</h1>
      <div class="v2-meta"><span>{{localize "GWORLD.Builder.Step"}} {{stepNumber}} / {{stepCount}}</span></div>
    </div>

    <div class="gb-ledgers">
      <div class="v2-points v2-points-{{points.state}}">
        <span class="v2-cp"><span class="v2-cp-label">CP</span> <b>{{points.spent}}</b><span class="v2-cp-of">/ {{points.available}}</span></span>
        <span class="v2-ready">
          {{#if (eq points.state "over")}}
            {{localize "GWORLD.SheetV2.Over" points=points.overBy}}
          {{else if (eq points.state "ready")}}
            {{localize "GWORLD.SheetV2.Ready" points=points.remaining}}
          {{else}}
            {{localize "GWORLD.SheetV2.AllSpent"}}
          {{/if}}
        </span>
      </div>
      <div class="gb-limit{{#if overDisadvantageLimit}} over{{/if}}">
        {{localize "GWORLD.Section.DisadvantageLimit"}}
        <b>{{points.disadvantageTotal}}</b> / {{points.disadvantageLimit}}
      </div>
    </div>
  </header>

  {{!-- Every step, to jump straight to one. --}}
  <nav class="gb-steps" aria-label="{{localize 'GWORLD.Builder.Title'}}">
    {{#each steps as |step|}}
      <button type="button" class="gb-step-chip{{#if step.active}} active{{/if}}{{#if step.done}} done{{/if}}"
              data-action="goto" data-step="{{step.index}}" aria-current="{{#if step.active}}step{{else}}false{{/if}}">
        <span class="gb-step-number">{{step.number}}</span>
        <span>{{localize (concat "GWORLD.Builder.Short." step.id)}}</span>
      </button>
    {{/each}}
  </nav>

  <div class="gb-body">
    <p class="gb-hint">{{localize (concat "GWORLD.Builder.Hint." stepId)}}</p>

    {{#if (eq stepId "points")}}
      <section class="v2-panel">
        {{!-- A term the party has set is read from it: no field, so nothing is written over it. --}}
        {{#if campaign.party}}
          <p class="v2-note">
            <button type="button" class="v2-link v2-campaign-lock" data-action="openParty"
                    data-tooltip="{{localize 'GWORLD.Party.SetByHint'}}">{{localize "GWORLD.Party.SetBy" party=campaign.party.name}}</button>
          </p>
        {{/if}}
        <div class="gb-fields">
          <label class="gb-field">
            <span class="v2-stat-label">{{localize "GWORLD.Points.Starting"}}</span>
            {{#if campaign.locked.startingPoints}}
              <b class="gb-locked">{{system.points.starting}}</b>
            {{else}}
            <input type="number" step="5" min="0" value="{{system.points.starting}}"
                   id="{{appId}}-starting" data-path="system.points.starting" />
            {{/if}}
          </label>
          <label class="gb-field">
            <span class="v2-stat-label">{{localize "GWORLD.Section.DisadvantageLimit"}}</span>
            {{#if campaign.locked.disadvantageLimit}}
              <b class="gb-locked">{{system.points.disadvantageLimit}}</b>
            {{else}}
            <input type="number" step="5" min="0" value="{{system.points.disadvantageLimit}}"
                   id="{{appId}}-limit" data-path="system.points.disadvantageLimit" />
            {{/if}}
          </label>
          <label class="gb-field">
            <span class="v2-stat-label">{{localize "GWORLD.Attribute.TL"}}</span>
            {{#if campaign.locked.tl}}
              <b class="gb-locked">{{system.tl}}</b>
            {{else}}
            <input type="number" step="1" min="0" value="{{system.tl}}"
                   id="{{appId}}-tl" data-path="system.tl" />
            {{/if}}
          </label>
        </div>
      </section>
    {{/if}}

    {{#if (eq stepId "templates")}}
      <section class="v2-panel">
        <div class="v2-ph-tools">
          <h2 class="v2-ph">{{localize "GWORLD.Builder.Heading.templates"}}</h2>
          <button type="button" class="v2-button v2-button-small" data-action="applyTemplate">
            {{> "gworld.plus"}} {{localize "GWORLD.Template.Apply"}}
          </button>
        </div>
        <ul class="gb-list">
          {{#each templates as |applied|}}
            <li class="gb-row">
              <span class="gb-name">{{applied.name}}</span>
              <span class="gb-detail">
                {{localize applied.kindLabel}}
                {{#if applied.attributeCost}} &middot; {{applied.attributeCost}} CP{{/if}}
                &middot; {{localize "GWORLD.Template.Granted" count=applied.granted}}
                {{#if applied.reference}}&middot; {{applied.reference}}{{/if}}
              </span>
              <span></span>
              <button type="button" class="v2-row-icon v2-row-delete" data-action="removeTemplate" data-index="{{applied.index}}"
                      aria-label="{{localize "GWORLD.Template.RemoveNamed" name=applied.name}}"
                      data-tooltip="{{localize "GWORLD.Template.Remove"}}">
                {{> "gworld.trash"}}
              </button>
            </li>
          {{else}}
            <li class="v2-empty">{{localize "GWORLD.Template.NoneApplied"}}</li>
          {{/each}}
        </ul>
      </section>
    {{/if}}

    {{#if (eq stepId "attributes")}}
      <section class="v2-panel">
        <div class="gb-attributes">
          {{#each attributes as |attr|}}
            <label class="gb-attribute">
              <span class="gb-attribute-key">{{attr.key}}</span>
              <input type="number" step="1" value="{{attr.value}}"
                     id="{{@root.appId}}-{{attr.key}}" data-path="system.attributes.{{attr.key}}"
                     aria-label="{{localize (concat "GWORLD.Attribute." attr.key)}}" />
              <span class="gb-attribute-name">{{localize (concat "GWORLD.Attribute." attr.key)}}</span>
              {{!-- What a trait or a racial template makes of it: the box bills the
                   bought figure, and this is what the character actually rolls. --}}
              {{#if attr.raised}}
                <span class="gb-attribute-total">
                  {{localize "GWORLD.Builder.AttributeTotal" total=attr.total}}
                  {{#each attr.sources as |source|}}
                    <em>{{#if source.labelKey}}{{localize source.label}}{{else}}{{source.label}}{{/if}} {{signed source.value}}</em>
                  {{/each}}
                </span>
              {{/if}}
            </label>
          {{/each}}
        </div>
        <div class="v2-stat-row">
          <span class="v2-stat-label">{{localize "GWORLD.Builder.AttributeCost"}}</span>
          <span class="v2-stat-inline">{{points.attributes}} CP</span>
        </div>
      </section>
    {{/if}}

    {{#if hasBrowse}}
      <section class="v2-panel">
        <div class="v2-ph-tools">
          <h2 class="v2-ph">{{localize (concat "GWORLD.Builder.Heading." stepId)}}</h2>
          <button type="button" class="v2-button v2-button-small" data-action="browse">
            {{> "gworld.search"}} {{localize "GWORLD.Builder.BrowseAction"}}
          </button>
        </div>
        <ul class="gb-list">
          {{#each items as |item|}}
            <li class="gb-row{{#if item.incomplete}} gb-row-incomplete{{/if}}" data-item-id="{{item.id}}">
              {{#if item.nameEditable}}
                {{!-- A quirk or a perk is the player's own words, written here; one the book
                     makes the player specify -- Habit, Distinctive Feature -- asks for that too. --}}
                <span class="gb-name-cell">
                  <input type="text" class="gb-name gb-name-input" value="{{item.name}}" placeholder="{{item.namePlaceholder}}"
                         id="{{@root.appId}}-{{item.id}}-name" data-item-name="{{item.id}}"
                         aria-label="{{localize 'GWORLD.Item.Name'}}" />
                  {{#if item.needsSpecialty}}
                    <input type="text" class="gb-specialty" value="{{item.specialty}}" placeholder="{{localize 'GWORLD.Trait.SpecialtyPlaceholder'}}"
                           id="{{@root.appId}}-{{item.id}}-specialty" data-item-specialty="{{item.id}}"
                           aria-label="{{localize 'GWORLD.Trait.Specialty'}}" />
                  {{/if}}
                </span>
              {{else if item.needsSpecialty}}
                {{!-- A trait the book makes the player specify: the behaviour, the group, the weapon. --}}
                <span class="gb-name-cell">
                  <span class="gb-name">{{item.name}}{{#if item.levelName}} <span class="gb-level-name">&middot; {{item.levelName}}</span>{{/if}}</span>
                  <input type="text" class="gb-specialty" value="{{item.specialty}}" placeholder="{{localize 'GWORLD.Trait.SpecialtyPlaceholder'}}"
                         id="{{@root.appId}}-{{item.id}}-specialty" data-item-specialty="{{item.id}}"
                         aria-label="{{localize 'GWORLD.Trait.Specialty'}}" />
                </span>
              {{else}}
                <span class="gb-name">{{item.name}}{{#if item.levelName}} <span class="gb-level-name">&middot; {{item.levelName}}</span>{{/if}}</span>
              {{/if}}
              <span class="gb-detail">{{item.detail}}</span>
              {{#if item.stepper}}
                {{!-- Levels move one at a time, and stop where the book stops. --}}
                <span class="gb-spend gb-stepper">
                  <button type="button" data-action="stepLevels" data-step="down" {{#if item.atFloor}}disabled{{/if}}
                          aria-label="{{localize 'GWORLD.Trait.OneLess'}}">&minus;</button>
                  <input type="number" min="0" step="1" value="{{item.value}}"
                         id="{{@root.appId}}-{{item.id}}-spend"
                         data-item-id="{{item.id}}" data-item-field="{{item.field}}"
                         aria-label="{{localize 'GWORLD.Trait.Levels'}}" />
                  <button type="button" data-action="stepLevels" data-step="up" {{#if item.atCeiling}}disabled{{/if}}
                          aria-label="{{localize 'GWORLD.Trait.OneMore'}}">+</button>
                  <span>{{item.unit}}</span>
                </span>
              {{else if item.field}}
                <label class="gb-spend">
                  <input type="number" min="0" step="1" value="{{item.value}}"
                         id="{{@root.appId}}-{{item.id}}-spend"
                         data-item-id="{{item.id}}" data-item-field="{{item.field}}"
                         aria-label="{{item.unit}}" />
                  <span>{{item.unit}}</span>
                </label>
              {{else}}
                <span></span>
              {{/if}}
              <button type="button" class="v2-row-icon v2-row-delete" data-action="deleteItem" data-item-id="{{item.id}}"
                      aria-label="{{localize "GWORLD.SheetV2.DeleteNamed" name=item.name}}">
                {{> "gworld.trash"}}
              </button>
            </li>
          {{else}}
            <li class="v2-empty">{{localize "GWORLD.Builder.NothingYet"}}</li>
          {{/each}}
        </ul>
      </section>
    {{/if}}

    {{#if review}}
      <section class="v2-panel">
        <div class="gb-review">
          <div class="gb-review-row gb-review-head">
            <span>{{localize "GWORLD.Builder.Review.Category"}}</span>
            <span>{{localize "GWORLD.Builder.Review.Chosen"}}</span>
            <span>CP</span>
          </div>
          {{#each review.rows as |row|}}
            <div class="gb-review-row">
              <span>{{localize row.label}}</span>
              <span>{{#if row.items}}{{row.items}}{{else}}&mdash;{{/if}}</span>
              <b class="{{#if row.negative}}neg{{/if}}">{{row.value}}</b>
            </div>
          {{/each}}
          {{#if review.gear}}
            <div class="gb-review-row dim">
              <span>{{localize "GWORLD.Builder.Heading.gear"}}</span>
              <span>{{review.gear}}</span>
              <span>{{localize "GWORLD.Builder.Review.NoPoints"}}</span>
            </div>
          {{/if}}
        </div>
        {{#if review.unnamed.length}}
          <p class="gb-incomplete">{{localize "GWORLD.Builder.Review.Unnamed" count=review.unnamed.length}}</p>
        {{/if}}
        {{#if review.unspecified.length}}
          <p class="gb-incomplete">{{localize "GWORLD.Builder.Review.Unspecified" count=review.unspecified.length names=(join review.unspecified ", ")}}</p>
        {{/if}}
        <div class="v2-stat-pair">
          <div class="v2-stat">
            <span class="v2-stat-label">{{localize "GWORLD.Points.Spent"}}</span>
            <span class="v2-stat-value{{#if review.over}} neg{{/if}}">{{review.spent}} <small>/ {{review.available}}</small></span>
          </div>
          <div class="v2-stat">
            <span class="v2-stat-label">{{localize "GWORLD.Points.Unspent"}}</span>
            <span class="v2-stat-value{{#if review.over}} neg{{/if}}">{{review.unspent}}</span>
          </div>
        </div>
      </section>
    {{/if}}
  </div>

  <footer class="gb-foot">
    <button type="button" class="v2-button" data-action="back" {{#if isFirst}}disabled{{/if}}>
      {{localize "GWORLD.Builder.Back"}}
    </button>
    {{#if isLast}}
      <button type="button" class="v2-button v2-button-gold" data-action="finish">{{localize "GWORLD.Builder.Finish"}}</button>
    {{else}}
      <button type="button" class="v2-button v2-button-gold" data-action="next">{{localize "GWORLD.Builder.Next"}}</button>
    {{/if}}
  </footer>
</div>
