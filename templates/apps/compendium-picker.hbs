<div class="gp">
  <div class="gp-search">
    <input type="search" name="search" value="{{query}}" autocomplete="off"
           placeholder="{{localize "GWORLD.Picker.Search"}}" autofocus />
    <span class="gp-count">
      {{#if loading}}
        {{localize "GWORLD.Picker.Loading"}}
      {{else if paging}}
        {{paging.label}}
      {{else}}
        {{localize "GWORLD.Picker.Count" total=total}}
      {{/if}}
    </span>
  </div>

  {{!-- The ledger, so what an entry costs can be weighed against what is
       left without going back to the sheet to look. --}}
  {{#if gearLedger}}
    <div class="gp-ledger">
      <span>{{localize "GWORLD.Picker.Carried" carried=gearLedger.carried basicLift=gearLedger.basicLift}}</span>
      <span>{{localize "GWORLD.Life.Cash"}} <strong>${{gearLedger.money}}</strong></span>
    </div>
  {{else}}
    <div class="gp-ledger {{#if ledger.over}}over{{/if}}">
      <span><strong>{{ledger.spent}}</strong> / {{ledger.available}} {{localize "GWORLD.Builder.Points"}}</span>
      <span>{{localize "GWORLD.Picker.Unspent" points=ledger.unspent}}</span>
    </div>
  {{/if}}

  <ul class="gp-list" aria-busy="{{#if loading}}true{{else}}false{{/if}}">
    {{#if loading}}
      <li class="gp-empty gp-loading">
        <span class="gp-spinner" aria-hidden="true"></span>
        {{localize "GWORLD.Picker.LoadingHint"}}
      </li>
    {{else}}
      {{#each entries as |entry|}}
        {{!-- data-picker-row, data-uuid and data-picker-name are for modules (API 1.41.0). --}}
        <li class="gp-row{{#if entry.added}} added{{/if}}{{#if entry.amountKind}} has-amount{{/if}}" data-picker-row data-uuid="{{entry.uuid}}">
          <span class="gp-name" data-picker-name>{{entry.name}}{{#if @root.showSource}} <span class="gp-source">{{entry.source}}</span>{{/if}}</span>
          <span class="gp-summary">{{entry.summary}}</span>
          {{#if entry.amountKind}}
            {{!-- Stepped by buttons, not the browser's spinner: points climb a
                  cost table, so the step is not always one. --}}
            {{!-- A div, not a label: a button is labelable, so a label wrapping
                  these would make the minus button its control and clicking the
                  text beside the field would quietly step the amount down. --}}
            <div class="gp-amount">
              <button type="button" class="gp-step" data-step-for="{{entry.uuid}}" data-step="-1"
                      aria-label="{{localize 'GWORLD.Picker.StepDown'}}"
                      data-tooltip="{{localize 'GWORLD.Picker.StepDown'}}">&minus;</button>
              <input type="number" min="1" value="{{entry.amount}}"
                     {{#if entry.max}}max="{{entry.max}}"{{/if}}
                     data-amount-for="{{entry.uuid}}" aria-label="{{entry.unit}}" />
              <button type="button" class="gp-step" data-step-for="{{entry.uuid}}" data-step="1"
                      aria-label="{{localize 'GWORLD.Picker.StepUp'}}"
                      data-tooltip="{{localize 'GWORLD.Picker.StepUp'}}">+</button>
              <span class="gp-unit">{{entry.unit}}</span>
              <span class="gp-cost">{{entry.cost}}</span>
              {{#if entry.levelLabel}}<span class="gp-level">{{entry.levelLabel}}</span>{{/if}}
            </div>
          {{else}}
            <span class="gp-amount"></span>
          {{/if}}
          <span class="gp-buttons">
            {{!-- Gear can be taken two ways: written onto the sheet out of
                 starting wealth, or bought with the money in hand. --}}
            {{#if entry.buy}}
              <button type="button" class="gp-add gp-buy" data-action="buy" data-uuid="{{entry.uuid}}"
                      data-tooltip="{{localize 'GWORLD.Shopping.BuyHint'}}">{{entry.buy}}</button>
            {{/if}}
            <button type="button" class="gp-add" data-action="add" data-uuid="{{entry.uuid}}"
                    {{#if entry.buy}}data-tooltip="{{localize 'GWORLD.Shopping.AddHint'}}"{{/if}}>
              {{#if entry.added}}{{localize "GWORLD.Picker.AddAgain"}}{{else}}{{localize "GWORLD.Picker.Add"}}{{/if}}
            </button>
          </span>
        </li>
      {{else}}
        <li class="gp-empty">{{localize "GWORLD.Picker.Empty"}}</li>
      {{/each}}
    {{/if}}
  </ul>
  {{#if paging}}
    <div class="gp-pages">
      <button type="button" class="ibtn" data-action="page" data-page="-1" {{#if paging.first}}disabled{{/if}}>&lsaquo; {{localize "GWORLD.Picker.Previous"}}</button>
      <span class="gp-page">{{paging.page}}</span>
      <button type="button" class="ibtn" data-action="page" data-page="1" {{#if paging.last}}disabled{{/if}}>{{localize "GWORLD.Picker.Next"}} &rsaquo;</button>
    </div>
  {{/if}}
  {{#if custom}}
    <div class="gp-custom">
      <button type="button" class="gp-add" data-action="addCustom">{{> "gworld.plus"}} {{custom.label}}</button>
      {{#if custom.hint}}<span class="gp-custom-hint">{{custom.hint}}</span>{{/if}}
    </div>
  {{/if}}
</div>
