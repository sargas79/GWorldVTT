<div class="gr">
  <p class="gr-intro">{{localize "GWORLD.Rules.Intro"}}</p>

  <input type="search" name="rule-search" class="gr-search" value="{{query}}" autocomplete="off"
         placeholder="{{localize 'GWORLD.Rules.Search'}}" aria-label="{{localize 'GWORLD.Rules.Search'}}" />

  <div class="gr-bulk">
    {{!-- While a search is typed these act on only the rules it shows, and
         say so: the label is swapped as the search filters. --}}
    <button type="button" class="ibtn" data-action="allOn"
            data-label-all="{{localize 'GWORLD.Rules.AllOn'}}" data-label-shown="{{localize 'GWORLD.Rules.ShownOn'}}">{{localize "GWORLD.Rules.AllOn"}}</button>
    <button type="button" class="ibtn" data-action="allOff"
            data-label-all="{{localize 'GWORLD.Rules.AllOff'}}" data-label-shown="{{localize 'GWORLD.Rules.ShownOff'}}">{{localize "GWORLD.Rules.AllOff"}}</button>
    <button type="button" class="ibtn" data-action="restore">{{localize "GWORLD.Rules.Restore"}}</button>
  </div>

  <div class="gr-body">
    {{#each groups as |group|}}
      <section class="gr-group" data-search="{{group.search}}">
        <h3>{{localize group.label}}{{#if group.source}} <span class="gr-source">{{group.source}}</span>{{/if}}</h3>
        {{#each group.rules as |rule|}}
          <label class="gr-rule{{#if rule.pending}} pending{{/if}}" data-search="{{rule.search}}">
            <input type="checkbox" data-rule="{{rule.key}}"
                   {{#if rule.enabled}}checked{{/if}} {{#if rule.pending}}disabled{{/if}} />
            <span class="gr-text">
              <span class="gr-name">
                {{localize rule.label}}
                <span class="gr-ref">{{rule.reference}}</span>
                {{#if rule.referenceUuid}}
                  {{!-- A button inside the label is interactive content, so
                       pressing it opens the page without ticking the box. --}}
                  <button type="button" class="gr-refpage" data-action="openReference" data-uuid="{{rule.referenceUuid}}"
                          data-tooltip="{{localize 'GWORLD.Rules.ReadRule'}}" aria-label="{{localize 'GWORLD.Rules.ReadRule'}}">
                    <i class="fa-solid fa-book-open" inert></i>
                  </button>
                {{/if}}
                {{#if rule.pending}}
                  <span class="gr-pending">{{localize "GWORLD.Rules.NotYet"}}</span>
                {{/if}}
              </span>
              <span class="gr-hint">{{localize rule.hint}}</span>
            </span>
          </label>
        {{else}}
          <p class="gr-hint gr-empty">{{localize "GWORLD.Rules.NoneYet"}}</p>
        {{/each}}
      </section>
    {{/each}}
    <p class="gr-hint gr-empty gr-nomatch" hidden>{{localize "GWORLD.Rules.NoMatch"}}</p>
  </div>

  <div class="gr-foot">
    {{#if dirty}}<span class="gr-dirty">{{localize "GWORLD.Rules.Unsaved"}}</span>{{/if}}
    <button type="button" class="ibtn" data-action="save">{{localize "GWORLD.Rules.Save"}}</button>
  </div>
</div>
