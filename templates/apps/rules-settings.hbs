<div class="gr">
  <p class="gr-intro">{{localize "GWORLD.Rules.Intro"}}</p>

  <div class="gr-bulk">
    <button type="button" class="ibtn" data-action="allOn">{{localize "GWORLD.Rules.AllOn"}}</button>
    <button type="button" class="ibtn" data-action="allOff">{{localize "GWORLD.Rules.AllOff"}}</button>
    <button type="button" class="ibtn" data-action="restore">{{localize "GWORLD.Rules.Restore"}}</button>
  </div>

  <div class="gr-body">
    {{#each groups as |group|}}
      <section class="gr-group">
        <h3>{{localize group.label}}</h3>
        {{#each group.rules as |rule|}}
          <label class="gr-rule{{#if rule.pending}} pending{{/if}}">
            <input type="checkbox" data-rule="{{rule.key}}"
                   {{#if rule.enabled}}checked{{/if}} {{#if rule.pending}}disabled{{/if}} />
            <span class="gr-text">
              <span class="gr-name">
                {{localize rule.label}}
                <span class="gr-ref">{{rule.reference}}</span>
                {{#if rule.referenceUuid}}
                  {{!-- A button inside the label is interactive content, so
                       pressing it opens the page without ticking the box. --}}
                  <button type="button" class="gr-refpage" data-action="openReference" data-uuid="{{rule.referenceUuid}}"
                          data-tooltip="{{localize 'GWORLD.Rules.ReadRule'}}" aria-label="{{localize 'GWORLD.Rules.ReadRule'}}">
                    <i class="fa-solid fa-book-open" inert></i>
                  </button>
                {{/if}}
                {{#if rule.pending}}
                  <span class="gr-pending">{{localize "GWORLD.Rules.NotYet"}}</span>
                {{/if}}
              </span>
              <span class="gr-hint">{{localize rule.hint}}</span>
            </span>
          </label>
        {{/each}}
      </section>
    {{/each}}
  </div>

  <div class="gr-foot">
    {{#if dirty}}<span class="gr-dirty">{{localize "GWORLD.Rules.Unsaved"}}</span>{{/if}}
    <button type="button" class="ibtn" data-action="save">{{localize "GWORLD.Rules.Save"}}</button>
  </div>
</div>
