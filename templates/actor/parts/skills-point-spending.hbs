{{!-- A section of the character sheet, in a partial of its own: point spending. --}}
{{!-- Points to spend on outcomes (Campaigns p. 347), while a module's pool is in play. --}}
{{#if pointSpending.inPlay}}
  <div class="npcline" style="gap: 10px; align-items: center; flex-wrap: wrap">
    <span class="fl">{{localize "GWORLD.BonusPoints.Title"}}</span>
    <span class="tag">{{localize "GWORLD.BonusPoints.Unspent" value=derived.points.unspent}}</span>
    {{!-- Pools add-on modules registered. --}}
    {{#each pointSpending.pools as |pool|}}
      <span class="tag tag-accent">{{localize "GWORLD.BonusPoints.Pool" label=pool.label value=pool.available}}</span>
    {{/each}}
    {{#if derived.sessionPools.impulseMax}}
      <span class="tag tag-accent">{{localize "GWORLD.BonusPoints.Impulse" value=derived.sessionPools.impulse max=derived.sessionPools.impulseMax}}</span>
    {{/if}}
    {{#if editable}}
      <button type="button" class="ibtn" data-action="requestGuidance" data-tooltip="{{localize 'GWORLD.BonusPoints.GuidanceHint'}}">{{localize "GWORLD.BonusPoints.Guidance"}}</button>
    {{/if}}
  </div>
{{/if}}
{{!-- What renews each session: Impulse Points and Foresight (Basic Set Revised pp. 326-327). --}}
{{#if derived.sessionPools.foresightMax}}
  <div class="npcline" style="gap: 10px; align-items: center; flex-wrap: wrap">
    <span class="fl">{{localize "GWORLD.BonusPoints.SessionTitle"}}</span>
    <span class="tag tag-accent">{{localize "GWORLD.BonusPoints.Foresight" value=derived.sessionPools.foresight max=derived.sessionPools.foresightMax}}</span>
    {{#if editable}}
      <button type="button" class="ibtn" data-action="useForesight" data-tooltip="{{localize 'GWORLD.BonusPoints.ForesightHint'}}">{{localize "GWORLD.BonusPoints.ForesightUse"}}</button>
    {{/if}}
  </div>
{{/if}}
{{#if editable}}
  {{#if derived.sessionPools.impulseMax}}
    <div class="npcline" style="gap: 10px; align-items: center">
      <button type="button" class="ibtn" data-action="startSession" data-tooltip="{{localize 'GWORLD.BonusPoints.StartSessionHint'}}">{{localize "GWORLD.BonusPoints.StartSession"}}</button>
    </div>
  {{else}}{{#if derived.sessionPools.foresightMax}}
    <div class="npcline" style="gap: 10px; align-items: center">
      <button type="button" class="ibtn" data-action="startSession" data-tooltip="{{localize 'GWORLD.BonusPoints.StartSessionHint'}}">{{localize "GWORLD.BonusPoints.StartSession"}}</button>
    </div>
  {{/if}}{{/if}}
{{/if}}
