{{!-- What an affliction attack's resistance roll reads. Shared by the attack cards and the Combat tab, so a roll made from either carries the same data. --}}
data-action="affliction"
data-resist="{{atk.afflictionAttribute}}"
data-resist-modifier="{{atk.afflictionModifier}}"
data-half-damage-range="{{atk.halfDamageRange}}"
data-area-attack="{{#if atk.areaAttack}}1{{/if}}"
{{!-- What forced the roll, for the modules that read it. --}}
data-item-id="{{atk.itemId}}" data-mode-index="{{atk.modeIndex}}" data-mode-ranged="1" data-derived-mode="{{atk.derivedMode}}"
data-damage-type="{{atk.damageType}}"
{{!-- What the victim's DR is worth to the roll: the divisor divides it, and an attack that ignores DR leaves none (Characters p. 35). --}}
data-armor-divisor="{{atk.armorDivisor}}" data-ignores-dr="{{#if atk.ignoresDr}}1{{/if}}"
data-affliction-label="{{atk.name}} {{atk.mode}}"
