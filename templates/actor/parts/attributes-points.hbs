{{!-- Shared by both character sheets: the attributes tab's points. --}}
<div class="isec">
  <div class="ish"><span class="num">05</span>{{localize "GWORLD.Section.CharacterPoints"}}</div>
  {{#if editable}}
    <div class="toolbar">
      <button type="button" class="ibtn" data-action="openBuilder">
        {{> "gworld.plus"}} {{localize "GWORLD.Builder.Open"}}
      </button>
    </div>
  {{/if}}
  <div class="ledger">
    <div class="lrow"><span>{{localize "GWORLD.Points.Attributes"}}</span><span>{{derived.points.attributes}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Secondaries"}}</span><span>{{derived.points.secondaries}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Advantages"}}</span><span>{{derived.points.advantages}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Disadvantages"}}</span><span class="neg">{{derived.points.disadvantages}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Quirks"}}</span><span class="neg">{{derived.points.quirks}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Languages"}}</span><span>{{derived.points.languages}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Skills"}}</span><span>{{derived.points.skills}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Techniques"}}</span><span>{{derived.points.techniques}}</span></div>
    <div class="lrow ltot"><span>{{localize "GWORLD.Points.Spent"}}</span><span>{{derived.points.spent}}</span></div>
    <div class="lrow lsep"><span>{{localize "GWORLD.Points.Starting"}}</span><span>{{derived.points.starting}}</span></div>
    <div class="lrow"><span>{{localize "GWORLD.Points.Earned"}}</span><span>{{derived.points.earned}}</span></div>
    <div class="lrow ltot">
      <span>{{localize "GWORLD.Points.Unspent"}}</span>
      <span class="{{#if overBudget}}over{{/if}}">{{derived.points.unspent}}</span>
    </div>
  </div>

  {{#if editable}}
    <div class="toolbar">
      <button type="button" class="ibtn" data-action="awardPoints"
              data-tooltip="{{localize "GWORLD.Points.AwardHint"}}">
        {{> "gworld.plus"}} {{localize "GWORLD.Points.Award"}}
      </button>
    </div>
  {{/if}}

  {{#if awards.length}}
    <table class="gt">
      <thead>
        <tr>
          <th class="c">{{localize "GWORLD.Points.AwardPoints"}}</th>
          <th>{{localize "GWORLD.Points.AwardNote"}}</th>
          <th class="c">{{localize "GWORLD.Points.AwardWhen"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each awards as |award|}}
          <tr>
            <td class="c"><span class="lvl">{{signed award.points}}</span></td>
            <td>{{award.note}}</td>
            <td class="c wmode">{{award.when}}</td>
            <td class="c">
              {{#if @root.editable}}
                <button type="button" class="tdel rollable iconbtn" data-action="deleteAward"
                        data-index="{{award.index}}"
                        title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
              {{/if}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{/if}}
  <div class="inote {{#if pointsWarning.over}}warn{{/if}}">
    {{> "gworld.info"}}
    <span>{{pointsWarning.text}}</span>
  </div>
</div>
