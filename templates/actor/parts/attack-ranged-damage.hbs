{{!-- What an attack's damage roll reads. Shared by the attack cards and the Combat tab, so a roll made from either carries the same data. --}}
{{#if atk.damageRollable}}data-action="rollDamage"
data-damage-formula="{{atk.damage}}" data-damage-type="{{atk.damageType}}"
data-damage-label="{{atk.name}} {{atk.mode}}" data-armor-divisor="{{atk.armorDivisor}}" data-material="{{atk.material}}"
data-explosive="{{#if atk.explosive}}1{{/if}}"
data-ignores-dr="{{#if atk.ignoresDr}}1{{/if}}"
data-incendiary="{{#if atk.incendiary}}1{{/if}}"
data-radiation="{{#if atk.radiation}}1{{/if}}"
data-double-knockback="{{#if atk.doubleKnockback}}1{{/if}}"
data-no-knockback="{{#if atk.noKnockback}}1{{/if}}"
data-kinetic-only="{{#if atk.kineticOnly}}1{{/if}}"
data-surge="{{#if atk.surge}}1{{/if}}"
data-st-based="{{#if atk.stBased}}1{{/if}}"
data-fragmentation="{{atk.fragmentation}}"{{/if}}
