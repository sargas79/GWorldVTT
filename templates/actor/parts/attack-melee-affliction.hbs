{{!-- What an affliction attack's resistance roll reads. Shared by the attack cards and the Combat tab, so a roll made from either carries the same data. --}}
data-action="affliction"
data-resist="{{atk.afflictionAttribute}}"
data-resist-modifier="{{atk.afflictionModifier}}"
{{!-- What forced the roll, for the modules that read it. --}}
data-item-id="{{atk.itemId}}" data-mode-index="{{atk.modeIndex}}" data-derived-mode="{{atk.derivedMode}}"
data-damage-type="{{atk.damageType}}"
data-affliction-label="{{atk.name}} {{atk.mode}}"
