{{!-- A section of the character sheet, in a partial of its own: templates. --}}
{{!-- What this character was built from. A template is not a thing they own,
      so it is listed here rather than sitting in the trait list. --}}
<div class="isec">
  <div class="ish">
    <span class="num">{{templateSectionNum}}</span>{{localize "GWORLD.Template.Title"}}
    {{#if appliedTemplates.length}}
      <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
        {{templatesTotal}} pts
      </span>
    {{/if}}
  </div>

  {{#each appliedTemplates as |applied i|}}
    <div class="cell">
      <span class="cl">{{localize (concat "GWORLD.Template." applied.kind)}}</span>
      <span class="cv" style="font-size: 16px">
        {{#if applied.uuid}}
          <a data-action="openTemplate" data-uuid="{{applied.uuid}}">{{applied.name}}</a>
        {{else}}
          {{applied.name}}
        {{/if}}
      </span>
      <span class="cd">
        {{localize "GWORLD.Template.Total" points=applied.total}}
        {{#if applied.statedCost includeZero=true}}
          ({{localize "GWORLD.Template.StatedCostNote" points=applied.statedCost}})
        {{/if}}
        &middot; {{localize "GWORLD.Template.Granted" count=applied.itemIds.length}}
        {{#if applied.reference}}
          &middot; <span class="ref" data-tooltip="{{localize "GWORLD.Template.ReferenceHint"}}">{{applied.reference}}</span>
        {{/if}}
      </span>
      {{!-- Everything it gave, folded: a big template grants dozens of things. --}}
      {{#if applied.grants.length}}
        <details class="td tdfold tpl-grants">
          <summary>{{localize "GWORLD.Template.Grants" count=applied.grants.length}}</summary>
          <ul class="tpl-grant-list">
            {{#each applied.grants as |line|}}<li>{{line}}</li>{{/each}}
          </ul>
        </details>
      {{/if}}
      {{!-- The template's own text, folded to its first line as a trait's is. --}}
      {{#if applied.descriptionHtml}}
        {{#if applied.description.more}}
          <details class="td tdfold" data-description-for="{{applied.descriptionKey}}" {{#if applied.description.open}}open{{/if}}>
            <summary title="{{localize "GWORLD.Trait.DescriptionHint"}}">
              <span class="tdfirst">{{applied.description.first}}</span>
              <span class="tdless">{{localize "GWORLD.Trait.ShowLess"}}</span>
            </summary>
            <div class="tdfull">{{{applied.descriptionHtml}}}</div>
          </details>
        {{else}}
          <span class="td">{{{applied.descriptionHtml}}}</span>
        {{/if}}
      {{/if}}
      {{#if @root.editable}}
        <div class="toolbar">
          <button type="button" class="ibtn tiny" data-action="removeTemplate" data-index="{{i}}">
            {{localize "GWORLD.Template.Remove"}}
          </button>
        </div>
      {{/if}}
    </div>
  {{else}}
    <p class="ihint">{{localize "GWORLD.Template.NoneApplied"}}</p>
  {{/each}}

  {{#if editable}}
    <div class="toolbar">
      <button type="button" class="ibtn" data-action="applyTemplate"
              data-tooltip="{{localize "GWORLD.Template.ApplyHint"}}">
        {{localize "GWORLD.Template.Apply"}}
      </button>
    </div>
  {{/if}}
</div>
