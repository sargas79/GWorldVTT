{{!-- What an attack roll reads. Shared by the attack cards and the Combat tab, so a roll made from either carries the same data. --}}
data-action="roll" data-roll-type="attack" data-roll-skill="{{atk.skillName}}"
data-tooltip="{{localize 'GWORLD.Ranged.QuickShotHint'}}"
data-mode-index="{{atk.modeIndex}}"
data-loaded="{{#if atk.shotsCapacity}}{{atk.shotsLoaded}}{{/if}}"
data-roll-label="{{atk.name}}" data-roll-target="{{atk.skillLevel}}"
data-damage-type="{{atk.damageType}}" data-tight-beam="{{#if atk.tightBeam}}1{{/if}}"
data-ranged="1" data-thrown="{{#if atk.thrown}}1{{/if}}"
data-malediction="{{atk.malediction}}"
data-resist-with="{{#if atk.affliction}}{{atk.afflictionAttribute}}{{/if}}"
data-accuracy="{{atk.accuracy}}"
data-scope-bonus="{{atk.scopeBonus}}" data-scope-fixed="{{#if atk.scopeFixed}}1{{/if}}"
data-rate-of-fire="{{atk.rateOfFire}}" data-full-auto-only="{{#if atk.fullAutoOnly}}1{{/if}}" data-recoil="{{atk.recoil}}" data-mount="{{atk.mount}}" data-off-mount="{{#if atk.offMount}}1{{/if}}"
data-no-spraying-fire="{{#if atk.noSprayingFire}}1{{/if}}" data-no-suppression-fire="{{#if atk.noSuppressionFire}}1{{/if}}"
data-projectiles="{{atk.projectiles}}" data-first-hit="{{#if atk.firstHit}}1{{/if}}" data-half-damage-range="{{atk.halfDamageRange}}"
data-max-range="{{atk.maxRange}}" data-min-range="{{atk.minRange}}" data-guidance="{{atk.guidance}}" data-aiming-skill="{{atk.aimingSkill}}" data-guided-skill-level="{{atk.guidedSkillLevel}}"
data-area-attack="{{#if atk.areaAttack}}1{{/if}}" data-cone-max-width="{{atk.coneMaxWidth}}"
data-weapon-weight="{{atk.weight}}" data-material="{{atk.material}}"
data-resists-breakage="{{#if atk.resistsBreakage}}1{{/if}}"
data-bulk="{{atk.bulk}}" data-malfunction="{{atk.malfunction}}"
