{{!-- A section of the character sheet, in a partial of its own: basic. --}}
<div class="isec">
  <div class="ish"><span class="num">01</span>{{localize "GWORLD.Section.BasicAttributes"}}</div>
  <div class="g4">
    {{#each attributeCards as |attr|}}
      <div class="attr blueprint">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <span class="iroll rollable" data-action="roll" data-roll-type="attribute"
              data-roll-label="{{attr.label}}" data-roll-target="{{attr.rollTarget}}"
              data-based-on="{{attr.key}}">
          {{> "gworld.die"}}
        </span>
        <span class="al">{{attr.key}}{{#if attr.weakened}}<em class="tired"
              data-tooltip="{{localize "GWORLD.Health.VeryTiredHint"}}">{{attr.rollTarget}}</em>{{/if}}</span>
        {{!-- The input is the bought figure, which is what is billed; the score
             the character has, with what traits and templates add, beside it. --}}
        <span class="avrow">
          <input class="av" type="number" name="system.attributes.{{attr.key}}" value="{{attr.value}}"
                 aria-label="{{localize "GWORLD.Attribute.Bought" key=attr.key}}"
                 {{#unless @root.editable}}disabled{{/unless}}>
          {{#if attr.raised}}<span class="aeff" data-tooltip="{{localize "GWORLD.Attribute.ScoreHint"}}"
                aria-label="{{localize "GWORLD.Attribute.Score" key=attr.key score=attr.effective}}">&rarr; {{attr.effective}}</span>{{/if}}
        </span>
        <span class="ac">
          {{attr.cost}} pts
          {{#if attr.racial}}&middot; {{signed attr.racial}} {{localize "GWORLD.Attribute.FromTemplate"}}{{/if}}
          {{#if attr.bonus}}&middot; {{signed attr.bonus}} {{localize "GWORLD.Attribute.FromTraits"}}{{/if}}
          {{#each attr.addonLines as |line|}}&middot; <span data-tooltip="{{line.reason}}">{{signed line.value}} {{line.label}}</span>{{/each}}
        </span>
      </div>
    {{/each}}
  </div>
</div>
