{{!-- Shared by both character sheets: the gear tab's encumbrance. --}}
<div class="isec">
  <div class="ish">
    <span class="num">01</span>{{localize "GWORLD.Field.Encumbrance"}}
    <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
      {{localize "GWORLD.Secondary.BasicLift"}} {{derived.basicLift}} lb &middot;
      {{localize "GWORLD.Gear.Carrying"}} {{decimal derived.encumbrance.carriedWeight 1}} lb
    </span>
  </div>
  <div class="enc">
    {{#each encumbranceTiers as |tier|}}
      <div class="encs {{#if tier.active}}on{{/if}}">
        <span class="el">{{localize tier.label}}</span>
        <span class="ev">{{tier.move}}</span>
        <span class="em">&le; {{tier.limit}} lb</span>
      </div>
    {{/each}}
  </div>
  {{#if derived.encumbrance.overloaded}}
    <div class="inote warn">
      {{> "gworld.info"}}<span>{{localize "GWORLD.Hint.Overloaded"}}</span>
    </div>
  {{/if}}
</div>
