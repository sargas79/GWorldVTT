<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="isec">
    <div class="ish">
      <span class="num">01</span>{{localize "GWORLD.Field.Encumbrance"}}
      <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
        {{localize "GWORLD.Secondary.BasicLift"}} {{derived.basicLift}} lb &middot;
        {{localize "GWORLD.Gear.Carrying"}} {{decimal derived.encumbrance.carriedWeight 1}} lb
      </span>
    </div>
    <div class="enc">
      {{#each encumbranceTiers as |tier|}}
        <div class="encs {{#if tier.active}}on{{/if}}">
          <span class="el">{{localize tier.label}}</span>
          <span class="ev">{{tier.move}}</span>
          <span class="em">&le; {{tier.limit}} lb</span>
        </div>
      {{/each}}
    </div>
    {{#if derived.encumbrance.overloaded}}
      <div class="inote warn">
        {{> "gworld.info"}}<span>{{localize "GWORLD.Hint.Overloaded"}}</span>
      </div>
    {{/if}}
  </div>

  <div class="isec">
    <div class="ish"><span class="num">02</span>{{localize "GWORLD.Gear.Carried"}}</div>
    <div class="toolbar">
      {{!-- One kind at a time, or the whole inventory. Not a form field: it
           filters what is shown and writes nothing to the actor. --}}
      {{#if gearGroups.length}}
        <label class="srch gfilter">
          <span class="wmode">{{localize "GWORLD.Gear.Show"}}</span>
          <select data-gear-filter aria-label="{{localize 'GWORLD.Gear.Show'}}">
            <option value="">{{localize "GWORLD.Gear.All"}}</option>
            {{#each gearGroups as |group|}}
              <option value="{{group.key}}" {{#if group.selected}}selected{{/if}}>{{localize group.label}} ({{group.rows.length}})</option>
            {{/each}}
          </select>
        </label>
      {{/if}}
      {{#if editable}}
        <button type="button" class="ibtn" data-action="createItem" data-item-type="equipment">
          {{> "gworld.plus"}} {{localize "GWORLD.Action.AddEquipment"}}
        </button>
        <button type="button" class="ibtn" data-action="createItem" data-item-type="armor">
          {{> "gworld.plus"}} {{localize "GWORLD.Action.AddArmor"}}
        </button>
        <button type="button" class="ibtn" data-action="createItem" data-item-type="shield">
          {{> "gworld.plus"}} {{localize "GWORLD.Action.AddShield"}}
        </button>
        <button type="button" class="ibtn" data-action="browseCompendium"
                data-item-types="equipment,armor,shield" data-browse-title="GWORLD.Picker.Gear">
          {{> "gworld.search"}} {{localize "GWORLD.Action.BrowseGear"}}
        </button>
      {{/if}}
    </div>
    {{#if gearGroups.length}}
      <table class="gt">
        <thead>
          <tr>
            <th class="c">{{localize "GWORLD.Column.Eq"}}</th>
            <th>{{localize "GWORLD.Column.Item"}}</th>
            <th class="n">{{localize "GWORLD.Column.Qty"}}</th>
            <th class="n">{{localize "GWORLD.Column.Weight"}}</th>
            <th class="n">{{localize "GWORLD.Column.Cost"}}</th>
            <th>{{localize "GWORLD.Column.Notes"}}</th>
            <th></th>
          </tr>
        </thead>
        {{#each gearGroups as |group|}}
          <tbody data-gear-group="{{group.key}}">
            <tr class="ggroup">
              <td colspan="7">{{localize group.label}}</td>
            </tr>
            {{#each group.rows as |row|}}
              <tr data-item-id="{{row.id}}">
                <td class="c">
                  {{#if row.equippable}}
                    <input type="checkbox" data-action="toggleEquipped" {{#if row.equipped}}checked{{/if}}
                           {{#unless @root.editable}}disabled{{/unless}}>
                  {{/if}}
                </td>
                <td><span class="wname" data-action="editItem">{{row.name}}</span></td>
                <td class="n">{{row.quantity}}</td>
                <td class="n">{{decimal row.weight 1}} lb</td>
                <td class="n">${{row.cost}}</td>
                <td class="wmode">{{row.notes}}</td>
                <td class="c">
                  {{#if @root.editable}}
                    <button type="button" class="rollable iconbtn" data-action="deleteItem" title="{{localize 'GWORLD.Action.Delete'}}">
                      {{> "gworld.trash"}}
                    </button>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        {{/each}}
      </table>
    {{else}}
      <div class="inote">{{> "gworld.info"}}<span>{{localize "GWORLD.Hint.NothingCarried"}}</span></div>
    {{/if}}
  </div>

  {{#if items.stored.length}}
    <div class="isec">
      <div class="ish">
        <span class="num">03</span>{{localize "GWORLD.Gear.Stored"}}
        <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
          {{localize "GWORLD.Hint.StoredNoEncumbrance"}}
        </span>
      </div>
      <table class="gt">
        <tbody>
          {{#each items.stored as |item|}}
            <tr class="dim" data-item-id="{{item.id}}">
              <td><span class="wname" data-action="editItem">{{item.name}}</span></td>
              <td class="n">{{item.system.quantity}}</td>
              <td class="n">{{decimal item.system.weight 1}} lb</td>
              <td class="n">${{item.system.cost}}</td>
              <td class="c">
                {{#if @root.editable}}
                  <button type="button" class="rollable iconbtn" data-action="deleteItem"
                          title="{{localize 'GWORLD.Action.Delete'}}"
                          aria-label="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  {{!-- What the Wealth on the traits tab is worth in money, and what keeping
        up the Status costs (Characters pp. 25-27, 265; Campaigns p. 517). --}}
  <div class="isec">
    <div class="ish">
      <span class="num">04</span>{{localize "GWORLD.Life.Money"}}
      <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
        {{localize (concat "GWORLD.Life.Wealth." derived.wealth.level)}}{{#if derived.wealth.multimillionaire}} {{derived.wealth.multimillionaire}}{{/if}}
        &middot; {{localize "GWORLD.Life.Status"}} {{signed derived.wealth.status}}
      </span>
    </div>
    <div class="cellgrid">
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Life.Cash"}}</span>
        <span class="cv">$<input type="number" name="system.money" value="{{system.money}}" step="1"
               style="width: 110px; background: none; border: 1px solid var(--color-divider); font: inherit; color: inherit"
               {{#unless editable}}disabled{{/unless}}></span>
        <span class="cd">{{localize "GWORLD.Life.StartingWealth"}} ${{derived.wealth.startingWealth}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Life.GearCost"}}</span>
        <span class="cv">${{derived.wealth.gearCost}}</span>
        <span class="cd">{{localize "GWORLD.Life.GearHint"}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Life.CostOfLiving"}}</span>
        <span class="cv">${{derived.wealth.costOfLiving}}</span>
        <span class="cd">{{localize "GWORLD.Life.PerMonth"}}</span>
        {{#if (and editable rules.jobs)}}
          <div class="toolbar">
            <button type="button" class="ibtn tiny" data-action="payLiving">{{localize "GWORLD.Life.Pay"}}</button>
          </div>
        {{/if}}
      </div>
    </div>
    {{#if rules.jobs}}
      <div class="g4" style="margin-top: 8px">
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Life.JobTitle"}}</span>
          <div class="fi"><input type="text" name="system.job.title" value="{{system.job.title}}" {{#unless editable}}disabled{{/unless}}></div>
        </div>
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Life.JobSkill"}}</span>
          <div class="fi"><input type="text" name="system.job.skill" value="{{system.job.skill}}" {{#unless editable}}disabled{{/unless}}></div>
        </div>
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Life.JobLevel"}}</span>
          <div class="fi">
            <select name="system.job.level" {{#unless editable}}disabled{{/unless}}>
              {{#each jobLevels as |level|}}
                <option value="{{level.key}}" {{#if level.selected}}selected{{/if}}>{{level.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Life.JobRisk"}}</span>
          <div class="fi"><input type="text" name="system.job.risk" value="{{system.job.risk}}" {{#unless editable}}disabled{{/unless}}></div>
        </div>
      </div>
      <div class="toolbar">
        <span style="font-size: 11px; color: var(--color-neutral-700)">
          {{#if derived.wealth.jobPay}}{{localize "GWORLD.Life.JobPays" amount=derived.wealth.jobPay}}{{else}}{{localize "GWORLD.Life.JobHint" amount=derived.wealth.averagePay}}{{/if}}
        </span>
        {{#if editable}}
          <button type="button" class="ibtn" data-action="workMonth">{{localize "GWORLD.Life.WorkMonth"}}</button>
        {{/if}}
      </div>
    {{/if}}
  </div>

</section>
