<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> "gworld.addonSheetSections" sections=addonSheetSections.start}}

  <div class="isec">
    <div class="ish"><span class="num">01</span>{{localize "GWORLD.Section.Maneuver"}}</div>
    <div class="g3">
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Maneuver"}}</span>
        <div class="fi">
          <select name="system.maneuver" {{#unless editable}}disabled{{/unless}}>
            {{#each maneuvers as |m|}}
              <option value="{{m.key}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      {{#if maneuverOptions.length}}
        {{!-- A module's maneuver that asks for a choice made with it. --}}
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Maneuver.Option"}}</span>
          <div class="fi">
            <select name="system.maneuverOption" {{#unless editable}}disabled{{/unless}}>
              {{#each maneuverOptions as |o|}}
                <option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      {{/if}}
      {{#if addonManeuverOptions.length}}
        {{!-- Options modules offer on this maneuver, and the responses a Wait
             holds ready. Not form fields: each choice is saved as it is made. --}}
        <div class="fld wide addon-maneuver-options">
          <span class="fl">{{localize "GWORLD.Maneuver.AddonOptions"}}</span>
          <div class="fi" style="display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center">
            {{#each addonManeuverOptions as |o|}}
              {{{o.control}}}
              {{#if o.response}}
                <button type="button" class="ibtn tiny" data-action="maneuverResponse" data-option-id="{{o.id}}"
                        {{#unless @root.editable}}disabled{{/unless}}>{{o.response}}</button>
              {{/if}}
              {{#if o.refused}}<span class="tag tag-danger">{{o.refused}}</span>{{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}
      {{#if attackSequence.shown}}
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Attack.SequenceLabel"}}</span>
          <div class="fi">{{attackSequence.made}} / {{attackSequence.count}}</div>
        </div>
      {{/if}}
      {{#if timedConditions.length}}
        <div class="fld wide">
          <span class="fl">{{localize "GWORLD.Condition.Timed"}}</span>
          <div class="fi" style="display: flex; flex-wrap: wrap; gap: 4px 8px">
            {{#each timedConditions as |c|}}
              <span class="tag tag-danger" data-tooltip="{{c.effects}}">{{c.label}}{{#if c.remaining}} &middot; {{c.remaining}}{{/if}}
                {{#if @root.editable}}<button type="button" class="iconbtn" data-action="removeTimedCondition" data-condition-id="{{c.id}}"
                        aria-label="{{localize 'GWORLD.Action.Delete'}}">&times;</button>{{/if}}
              </span>
            {{/each}}
          </div>
        </div>
      {{/if}}
      {{#if grappledCannotMove}}
        <p class="ihint warn">{{localize "GWORLD.Grapple.CannotMove"}}</p>
      {{/if}}
      {{#if isAllOutAttack}}
        {{!-- "You must specify one of these options before you attack" (p. 365). --}}
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Maneuver.Option"}}</span>
          <div class="fi">
            <select name="system.allOutAttackOption" {{#unless editable}}disabled{{/unless}}
                    data-tooltip="{{localize 'GWORLD.Maneuver.AllOutAttackOption.Hint'}}">
              {{#each aoaOptions as |o|}}
                <option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{localize o.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      {{/if}}
      {{#if isAllOutDefense}}
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Maneuver.Option"}}</span>
          <div class="fi">
            <select name="system.allOutDefenseOption" {{#unless editable}}disabled{{/unless}}>
              <option value="increased" {{#if aodIncreased}}selected{{/if}}>{{localize "GWORLD.Maneuver.Increased"}}</option>
              <option value="double" {{#unless aodIncreased}}selected{{/unless}}>{{localize "GWORLD.Maneuver.Double"}}</option>
            </select>
          </div>
        </div>
        {{#if aodIncreased}}
          <div class="fld">
            <span class="fl">{{localize "GWORLD.Maneuver.Target"}}</span>
            <div class="fi">
              <select name="system.allOutDefenseTarget" {{#unless editable}}disabled{{/unless}}>
                {{#each aodTargets as |t|}}
                  <option value="{{t.key}}" {{#if t.selected}}selected{{/if}}>{{localize t.label}}</option>
                {{/each}}
              </select>
            </div>
          </div>
        {{/if}}
      {{/if}}
      {{#if isAiming}}
        {{!-- Turns spent aiming, and bracing: Accuracy after one, +1 and +2
             for the next two, +1 braced. Each weapon adds its own Acc when
             the shot is taken; the figure here is what the turns are worth. --}}
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Field.AimTurns"}}</span>
          <div class="fi">
            <input type="number" name="system.aim.turns" value="{{system.aim.turns}}"
                   min="0" max="3" step="1"
                   style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                   {{#unless editable}}disabled{{/unless}}>
            <span style="font-size: 10px; color: var(--color-accent-700)">Acc {{signed derived.aim.extra}}</span>
          </div>
        </div>
        <label class="fld icheck">
          <input type="checkbox" name="system.aim.braced"
                 {{#if system.aim.braced}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
          <span>{{localize "GWORLD.Field.Braced"}}</span>
        </label>
      {{/if}}
      {{#if isEvaluating}}
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Field.EvaluateTurns"}}</span>
          <div class="fi">
            <input type="number" name="system.evaluateTurns" value="{{system.evaluateTurns}}"
                   min="0" step="1"
                   style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                   {{#unless editable}}disabled{{/unless}}>
            <span style="font-size: 10px; color: var(--color-accent-700)">{{signed derived.evaluateBonus}}</span>
          </div>
        </div>
      {{/if}}
      {{#if showOpportunityFire}}
        <div class="fld wide">
          <span class="fl">{{localize "GWORLD.Wait.Trigger"}}</span>
          <div class="fi">
            <input type="text" name="system.wait.trigger" value="{{system.wait.trigger}}"
                   placeholder="{{localize "GWORLD.Wait.TriggerHint"}}"
                   style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                   {{#unless editable}}disabled{{/unless}}>
          </div>
        </div>
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Wait.HexesWatched"}}</span>
          <div class="fi">
            <input type="number" name="system.wait.hexesWatched" value="{{system.wait.hexesWatched}}"
                   min="1" step="1"
                   style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                   {{#unless editable}}disabled{{/unless}}>
            <span style="font-size: 10px; color: var(--color-accent-700)">{{signed waitPenalty}}</span>
          </div>
        </div>
        <label class="fld icheck">
          <input type="checkbox" name="system.wait.coveringLine"
                 {{#if system.wait.coveringLine}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
          <span>{{localize "GWORLD.Wait.CoveringLine"}}</span>
        </label>
      {{/if}}
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Defenses"}}</span>
        <div class="fi">
          {{#if derived.maneuver.defenseAvailable}}
            <span>{{#if derived.maneuver.parryAvailable}}{{localize "GWORLD.Maneuver.AnyDefense"}}{{else}}{{localize "GWORLD.Maneuver.NoParry"}}{{/if}}</span>
          {{else}}
            <span class="bad">{{localize "GWORLD.Maneuver.NoDefense"}}</span>
          {{/if}}
        </div>
      </div>
    </div>
    <div class="istance">
      {{!-- The posture is chosen here as well as read here. It used to be a
           label only, and a character knocked down by a takedown had no way
           back up from the tab where the fight is run.

           Not a form field: the Attributes tab already has one named
           system.posture, and two fields of one name submit as a pair the
           schema refuses. This one writes the actor itself when changed. --}}
      <label class="ichip on iposture" data-tooltip="{{localize "GWORLD.Field.PostureHint"}}">
        <span class="ichip-label">{{localize "GWORLD.Field.Posture"}}</span>
        <select data-posture-select aria-label="{{localize "GWORLD.Field.Posture"}}"
                {{#unless editable}}disabled{{/unless}}>
          {{#each postures as |posture|}}
            <option value="{{posture.key}}" {{#if posture.selected}}selected{{/if}}>{{posture.label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if rules.bulletproofNudity}}
        {{!-- How much they are wearing, which is worth something to every
             active defense under Bulletproof Nudity (Campaigns p. 417). --}}
        <label class="ichip on" data-tooltip="{{localize 'GWORLD.Cinematic.DressHint'}}">
          <span class="ichip-label">{{localize "GWORLD.Cinematic.Dress"}}</span>
          <select name="system.dress.state" aria-label="{{localize 'GWORLD.Cinematic.Dress'}}"
                  {{#unless editable}}disabled{{/unless}}>
            {{#each dressStates as |d|}}
              <option value="{{d.key}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>
            {{/each}}
          </select>
        </label>
        <label class="ichip {{#if system.dress.topless}}on{{/if}}"
               data-tooltip="{{localize 'GWORLD.Cinematic.ToplessHint'}}">
          <input type="checkbox" name="system.dress.topless"
                 {{#if system.dress.topless}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
          <span class="ichip-label">{{localize "GWORLD.Cinematic.Topless"}}</span>
        </label>
      {{/if}}
      {{#each conditionChips as |chip|}}
        <button type="button" class="ichip {{#if chip.active}}on{{/if}}"
                data-action="toggleCondition" data-condition="{{chip.key}}">{{localize chip.label}}</button>
      {{/each}}
      {{#if derived.encumbrance.dodgePenalty}}
        <span class="ichip warn">
          {{localize (concat "GWORLD.Encumbrance." derived.encumbrance.key)}} {{derived.encumbrance.dodgePenalty}}
        </span>
      {{/if}}
      {{#if derived.reeling}}
        <span class="ichip warn">{{localize "GWORLD.Health.reeling"}}</span>
      {{/if}}
      {{#if (gt derived.attacksPerTurn 1)}}
        <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Attack.ExtraAttackHint'}}">
          {{localize "GWORLD.Attack.PerTurn" count=derived.attacksPerTurn}}
        </span>
      {{/if}}
      {{#if derived.extraArms}}
        <span class="ichip warn">{{localize "GWORLD.Attack.ExtraArms" count=derived.extraArms}}</span>
      {{/if}}
      {{#each derived.attackPenalties.melee as |p|}}
        <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Attack.ImpairedMelee'}}">{{p.trait}} {{signed p.value}}</span>
      {{/each}}
      {{#each derived.attackPenalties.ranged as |p|}}
        {{#unless (eq p.trait "Lame")}}
          <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Attack.ImpairedRanged'}}">{{p.trait}} {{signed p.value}}</span>
        {{/unless}}
      {{/each}}
      {{#if derived.vision.blindness}}
        <span class="ichip warn">{{localize "GWORLD.Sight.Blindness"}}</span>
      {{/if}}
      {{#if derived.legPenalty}}
        <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Attack.LameHint'}}">{{localize "GWORLD.Attack.Lame" penalty=derived.legPenalty}}</span>
      {{/if}}
      {{#if derived.armorNotes.layeringPenalty}}
        <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Armor.LayeringHint'}}">{{localize "GWORLD.Armor.Layering" penalty=derived.armorNotes.layeringPenalty}}</span>
      {{/if}}
      {{#if derived.armorNotes.illegalLayering}}
        <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Armor.IllegalLayerHint'}}">{{localize "GWORLD.Armor.IllegalLayer"}}</span>
      {{/if}}
      {{#if derived.armorNotes.noPeripheralVision}}
        <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Armor.NoPeripheralHint'}}">{{localize "GWORLD.Armor.NoPeripheral"}}</span>
      {{/if}}
      {{#if derived.armorNotes.frontOnly}}
        <span class="ichip" data-tooltip="{{localize 'GWORLD.Armor.FrontOnlyHint'}}">{{localize "GWORLD.Armor.FrontOnly"}}</span>
      {{/if}}
      {{#if derived.shieldBroken}}
        <span class="ichip warn" data-tooltip="{{localize 'GWORLD.Shield.BrokenHint'}}">{{localize "GWORLD.Shield.Broken"}}</span>
      {{/if}}
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">02</span>{{localize "GWORLD.Section.ActiveDefenses"}}</div>
    <div class="idefs">
      {{#each defenseCards as |def|}}
        <div class="idef blueprint">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          {{#if def.available}}
            <span class="iroll rollable" data-action="roll" data-roll-type="{{def.key}}"
                  data-roll-label="{{localize def.label}}" data-roll-target="{{def.total}}">
              {{> "gworld.die"}}
            </span>
          {{/if}}
          <span class="idl">{{localize def.label}}</span>
          <span class="idv">{{#if def.available}}{{def.total}}{{else}}&mdash;{{/if}}</span>
          <span class="idsrc">{{def.source}}</span>
          <span class="idmath">{{def.math}}</span>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">03</span>{{localize "GWORLD.Section.MeleeAttacks"}}</div>
    {{#if derived.melee.length}}
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Weapon"}}</th>
            <th class="n">{{localize "GWORLD.Column.Skill"}}</th>
            <th>{{localize "GWORLD.Column.Damage"}}</th>
            <th class="c">{{localize "GWORLD.Column.Reach"}}</th>
            <th class="c">{{localize "GWORLD.Secondary.Parry"}}</th>
            <th class="c">ST</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each derived.melee as |atk|}}
            <tr data-item-id="{{atk.itemId}}" data-mode-index="{{atk.modeIndex}}" data-derived-mode="{{atk.derivedMode}}" {{#if atk.atDefault}}class="dim"{{/if}}>
              <td>
                <span class="wname">{{atk.name}}</span> <span class="wmode">{{atk.mode}}</span>
                {{#if atk.atDefault}}<span class="tag" data-tooltip="{{localize 'GWORLD.Attack.AtDefaultHint'}}">{{localize "GWORLD.Skill.Untrained"}}</span>{{/if}}
                {{#if atk.unready}}<span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Ready.UnreadyHint'}}">{{localize "GWORLD.Ready.Unready"}}</span>
                {{else if atk.readiesAfterAttack}}<span class="tag" data-tooltip="{{localize 'GWORLD.Ready.AfterAttackHint'}}">&Dagger;</span>{{/if}}
                {{#if atk.minStPenalty}}<span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Breakage.MinStHint'}}">ST {{atk.minStPenalty}}</span>{{/if}}
                {{#if atk.hitModifier}}<span class="tag" data-tooltip="{{localize 'GWORLD.Attack.HitModifierHint'}}">{{localize "GWORLD.Attack.HitModifier" modifier=(signed atk.hitModifier)}}</span>{{/if}}
                {{#unless (eq atk.condition "sound")}}<span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Breakage.ConditionHint'}}">{{localize (concat "GWORLD.Breakage.Condition." atk.condition)}}</span>{{/unless}}
              </td>
              <td class="n">
                {{#if atk.skillLevel}}<span class="lvl">{{atk.skillLevel}}</span>{{else}}<span class="bad">&mdash;</span>{{/if}}
              </td>
              {{#if atk.affliction}}
                <td class="dmg rollable" data-action="affliction"
                    data-resist="{{atk.afflictionAttribute}}"
                    data-resist-modifier="{{atk.afflictionModifier}}"
                    data-affliction-label="{{atk.name}} {{atk.mode}}">
                  {{atk.afflictionAttribute}}{{atk.afflictionModifier}}
                  <span class="dt">{{localize "GWORLD.Affliction.Short"}}</span>
                </td>
              {{else}}
                <td class="dmg{{#if atk.damageRollable}} rollable{{/if}}"
                    {{#if atk.damageRollable}}data-action="rollDamage"
                    data-damage-formula="{{atk.damage}}" data-damage-type="{{atk.damageType}}"
                    data-damage-label="{{atk.name}} {{atk.mode}}" data-armor-divisor="{{atk.armorDivisor}}" data-material="{{atk.material}}"
                    data-explosive="{{#if atk.explosive}}1{{/if}}"
                    data-reach="{{atk.reach}}"
                    data-st-based="{{#if atk.stBased}}1{{/if}}" data-melee="1"
                    data-damage-base="{{atk.damageBase}}" data-damage-modifier="{{atk.damageModifier}}"
                    data-natural-key="{{atk.naturalKey}}" data-min-st="{{atk.minSt}}" data-unarmed-bonus-skill="{{atk.unarmedBonusSkill}}" data-weapon-master-per-die="{{atk.weaponMasterPerDie}}"
                    data-fragmentation="{{atk.fragmentation}}"{{/if}}>{{atk.damage}}
                  <span class="dt">{{atk.damageType}}</span>
                  {{> "gworld.attackExtras" atk=atk}}
                </td>
              {{/if}}
              <td class="c">{{atk.reach}}</td>
              <td class="c">{{#if atk.parry}}{{atk.parry}}{{else}}&mdash;{{/if}}</td>
              <td class="c">{{#if atk.minSt}}{{atk.minSt}}{{else}}&mdash;{{/if}}</td>
              <td class="c">
                {{#if atk.unready}}
                  {{!-- Swung and not yet back up: a Ready maneuver, not an attack. --}}
                  {{#if @root.editable}}
                    <button type="button" class="ibtn tiny" data-action="readyWeapon"
                            data-tooltip="{{localize 'GWORLD.Ready.Hint'}}">
                      {{localize "GWORLD.Ready.Action"}}
                    </button>
                  {{/if}}
                {{else if atk.skillLevel}}
                  {{#if atk.usable}}
                    <span class="rollable" data-action="roll" data-roll-type="attack" data-roll-skill="{{atk.skillName}}"
                          data-roll-label="{{atk.name}}" data-roll-target="{{atk.skillLevel}}"
                          data-hit-modifier="{{atk.hitModifier}}"
                          data-damage-type="{{atk.damageType}}"
                          data-unready-after="{{#if atk.readiesAfterAttack}}1{{/if}}"
                          data-weapon-weight="{{atk.weight}}" data-material="{{atk.material}}"
                          data-swung="{{#if atk.swung}}1{{/if}}" data-damage-base="{{atk.damageBase}}"
                          data-resists-breakage="{{#if atk.resistsBreakage}}1{{/if}}"
                          data-rapid-strike-halved="{{#if atk.rapidStrikeHalved}}1{{/if}}"
                          data-unarmed="{{#if atk.unarmed}}1{{/if}}">
                      {{> "gworld.die"}}
                    </span>
                    {{#if ../rules.feint}}
                      {{#unless (eq atk.feint false)}}
                        <button type="button" class="ibtn tiny" data-action="feint"
                                data-roll-label="{{atk.name}}" data-roll-target="{{atk.skillLevel}}"
                                data-tooltip="{{localize "GWORLD.Feint.Hint"}}">
                          {{localize "GWORLD.Feint.Action"}}
                        </button>
                      {{/unless}}
                    {{/if}}
                  {{else}}
                    <span class="bad" data-tooltip="{{localize "GWORLD.Melee.Unusable"}}">&mdash;</span>
                  {{/if}}
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{/if}}
  </div>

  {{#if derived.ranged.length}}
    <div class="isec">
      <div class="ish"><span class="num">04</span>{{localize "GWORLD.Section.RangedAttacks"}}</div>
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Weapon"}}</th>
            <th class="n">{{localize "GWORLD.Column.Skill"}}</th>
            <th>{{localize "GWORLD.Column.Damage"}}</th>
            <th class="c">{{localize "GWORLD.Column.Acc"}}</th>
            <th class="c">{{localize "GWORLD.Column.Range"}}</th>
            <th class="c">{{localize "GWORLD.Column.RoF"}}</th>
            <th class="c">{{localize "GWORLD.Column.Shots"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each derived.ranged as |atk|}}
            <tr data-item-id="{{atk.itemId}}" data-mode-index="{{atk.modeIndex}}" data-derived-mode="{{atk.derivedMode}}" data-ranged="1" {{#if atk.atDefault}}class="dim"{{/if}}>
              <td>
                <span class="wname">{{atk.name}}</span> <span class="wmode">{{atk.mode}}</span>
                {{#if atk.atDefault}}<span class="tag" data-tooltip="{{localize 'GWORLD.Attack.AtDefaultHint'}}">{{localize "GWORLD.Skill.Untrained"}}</span>{{/if}}
              </td>
              <td class="n">
                {{#if atk.skillLevel}}<span class="lvl">{{atk.skillLevel}}</span>{{else}}<span class="bad">&mdash;</span>{{/if}}
              </td>
              {{#if atk.affliction}}
                <td class="dmg rollable" data-action="affliction"
                    data-resist="{{atk.afflictionAttribute}}"
                    data-resist-modifier="{{atk.afflictionModifier}}"
                    data-half-damage-range="{{atk.halfDamageRange}}"
                    data-affliction-label="{{atk.name}} {{atk.mode}}">
                  {{atk.afflictionAttribute}}{{atk.afflictionModifier}}
                  <span class="dt">{{localize "GWORLD.Affliction.Short"}}</span>
                </td>
              {{else}}
                <td class="dmg{{#if atk.damageRollable}} rollable{{/if}}"
                    {{#if atk.damageRollable}}data-action="rollDamage"
                    data-damage-formula="{{atk.damage}}" data-damage-type="{{atk.damageType}}"
                    data-damage-label="{{atk.name}} {{atk.mode}}" data-armor-divisor="{{atk.armorDivisor}}" data-material="{{atk.material}}"
                    data-explosive="{{#if atk.explosive}}1{{/if}}"
                    data-ignores-dr="{{#if atk.ignoresDr}}1{{/if}}"
                    data-st-based="{{#if atk.stBased}}1{{/if}}"
                    data-fragmentation="{{atk.fragmentation}}"{{/if}}>{{atk.damage}}
                  <span class="dt">{{atk.damageType}}</span>
                  {{#if atk.ignoresDr}}<span class="tag" data-tooltip="{{localize 'GWORLD.Malediction.IgnoresDrHint'}}">{{localize "GWORLD.Malediction.IgnoresDr"}}</span>{{/if}}
                  {{> "gworld.attackExtras" atk=atk}}
                </td>
              {{/if}}
              {{#if atk.malediction}}
                <td class="c">&mdash;</td>
                <td class="c" data-tooltip="{{localize 'GWORLD.Malediction.RangeHint'}}">{{localize "GWORLD.Malediction.Short" level=atk.malediction}}</td>
              {{else}}
                <td class="c">{{atk.accuracy}}</td>
                <td class="c">{{atk.range}}</td>
              {{/if}}
              <td class="c">{{atk.rateOfFire}}{{#if (gt atk.projectiles 1)}}&times;{{atk.projectiles}}{{/if}}</td>
              <td class="c">
                {{#if atk.shotsCapacity}}
                  <span data-tooltip="{{atk.shots}}">{{atk.shotsLoaded}}/{{atk.shotsCapacity}}</span>
                  {{#if atk.reloadable}}
                    {{#if @root.editable}}
                      <button type="button" class="ibtn tiny" data-action="reloadWeapon" data-mode-index="{{atk.modeIndex}}"
                              data-tooltip="{{#if atk.reloadSeconds}}{{localize 'GWORLD.Reload.Hint' seconds=atk.reloadSeconds}}{{else}}{{localize 'GWORLD.Reload.HintNoTime'}}{{/if}}">
                        {{localize "GWORLD.Reload.Action"}}
                      </button>
                    {{/if}}
                  {{/if}}
                {{else}}
                  {{atk.shots}}
                {{/if}}
              </td>
              <td class="c">
                {{#if atk.empty}}
                  <span class="bad" data-tooltip="{{localize 'GWORLD.Reload.EmptyHint'}}">{{localize "GWORLD.Reload.EmptyShort"}}</span>
                {{else if atk.skillLevel}}
                  <span class="rollable" data-action="roll" data-roll-type="attack" data-roll-skill="{{atk.skillName}}"
                        data-tooltip="{{localize 'GWORLD.Ranged.QuickShotHint'}}"
                        data-mode-index="{{atk.modeIndex}}"
                        data-loaded="{{#if atk.shotsCapacity}}{{atk.shotsLoaded}}{{/if}}"
                        data-roll-label="{{atk.name}}" data-roll-target="{{atk.skillLevel}}"
                        data-damage-type="{{atk.damageType}}"
                        data-ranged="1" data-thrown="{{#if atk.thrown}}1{{/if}}"
                        data-malediction="{{atk.malediction}}"
                        data-resist-with="{{#if atk.affliction}}{{atk.afflictionAttribute}}{{/if}}"
                        data-accuracy="{{atk.accuracy}}"
                        data-scope-bonus="{{atk.scopeBonus}}"
                        data-rate-of-fire="{{atk.rateOfFire}}" data-recoil="{{atk.recoil}}"
                        data-projectiles="{{atk.projectiles}}" data-half-damage-range="{{atk.halfDamageRange}}"
                        data-max-range="{{atk.maxRange}}" data-guidance="{{atk.guidance}}"
                        data-area-attack="{{#if atk.areaAttack}}1{{/if}}" data-cone-max-width="{{atk.coneMaxWidth}}"
                        data-weapon-weight="{{atk.weight}}" data-material="{{atk.material}}"
                        data-resists-breakage="{{#if atk.resistsBreakage}}1{{/if}}"
                        data-bulk="{{atk.bulk}}" data-malfunction="{{atk.malfunction}}">
                    {{> "gworld.die"}}
                  </span>
                  {{#if (and @root.rules.feint atk.feint)}}
                    <button type="button" class="ibtn tiny" data-action="feint"
                            data-roll-label="{{atk.name}}" data-roll-target="{{atk.skillLevel}}"
                            data-tooltip="{{localize "GWORLD.Feint.Hint"}}">
                      {{localize "GWORLD.Feint.Action"}}
                    </button>
                  {{/if}}
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  <div class="isec">
    <div class="ish"><span class="num">05</span>{{localize "GWORLD.Section.Actions"}}</div>
    <div class="toolbar">
      {{#if rules.slams}}
        <button type="button" class="ibtn" data-action="slam">
          {{localize "GWORLD.Slam.Action"}}
        </button>
        <button type="button" class="ibtn" data-action="shove">
          {{localize "GWORLD.Slam.ShoveAction"}}
        </button>
      {{/if}}
      {{#if rules.evading}}
        <button type="button" class="ibtn" data-action="evade">
          {{localize "GWORLD.Evade.Action"}}
        </button>
      {{/if}}
      {{#if rules.trampling}}
        <button type="button" class="ibtn" data-action="trample"
                data-tooltip="{{localize "GWORLD.Trample.Hint"}}">
          {{localize "GWORLD.Trample.Action"}}
        </button>
      {{/if}}
      {{#if rules.swarms}}
        <button type="button" class="ibtn" data-action="fightOffSwarm"
                data-tooltip="{{localize "GWORLD.Swarm.FightOffHint"}}">
          {{localize "GWORLD.Swarm.FightOff"}}
        </button>
      {{/if}}
      <button type="button" class="ibtn" data-action="contest"
              data-tooltip="{{localize "GWORLD.Contest.Hint"}}">
        {{localize "GWORLD.Contest.Action"}}
      </button>
      <button type="button" class="ibtn" data-action="fall"
              data-tooltip="{{localize "GWORLD.Fall.Hint"}}">
        {{localize "GWORLD.Fall.Action"}}
      </button>
      {{#if system.conditions.stunned}}
        <button type="button" class="ibtn" data-action="shakeOffStun"
                data-tooltip="{{localize "GWORLD.Knockdown.ShakeHint"}}">
          {{localize "GWORLD.Knockdown.Shake"}}
        </button>
      {{/if}}
      {{#if rules.frightChecks}}
        <button type="button" class="ibtn" data-action="frightCheck"
                data-tooltip="{{localize "GWORLD.Fright.Hint"}}">
          {{localize "GWORLD.Fright.Action"}}
        </button>
      {{/if}}
      {{#if rules.extraEffort}}
        <button type="button" class="ibtn" data-action="extraEffort"
                data-tooltip="{{localize "GWORLD.ExtraEffort.Hint"}}">
          {{localize "GWORLD.ExtraEffort.Action"}}
        </button>
      {{/if}}
      {{#if rules.grappling}}
        {{!-- A fighter with a hand free can take hold of another foe. --}}
        <button type="button" class="ibtn" data-action="grapple"
                data-tooltip="{{localize "GWORLD.Grapple.Hint"}}">
          {{localize "GWORLD.Grapple.Action"}}
        </button>
      {{/if}}
      <button type="button" class="ibtn" data-action="disarm"
              data-tooltip="{{localize "GWORLD.Disarm.Hint"}}">
        {{localize "GWORLD.Disarm.Action"}}
      </button>
      {{#if rules.dirtyTricks}}
        <button type="button" class="ibtn" data-action="splash"
                data-tooltip="{{localize "GWORLD.Splash.Hint"}}">
          {{localize "GWORLD.Splash.Action"}}
        </button>
      {{/if}}
      {{#if rules.scatter}}
        <button type="button" class="ibtn" data-action="scatter"
                data-tooltip="{{localize "GWORLD.Scatter.Hint"}}">
          {{localize "GWORLD.Scatter.Action"}}
        </button>
      {{/if}}
      {{#if rules.mountedCombat}}
        <button type="button" class="ibtn{{#if system.mounted}} on{{/if}}" data-action="toggleMounted"
                data-tooltip="{{localize "GWORLD.Mounted.Hint"}}">
          {{localize "GWORLD.Mounted.Action"}}
        </button>
        {{#if system.mounted}}
          <button type="button" class="ibtn" data-action="stayOn"
                  data-tooltip="{{localize "GWORLD.Mounted.StayOnHint"}}">
            {{localize "GWORLD.Mounted.StayOnAction"}}
          </button>
        {{/if}}
      {{/if}}
      {{#if rules.highSpeed}}
        <button type="button" class="ibtn" data-action="flying">{{localize "GWORLD.Mounted.Flying"}}</button>
        <button type="button" class="ibtn" data-action="pushEnvelope"
                data-tooltip="{{localize "GWORLD.Mounted.EnvelopeHint"}}">
          {{localize "GWORLD.Mounted.EnvelopeAction"}}
        </button>
      {{/if}}
      <button type="button" class="ibtn" data-action="attributePenalties"
              data-tooltip="{{localize "GWORLD.Penalties.Hint"}}">
        {{localize "GWORLD.Penalties.Action"}}{{#if penaltiesShowing}} &middot; {{penaltiesShowing}}{{/if}}
      </button>
      {{#if rules.reactions}}
        <button type="button" class="ibtn" data-action="reaction"
                data-tooltip="{{localize "GWORLD.Reaction.Hint"}}">
          {{localize "GWORLD.Reaction.Action"}}
        </button>
        <button type="button" class="ibtn" data-action="influence"
                data-tooltip="{{localize "GWORLD.Reaction.InfluenceHint"}}">
          {{localize "GWORLD.Reaction.InfluenceAction"}}
        </button>
      {{/if}}
      <button type="button" class="ibtn" data-action="hearTheShot"
              data-tooltip="{{localize "GWORLD.Hearing.Hint"}}">
        {{localize "GWORLD.Hearing.Title"}}
      </button>
      {{#if rules.overpenetration}}
        <button type="button" class="ibtn" data-action="overpenetration"
                data-tooltip="{{localize "GWORLD.Overpenetration.Hint"}}">
          {{localize "GWORLD.Overpenetration.Action"}}
        </button>
      {{/if}}
    </div>

    {{!-- A grapple changes what this character can do more than anything else
          in a fight, so what it allows is shown rather than remembered. One
          panel for each: a fighter can hold one foe while another holds him. --}}
    {{#each grapples as |grapple|}}
      <div class="toolbar" data-grapple-foe="{{grapple.foe}}">
        {{#if grapple.foeName}}<span class="ihint">{{grapple.foeName}}</span>{{/if}}
        {{#if grapple.holding}}
          <button type="button" class="ibtn" data-action="takedown"
                  data-tooltip="{{localize "GWORLD.Grapple.TakedownHint"}}">
            {{localize "GWORLD.Grapple.Takedown"}}
          </button>
          {{#unless grapple.pinned}}
            <button type="button" class="ibtn" data-action="pin"
                    data-tooltip="{{localize "GWORLD.Grapple.PinHint"}}">
              {{localize "GWORLD.Grapple.Pin"}}
            </button>
          {{/unless}}
          <button type="button" class="ibtn" data-action="choke"
                  data-tooltip="{{localize "GWORLD.Grapple.ChokeHint"}}">
            {{localize "GWORLD.Grapple.Choke"}}
          </button>
          <button type="button" class="ibtn" data-action="releaseGrapple">
            {{localize "GWORLD.Grapple.Release"}}
          </button>
        {{else}}
          <button type="button" class="ibtn" data-action="breakFree"
                  data-tooltip="{{localize "GWORLD.Grapple.BreakFreeHint"}}">
            {{localize "GWORLD.Grapple.BreakFree"}}
          </button>
          <button type="button" class="ibtn" data-action="takedown"
                  data-tooltip="{{localize "GWORLD.Grapple.TakedownHint"}}">
            {{localize "GWORLD.Grapple.Takedown"}}
          </button>
        {{/if}}
        {{!-- What modules add to a grapple, for whichever end of it this is. --}}
        {{#each grapple.actions as |a|}}
          <button type="button" class="ibtn" data-action="grappleAction" data-grapple-action="{{a.id}}">{{a.label}}</button>
        {{/each}}
      </div>
      <p class="ihint">
        {{#if grapple.pinned}}
          {{localize "GWORLD.Grapple.StatePinned"}}
        {{else if grapple.holding}}
          {{localize "GWORLD.Grapple.StateHolding" hands=grapple.hands}}
        {{else}}
          {{localize "GWORLD.Grapple.StateHeld" hands=grapple.hands}}
        {{/if}}
      </p>
    {{/each}}
  </div>

  {{#if tactical}}
    <div class="isec">
      <div class="ish"><span class="num">06</span>{{localize "GWORLD.Section.Movement"}}</div>
      <div class="ifields">
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Tactical.MovementPoints"}}</span>
          <div class="fi">{{tactical.points}}</div>
        </div>
        <label class="fld">
          <span class="fl">{{localize "GWORLD.Tactical.Handedness"}}</span>
          <div class="fi">
            <select name="system.handedness" {{#unless editable}}disabled{{/unless}}>
              {{#each hands as |hand|}}
                <option value="{{hand.key}}" {{#if hand.selected}}selected{{/if}}>{{hand.label}}</option>
              {{/each}}
            </select>
          </div>
        </label>
      </div>
      {{#if tactical.immobile}}
        <p class="ihint">{{localize "GWORLD.Tactical.Immobile"}}</p>
      {{else}}
        <div class="gc-mods">
          <span>{{localize "GWORLD.Tactical.Forward"}} {{tactical.forward}}</span>
          <span>{{localize "GWORLD.Tactical.Sideways"}} {{tactical.sideways}}</span>
          <span>{{localize "GWORLD.Tactical.Backward"}} {{tactical.backward}}</span>
        </div>
        <div class="gc-mods">
          <span class="gc-mod">{{localize "GWORLD.Tactical.TurnCosts" sixty=(lookup tactical.turnCosts 0) oneTwenty=(lookup tactical.turnCosts 1) about=(lookup tactical.turnCosts 2)}}</span>
        </div>
        <p class="ihint">{{localize "GWORLD.Tactical.MovementHint"}}</p>
      {{/if}}
    </div>
  {{/if}}

  {{> "gworld.addonSections"}}

</section>
