<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{!-- What the character's magic rests on: the Magery the traits give, and
       which of the book's two ways of learning spells their points are read
       by. The style is a select on the sheet itself because a character who
       has both kinds of Magery has to be able to say which they mean. --}}
  <div class="isec">
    <div class="ish"><span class="num">01</span>{{localize "GWORLD.Section.Magery"}}</div>
    <div class="npcline" style="gap: 14px; align-items: center">
      <span>
        <strong>{{magic.mageryLabel}}</strong>
        {{#if magic.magicResistance}}
          <span class="tag tag-accent">{{localize "GWORLD.Spell.MagicResistance"}} {{magic.magicResistance}}</span>
        {{/if}}
      </span>
      <label style="display: inline-flex; gap: 6px; align-items: center">
        <span class="fl">{{localize "GWORLD.Spell.Style"}}</span>
        <select name="system.magic.style" {{#unless editable}}disabled{{/unless}}>
          {{#each magic.styleOptions as |option|}}
            <option value="{{option.key}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
          {{/each}}
        </select>
      </label>
      <span class="sub">{{magic.styleHint}}</span>
    </div>
    {{!-- Where the magic is being done: the mana here, and the roll to keep
         casting through a distraction. The mana is the GM's to change. --}}
    <div class="npcline" style="gap: 14px; align-items: center">
      {{#if magic.mana.inPlay}}
        <span>
          <span class="fl">{{localize "GWORLD.Mana.Here"}}</span>
          <strong>{{magic.mana.label}}</strong>
          {{#if magic.mana.fromScene}}<span class="tag">{{localize "GWORLD.Mana.SceneTag"}}</span>{{/if}}
          {{#if @root.isGM}}
            <button type="button" class="ibtn" data-action="changeMana">{{localize "GWORLD.Mana.Change"}}</button>
          {{/if}}
        </span>
      {{/if}}
      {{#if @root.rules.spellDistraction}}
        <button type="button" class="ibtn" data-action="keepConcentration"
                data-tooltip="{{localize 'GWORLD.Cast.KeepConcentrationHint'}}">
          {{> "gworld.die"}} {{localize "GWORLD.Cast.KeepConcentration"}}
        </button>
      {{/if}}
    </div>
  </div>

  {{!-- A spell in the hand (Characters pp. 240-241): a Missile to enlarge or
       throw, a Melee charge to strike with. Nothing else can be cast until
       it is used or let go. --}}
  {{#if magic.held}}
    <div class="isec">
      <div class="grph">
        {{localize "GWORLD.Held.InHand"}}
        <span class="sub">{{magic.held.kind}}</span>
      </div>
      <div class="npcline" style="gap: 10px; align-items: center; flex-wrap: wrap">
        <strong>{{magic.held.name}}</strong>
        <span class="tag">{{magic.held.energy}} {{localize "GWORLD.Held.Energy"}}</span>
        {{#if magic.held.damage}}<span class="tag tag-accent">{{magic.held.damage}} {{magic.held.damageType}}</span>{{/if}}
        {{#if magic.held.missile}}<span class="tag">{{magic.held.seconds}}/3 {{localize "GWORLD.Held.Seconds"}}</span>{{/if}}
        {{#if @root.editable}}
          {{#if magic.held.canEnlarge}}
            <button type="button" class="ibtn" data-action="enlargeMissile"
                    data-tooltip="{{localize 'GWORLD.Held.EnlargeHint'}}">{{localize "GWORLD.Held.Enlarge"}}</button>
          {{/if}}
          {{#if magic.held.missile}}
            <button type="button" class="ibtn" data-action="throwMissile"
                    data-tooltip="{{localize 'GWORLD.Held.ThrowHint'}}">{{> "gworld.die"}} {{localize "GWORLD.Held.Throw"}}</button>
            <button type="button" class="ibtn" data-action="heldInjury"
                    data-tooltip="{{localize 'GWORLD.Held.InjuredHint'}}">{{localize "GWORLD.Held.Injured"}}</button>
          {{else}}
            <button type="button" class="ibtn" data-action="strikeMelee"
                    data-tooltip="{{localize 'GWORLD.Held.StrikeHint'}}">{{> "gworld.die"}} {{localize "GWORLD.Held.Strike"}}</button>
          {{/if}}
          <button type="button" class="ibtn" data-action="dissipateSpell"
                  data-tooltip="{{localize 'GWORLD.Held.DissipateHint'}}">{{localize "GWORLD.Held.Dissipate"}}</button>
        {{/if}}
      </div>
    </div>
  {{/if}}

  {{!-- Magic items carried (Campaigns pp. 480-482): what each enchantment
       does here, the spells it carries at its Power, and a Use for each the
       user can cast. --}}
  {{#if magic.items.length}}
    <div class="isec" style="gap: 0">
      <div class="grph">
        {{localize "GWORLD.Enchant.Items"}}
        <span class="sub">{{localize "GWORLD.Enchant.ItemsHint"}}</span>
      </div>
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Item"}}</th>
            <th>{{localize "GWORLD.Enchant.Effects"}}</th>
            <th>{{localize "GWORLD.Enchant.Spells"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each magic.items as |entry|}}
            <tr data-item-id="{{entry.itemId}}" {{#unless entry.equipped}}class="dim"{{/unless}}>
              <td>
                <span class="wname" data-action="editItem">{{entry.name}}</span>
                {{#unless entry.equipped}}<span class="tag">{{localize "GWORLD.Item.Stowed"}}</span>{{/unless}}
              </td>
              <td>
                {{#each entry.effects as |effect|}}<span class="tag tag-accent">{{effect}}</span> {{/each}}
              </td>
              <td>
                {{#each entry.magic.spells as |spell|}}
                  <span class="npcline" style="gap: 6px; align-items: center">
                    <span>{{spell.spell}} <b>{{spell.powerHere}}</b></span>
                    {{#if spell.alwaysOn}}<span class="tag">{{localize "GWORLD.Enchant.AlwaysOnTag"}}</span>{{/if}}
                    {{#if spell.mageOnly}}<span class="tag">{{localize "GWORLD.Enchant.MageOnly"}}</span>{{/if}}
                    {{#unless spell.works}}<span class="tag tag-danger">{{localize "GWORLD.Enchant.NotWorking"}}</span>{{/unless}}
                    {{#if @root.editable}}{{#if spell.works}}{{#unless spell.alwaysOn}}
                      <span class="rollable" data-action="castFromItem" data-enchantment-index="{{spell.index}}"
                            data-tooltip="{{localize 'GWORLD.Enchant.Use'}}">{{> "gworld.die"}}</span>
                    {{/unless}}{{/if}}{{/if}}
                  </span>
                {{/each}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  {{!-- Spells still running (Characters pp. 237-238): each with what is
       left of its duration, what keeping it up costs, and whether it is
       being concentrated on, which is what the next casting pays for. --}}
  {{#if magic.active.length}}
    <div class="isec" style="gap: 0">
      <div class="grph">
        {{localize "GWORLD.Cast.Running"}}
        <span class="sub">{{localize "GWORLD.Cast.RunningHint"}}</span>
      </div>
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Spell"}}</th>
            <th>{{localize "GWORLD.Cast.Remaining"}}</th>
            <th class="n">{{localize "GWORLD.Cast.MaintainCost"}}</th>
            <th></th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each magic.active as |spell|}}
            <tr data-spell-id="{{spell.id}}" {{#if spell.expired}}class="dim"{{/if}}>
              <td>
                <span class="wname">{{spell.name}}</span>
                {{#if spell.concentrating}}<span class="tag tag-accent">{{localize "GWORLD.Cast.Concentrating"}}</span>{{/if}}
              </td>
              <td class="wmode">{{spell.remaining}}</td>
              <td class="n wmode">{{#if spell.canMaintain}}{{spell.maintainCost}}{{else}}&mdash;{{/if}}</td>
              <td class="c">
                {{#if @root.editable}}{{#if spell.canMaintain}}
                  <button type="button" class="ibtn" data-action="maintainSpell">{{localize "GWORLD.Cast.MaintainAction"}}</button>
                {{/if}}{{/if}}
              </td>
              <td class="c">
                {{#if @root.editable}}
                  <button type="button" class="ibtn" data-action="toggleConcentrating"
                          data-tooltip="{{localize 'GWORLD.Cast.ConcentratingHint'}}">
                    {{#if spell.concentrating}}{{localize "GWORLD.Cast.StopConcentrating"}}{{else}}{{localize "GWORLD.Cast.Concentrate"}}{{/if}}
                  </button>
                {{/if}}
              </td>
              <td class="c">
                {{#if @root.editable}}
                  <button type="button" class="rollable iconbtn" data-action="dropSpell"
                          title="{{#if spell.expired}}{{localize 'GWORLD.Cast.Drop'}}{{else}}{{localize 'GWORLD.Cast.Cancel'}}{{/if}}">
                    {{> "gworld.trash"}}
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  <div class="toolbar">
    <div class="srch">
      {{> "gworld.search"}}
      <input type="search" class="gworld-spell-filter" placeholder="{{localize 'GWORLD.Action.FilterSpells'}}"
             autocomplete="off" data-tooltip="{{localize 'GWORLD.Action.FilterSpells'}}">
    </div>
    {{#if editable}}
      <button type="button" class="ibtn" data-action="createItem" data-item-type="spell">
        {{> "gworld.plus"}} {{localize "GWORLD.Action.AddSpell"}}
      </button>
      <button type="button" class="ibtn" data-action="browseCompendium"
              data-item-types="spell" data-browse-title="GWORLD.Picker.Spells">
        {{> "gworld.search"}} {{localize "GWORLD.Action.BrowseSpells"}}
      </button>
      {{#if magic.canEnchant}}
        <button type="button" class="ibtn" data-action="enchantItem"
                data-tooltip="{{localize 'GWORLD.Enchant.ButtonHint'}}">
          {{> "gworld.die"}} {{localize "GWORLD.Enchant.Button"}}
        </button>
      {{/if}}
    {{/if}}
  </div>

  {{#each magic.groups as |group|}}
    <div class="isec" style="gap: 0">
      <div class="grph">
        {{#if group.college}}{{group.college}}{{else}}{{localize "GWORLD.Spell.NoCollege"}}{{/if}}
        <span class="sub">{{localize "GWORLD.Spell.College"}}</span>
      </div>
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Spell"}}</th>
            <th>{{localize "GWORLD.Column.Class"}}</th>
            <th>{{localize "GWORLD.Column.Energy"}}</th>
            <th>{{localize "GWORLD.Column.Time"}}</th>
            <th>{{localize "GWORLD.Column.Duration"}}</th>
            <th class="n">{{localize "GWORLD.Column.Pts"}}</th>
            <th class="n">{{localize "GWORLD.Column.Relative"}}</th>
            <th class="n">{{localize "GWORLD.Column.Level"}}</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each group.rows as |row|}}
            {{#with row.spell.item as |spell|}}
            <tr data-item-id="{{spell.id}}" {{#unless row.known}}class="dim"{{/unless}}>
              <td>
                <span class="wname" data-action="editItem">{{spell.name}}</span>
                {{#if row.veryHard}}<span class="wmode">(VH)</span>{{/if}}
                {{#each row.otherColleges as |college|}}
                  <span class="tag">{{college}}</span>
                {{/each}}
                {{#if row.resisted}}
                  <span class="tag" data-tooltip="{{localize 'GWORLD.Spell.ResistedHint'}}">{{localize "GWORLD.Spell.Resisted"}} {{row.resisted}}</span>
                {{/if}}
                {{#if row.mageryRequired}}
                  <span class="tag">{{localize "GWORLD.Spell.Magery"}} {{row.mageryRequired}}</span>
                {{/if}}
                {{#if row.needsMagery}}
                  <span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Spell.NeedsMageryHint'}}">{{localize "GWORLD.Spell.NeedsMagery"}}</span>
                {{/if}}
                {{#if row.missing.length}}
                  <span class="tag tag-danger" data-tooltip="{{row.missingText}}">{{localize "GWORLD.Spell.Prerequisites"}}</span>
                {{/if}}
                {{#if row.cappedByCollege}}
                  <span class="tag" data-tooltip="{{localize 'GWORLD.Spell.CappedHint'}}">{{localize "GWORLD.Spell.Capped"}}</span>
                {{/if}}
                {{#if row.noCollegeSkill}}
                  <span class="tag tag-danger" data-tooltip="{{localize 'GWORLD.Spell.NoCollegeSkillHint'}}">{{localize "GWORLD.Spell.NoCollegeSkill"}}</span>
                {{/if}}
              </td>
              <td class="wmode">{{row.classes}}</td>
              <td class="wmode">{{row.energy}}</td>
              <td class="wmode">{{row.time}}</td>
              <td class="wmode">{{row.duration}}</td>
              <td class="n">
                {{#if @root.editable}}
                  <span class="ptstep">
                    <button type="button" data-action="stepPoints" data-step="down"
                            id="{{@root.sheetId}}-{{spell.id}}-down"
                            aria-label="{{localize "GWORLD.Skill.SpendLess"}}"
                            title="{{localize "GWORLD.Skill.SpendLess"}}">&minus;</button>
                    <input type="number" class="npts" min="0" step="1"
                           id="{{@root.sheetId}}-{{spell.id}}-pts"
                           value="{{spell.system.points}}" data-item-field="system.points"
                           aria-label="{{localize "GWORLD.Column.Pts"}}" />
                    <button type="button" data-action="stepPoints" data-step="up"
                            id="{{@root.sheetId}}-{{spell.id}}-up"
                            aria-label="{{localize "GWORLD.Skill.SpendMore"}}"
                            title="{{localize "GWORLD.Skill.SpendMore"}}">+</button>
                  </span>
                {{else}}{{#if row.known}}{{spell.system.points}}{{else}}&mdash;{{/if}}{{/if}}
              </td>
              <td class="n wmode">{{row.relative}}</td>
              <td class="n">
                {{#if row.rollable}}
                  <span class="lvl">{{spell.system.derived.level}}</span>
                {{else}}
                  <span class="tag tag-danger">{{localize "GWORLD.Spell.NotKnown"}}</span>
                {{/if}}
              </td>
              <td class="c">
                {{#if row.rollable}}
                  <span class="rollable" data-action="castSpell" data-tooltip="{{localize 'GWORLD.Cast.Title'}}">
                    {{> "gworld.die"}}
                  </span>
                {{/if}}
              </td>
              <td class="c">
                {{#if @root.editable}}
                  <button type="button" class="rollable iconbtn" data-action="deleteItem" title="{{localize 'GWORLD.Action.Delete'}}">
                    {{> "gworld.trash"}}
                  </button>
                {{/if}}
              </td>
            </tr>
            {{/with}}
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="ihint">{{localize "GWORLD.Spell.NoneYet"}}</p>
  {{/each}}

  <div class="npcline" style="justify-content: space-between; color: var(--color-neutral-700)">
    <span>{{magic.count}} {{localize "GWORLD.Spell.Known"}}</span>
    <span>{{derived.points.spells}} {{localize "GWORLD.Points.PointsLabel"}}</span>
  </div>

</section>
