{{!-- The party's header: who they are, the tab being read, how many are in it
     and the campaign's terms. Shown on every tab. --}}
<header class="v2-header">
  <div class="v2-portrait">
    <img src="{{img}}" alt="{{actor.name}}" data-edit="img"
         {{#if editable}}data-action="editImage" class="rollable"{{/if}}>
  </div>

  <div class="v2-identity">
    <div class="v2-eyebrow">
      <span>{{localize "GWORLD.Party.Eyebrow"}}</span>
      <span aria-hidden="true">&mdash;</span>
      <input class="v2-name" type="text" name="name" value="{{actor.name}}" aria-label="{{localize 'GWORLD.Party.Name'}}"
             {{#unless editable}}disabled{{/unless}}>
    </div>
    <h1 class="v2-title" data-v2-tab-title>{{localize tabLabel}}</h1>
    <div class="v2-meta">
      <span>{{countLabel}}</span>
      {{#each terms as |term|}}<span>{{term.label}} {{term.value}}</span>{{/each}}
    </div>
  </div>

  <div class="v2-header-side">
    {{#if editable}}
      <button type="button" class="v2-button v2-build-button" data-action="addMembers"
              data-tooltip="{{localize "GWORLD.Party.AddMembersHint"}}">{{> "gworld.plus"}} {{localize "GWORLD.Party.AddMembers"}}</button>
    {{/if}}
  </div>
</header>
