{{!-- The NPC sheet: one pane, no tabs. Everything a GM needs mid-combat.

     It wears the character sheet's frame and components (sheet-v2.css): a dark
     header, cream panels on the dark ground, the same attack cards and badges.

     One root element, because the sheet is a single Handlebars part and
     Foundry refuses to render a part that comes back as two: the header and
     the body used to sit side by side at the top level, and the sheet never
     opened. --}}
<div class="v2-npc">
<header class="v2-header v2-npc-header">
  <div class="v2-portrait">
    <img src="{{#if actor.img}}{{actor.img}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="{{actor.name}}">
  </div>

  <div class="v2-identity">
    <div class="v2-eyebrow">
      <span>{{localize "GWORLD.SheetV2.Npc"}}</span>
      {{#if groupSizeLabel}}<span aria-hidden="true">&mdash;</span><span>{{groupSizeLabel}}</span>{{/if}}
    </div>
    <input class="v2-name v2-npc-name" type="text" name="name" value="{{actor.name}}"
           aria-label="{{localize 'GWORLD.SheetV2.Name'}}" {{#unless editable}}disabled{{/unless}}>
    <div class="v2-meta"><span>TL {{system.tl}}</span></div>
  </div>

  {{#if editable}}
    <div class="v2-header-side">
      <button type="button" class="v2-button v2-build-button" data-action="openFullSheet"
              data-tooltip="{{localize "GWORLD.Npc.EditHint"}}">{{> "gworld.v2icon.build"}} {{localize "GWORLD.Npc.Edit"}}</button>
    </div>
  {{/if}}
</header>

<div class="v2-npc-body">

  {{!-- What is left of it, and the scores it rolls against. --}}
  <div class="v2-panel v2-npc-vitals">
    <div class="v2-npc-pools">
      <div class="v2-pool">
        <div class="v2-pool-head">
          <span class="v2-pool-name">{{localize "GWORLD.Secondary.HP"}}</span>
          <span class="v2-pool-value">{{system.hp.value}} <span class="v2-muted">/ {{system.hp.max}}</span></span>
        </div>
        <div class="v2-bar v2-bar-hp"><span style="width: {{percent system.hp.value system.hp.max}}%"></span></div>
        {{#if derived.reeling}}<span class="v2-pool-status v2-bad">{{localize "GWORLD.Health.reeling"}}</span>{{/if}}
      </div>
      <div class="v2-pool">
        <div class="v2-pool-head">
          <span class="v2-pool-name">{{localize "GWORLD.Secondary.FP"}}</span>
          <span class="v2-pool-value">{{system.fp.value}} <span class="v2-muted">/ {{system.fp.max}}</span></span>
        </div>
        <div class="v2-bar v2-bar-fp"><span style="width: {{percent system.fp.value system.fp.max}}%"></span></div>
      </div>
    </div>

    <div class="v2-npc-scores">
      {{#each statCells as |cell|}}
        <div class="v2-score">
          <span class="v2-stat-label">{{cell.label}}</span>
          {{#if cell.rollable}}
            <button type="button" class="v2-score-value" data-action="roll" data-roll-type="attribute"
                    data-roll-label="{{cell.label}}" data-roll-target="{{cell.value}}">{{cell.value}}</button>
          {{else}}
            <span class="v2-score-value">{{cell.value}}</span>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>

  <div class="v2-panel v2-npc-defenses">
    <h2 class="v2-ph">{{localize "GWORLD.Section.ActiveDefenses"}}</h2>
    <div class="v2-score-row">
      <div class="v2-score">
        <span class="v2-stat-label">{{localize "GWORLD.Secondary.Dodge"}}</span>
        <button type="button" class="v2-score-value" data-action="roll" data-roll-type="dodge"
                data-roll-label="{{localize 'GWORLD.Secondary.Dodge'}}" data-roll-target="{{derived.defenses.dodge.total}}">{{derived.defenses.dodge.total}}</button>
      </div>
      <div class="v2-score">
        <span class="v2-stat-label">{{localize "GWORLD.Secondary.Parry"}}</span>
        <span class="v2-score-value">{{#if derived.defenses.parry}}{{derived.defenses.parry.total}}{{else}}&mdash;{{/if}}</span>
      </div>
      <div class="v2-score">
        <span class="v2-stat-label">{{localize "GWORLD.Secondary.Block"}}</span>
        <span class="v2-score-value">{{#if derived.defenses.block}}{{derived.defenses.block.total}}{{else}}&mdash;{{/if}}</span>
      </div>
    </div>
    <div class="v2-npc-armor">
      <span>
        {{#if derived.armorName}}{{derived.armorName}}{{else}}{{localize "GWORLD.Item.NoArmor"}}{{/if}}
        {{~#unless derived.shieldName}}, {{localize "GWORLD.Item.NoShield"}}{{/unless}}
      </span>
      {{#if torsoDr}}
        <span class="v2-tag">
          {{localize "GWORLD.Armor.DRAbbr"}} {{torsoDr.dr}}
          {{~#if torsoDr.splits}}
            {{~#each torsoDr.exceptions as |ex|}} / {{ex.dr}} {{localize "GWORLD.Armor.Versus"}}
              {{~#each ex.types as |t|}} {{localize (concat "GWORLD.DamageType." t)}}{{#unless @last}},{{/unless}}{{/each}}
            {{~/each}}
          {{~/if}}
        </span>
      {{/if}}
    </div>
  </div>

  {{#if attacks.length}}
    <div class="v2-panel v2-npc-attacks">
      <h2 class="v2-ph">{{localize "GWORLD.Section.Attacks"}}</h2>
      <div class="v2-attack-grid">
        {{#each attacks as |entry|}}
          {{> "gworld.v2.attackCard" atk=entry.atk ranged=entry.ranged key=entry.key}}
        {{/each}}
      </div>
    </div>
  {{/if}}

  {{#if notableSkills.length}}
    <div class="v2-panel">
      <h2 class="v2-ph">{{localize "GWORLD.Section.SkillsOfNote"}}</h2>
      <div class="v2-npc-list">
        {{#each notableSkills as |skill|}}
          <button type="button" class="v2-npc-entry" data-action="roll" data-roll-type="skill"
                  data-roll-label="{{skill.name}}" data-roll-target="{{skill.level}}">
            <span>{{skill.name}}</span><b>{{skill.level}}</b>
          </button>
        {{/each}}
      </div>
    </div>
  {{/if}}

  {{#if notableSpells.length}}
    <div class="v2-panel">
      <h2 class="v2-ph">{{localize "GWORLD.Section.SpellsKnown"}}</h2>
      <div class="v2-npc-list">
        {{#each notableSpells as |spell|}}
          <button type="button" class="v2-npc-entry" data-action="castSpell" data-item-id="{{spell.id}}"
                  data-tooltip="{{localize 'GWORLD.Cast.Title'}}">
            <span>{{spell.name}}</span><b>{{spell.level}}</b>
          </button>
        {{/each}}
      </div>
    </div>
  {{/if}}

  {{#if swarm}}
    <div class="v2-panel">
      <h2 class="v2-ph">{{localize "GWORLD.Swarm.Title"}}</h2>
      <p class="v2-note">
        {{localize "GWORLD.Swarm.Line"
           damage=(either swarm.damage swarm.flatInjury)
           kind=(localize (concat "GWORLD.Swarm.Kind." swarm.kind))}}
        {{#if swarm.about}}<span class="v2-muted">&middot; {{swarm.about}}</span>{{/if}}
      </p>
      {{#if swarm.inPlay}}
        <div>
          <button type="button" class="v2-button v2-button-red" data-action="swarmAttack"
                  data-tooltip="{{localize "GWORLD.Swarm.AttackHint"}}">{{localize "GWORLD.Swarm.Attack"}}</button>
        </div>
      {{/if}}
    </div>
  {{/if}}

  {{#if (or system.tactics cannonFodderInPlay)}}
    <div class="v2-panel v2-npc-notes">
      {{#if cannonFodderInPlay}}
        {{!-- A mook (Campaigns p. 417): fails every defense, never goes all out,
             and drops the moment anything gets through. --}}
        <label class="icheck" data-tooltip="{{localize 'GWORLD.Cinematic.CannonFodderHint'}}">
          <input type="checkbox" name="system.cannonFodder"
                 {{#if system.cannonFodder}}checked{{/if}} {{#unless editable}}disabled{{/unless}}>
          <span>{{localize "GWORLD.Cinematic.CannonFodder"}}</span>
        </label>
      {{/if}}
      {{#if system.tactics}}
        <div class="v2-npc-tactics">{{> "gworld.info"}}<span>{{system.tactics}}</span></div>
      {{/if}}
    </div>
  {{/if}}

  {{!-- What the creature is, in words. Folded to its first line like a
       trait's description, so a bestiary entry of several paragraphs does not
       push the stat block off a one-pane sheet. Shown when there is anything
       to read, and to whoever can edit it so a GM can write one. --}}
  {{#if (or system.details.description editable)}}
    <details class="v2-panel tdfold npcdesc">
      <summary title="{{localize "GWORLD.Npc.DescriptionHint"}}">
        <span class="v2-ph">{{localize "GWORLD.Npc.Description"}}</span>
        {{#if description.first}}<span class="tdfirst">{{description.first}}</span>{{/if}}
      </summary>
      {{#if editable}}
        <prose-mirror class="box editor prose" name="system.details.description"
                      value="{{system.details.description}}" toggled>{{{descriptionHTML}}}</prose-mirror>
      {{else}}
        <div class="tdfull prose">{{{descriptionHTML}}}</div>
      {{/if}}
    </details>
  {{/if}}

</div>
</div>
