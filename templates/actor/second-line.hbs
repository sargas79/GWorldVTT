{{!-- One second line of an attack row (Characters p. 106): an attack that
     lands with the row's own rather than instead of it. Its tooltip says
     which of the two kinds it is. Takes `atk` and `second`. --}}
{{#if second.affliction}}
  {{!-- A linked affliction is resisted, not rolled for damage: the
        electrolaser's shot burns and shocks on the one attack. --}}
  <span class="tag rollable" data-action="affliction" data-second-line="{{#if second.followUp}}followUp{{else}}linked{{/if}}"
        data-resist="{{second.afflictionAttribute}}"
        data-resist-modifier="{{second.afflictionModifier}}"
        data-item-id="{{atk.itemId}}" data-mode-index="{{atk.modeIndex}}"
        data-damage-type="{{second.damageType}}"
        data-armor-divisor="{{second.armorDivisor}}" data-follow-up="{{#if second.followUp}}1{{/if}}"
        data-half-damage-range="{{atk.halfDamageRange}}"
        data-area-attack="{{#if (or atk.areaAttack second.radius)}}1{{/if}}" data-area-radius="{{second.radius}}"
        data-affliction-label="{{atk.name}} {{#if second.label}}{{second.label}}{{else if second.followUp}}{{localize 'GWORLD.Attack.FollowUp'}}{{else}}{{localize 'GWORLD.Attack.Linked'}}{{/if}}"
        data-tooltip="{{#if second.followUp}}{{localize 'GWORLD.Attack.FollowUpHint'}}{{else}}{{localize 'GWORLD.Attack.LinkedHint'}}{{/if}}"
        >{{second.afflictionAttribute}}{{second.afflictionModifier}}{{#unless (eq second.armorDivisor 1)}} ({{second.armorDivisor}}){{/unless}} {{localize "GWORLD.Affliction.Short"}}{{#if second.radius}} {{localize "GWORLD.Attack.Radius" yards=second.radius}}{{/if}}</span>
{{else}}
  <span class="tag rollable" data-action="rollDamage" data-second-line="{{#if second.followUp}}followUp{{else}}linked{{/if}}"
        data-damage-formula="{{second.damage}}" data-damage-type="{{second.damageType}}"
        data-damage-label="{{atk.name}} {{#if second.label}}{{second.label}}{{else if second.followUp}}{{localize 'GWORLD.Attack.FollowUp'}}{{else}}{{localize 'GWORLD.Attack.Linked'}}{{/if}}"
        data-armor-divisor="{{#if second.armorDivisor}}{{second.armorDivisor}}{{else}}1{{/if}}"
        data-explosive="{{#if second.explosive}}1{{/if}}" data-fragmentation="{{second.fragmentation}}"
        data-fragmentation-type="{{second.fragmentationType}}" data-fragmentation-divisor="{{second.fragmentationDivisor}}"
        data-blast-placement="{{second.blastPlacement}}"
        data-radiation="{{#if second.radiation}}1{{/if}}" data-surge="{{#if second.surge}}1{{/if}}" data-area-radius="{{second.radius}}"
        data-tooltip="{{#if second.followUp}}{{localize 'GWORLD.Attack.FollowUpHint'}}{{else}}{{localize 'GWORLD.Attack.LinkedHint'}}{{/if}}"
        >+{{shownDamage second.damage}} {{second.damageType}}{{#if second.radius}} {{localize "GWORLD.Attack.Radius" yards=second.radius}}{{/if}}</span>
{{/if}}
