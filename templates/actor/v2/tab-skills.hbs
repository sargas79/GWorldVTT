<section class="tab v2-tab v2-list-tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> "gworld.addonSheetSections" sections=addonSheetSections.start}}

  <div class="v2-split">
    <div class="v2-list-col">
      {{!-- Search, sort and the groups to narrow to. --}}
      <div class="v2-toolbar">
        <label class="v2-search v2-search-wide">
          {{> "gworld.search"}}
          <input type="search" data-v2-filter="skills" placeholder="{{localize 'GWORLD.SheetV2.SearchSkills'}}…"
                 aria-label="{{localize 'GWORLD.SheetV2.SearchSkills'}}" autocomplete="off">
        </label>
        <label class="v2-select">
          <span>{{localize "GWORLD.SheetV2.SortBy"}}</span>
          <select data-v2-sort="skills" aria-label="{{localize 'GWORLD.SheetV2.SortBy'}}">
            {{#each v2.skills.sorts as |s|}}<option value="{{s.key}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>{{/each}}
          </select>
        </label>
        {{!-- Attribute sections as the printed sheet has them, or one
             alphabetical list. The classic sheet's setting, so both follow it. --}}
        <button type="button" class="v2-button" data-action="toggleSkillOrder"
                data-tooltip="{{localize 'GWORLD.Settings.SkillOrder.Hint'}}">
          {{#if v2.skills.alphabetical}}{{localize "GWORLD.Action.OrderByAttribute"}}{{else}}{{localize "GWORLD.Action.OrderByName"}}{{/if}}
        </button>
      </div>
      <div class="v2-chips v2-chip-row" role="toolbar" aria-label="{{localize 'GWORLD.SheetV2.Filter'}}">
        {{#each v2.skills.chips as |chip|}}
          <button type="button" class="v2-filter-chip{{#if chip.active}} active{{/if}}" data-action="v2Chip" data-v2-chip="skills:{{chip.key}}"
                  aria-pressed="{{#if chip.active}}true{{else}}false{{/if}}">{{chip.label}}{{#if chip.count}} <span>{{chip.count}}</span>{{/if}}</button>
        {{/each}}
        {{#if editable}}
          <span class="v2-toolbar-end">
            <button type="button" class="v2-button" data-action="browseCompendium" data-item-types="skill"
                    data-browse-title="GWORLD.Picker.SkillsOnly" data-custom-type="skill">{{> "gworld.plus"}} {{localize "GWORLD.Action.AddSkill"}}</button>
            <button type="button" class="v2-button" data-action="browseCompendium" data-item-types="technique"
                    data-browse-title="GWORLD.Picker.Techniques" data-custom-type="technique">{{> "gworld.plus"}} {{localize "GWORLD.Action.AddTechnique"}}</button>
            {{#if rules.study}}
              <button type="button" class="v2-button" data-action="study" data-tooltip="{{localize 'GWORLD.Life.StudyHint'}}">{{localize "GWORLD.Life.Study"}}</button>
            {{/if}}
          </span>
        {{/if}}
      </div>

      <div class="v2-groups" data-v2-list="skills">
        {{#each v2.skills.groups as |group|}}
          <details class="v2-group{{#unless (or (eq @root.v2.skills.chip 'all') (eq @root.v2.skills.chip group.key))}} v2-off{{/unless}}" data-v2-fold="skills:{{group.key}}"
                   data-v2-group data-v2-chip-group="skills:{{group.key}}" {{#if group.open}}open{{/if}}>
            <summary class="v2-group-head">
              <span class="v2-group-title">{{group.label}}</span>
              {{#if group.score}}<span class="v2-group-sub">{{group.key}} {{group.score}}</span>{{/if}}
              <span class="v2-group-sub">{{group.points}} {{localize "GWORLD.Column.Pts"}}</span>
              <span class="v2-chevron" aria-hidden="true">{{> "gworld.v2icon.chevron"}}</span>
            </summary>
            <div class="v2-rows" role="listbox" aria-label="{{group.label}}">
              {{#each group.rows as |row|}}
                <div class="v2-row v2-skill{{#unless row.trained}} dim{{/unless}}{{#if (eq row.key @root.v2.skills.selected)}} selected{{/if}}"
                     data-item-id="{{row.id}}" data-v2-row="skills:{{row.key}}" data-v2-name="{{row.name}}"
                     data-action="v2Select" role="option" tabindex="0"
                     aria-selected="{{#if (eq row.key @root.v2.skills.selected)}}true{{else}}false{{/if}}">
                  {{#if (eq row.kind "skill")}}
                    {{#if @root.editable}}
                      <button type="button" class="v2-pin{{#if row.pinned}} on{{/if}}" data-action="v2PinSkill"
                              data-tooltip="{{#if row.pinned}}{{localize 'GWORLD.SheetV2.Unpin'}}{{else}}{{localize 'GWORLD.SheetV2.Pin'}}{{/if}}"
                              aria-label="{{#if row.pinned}}{{localize 'GWORLD.SheetV2.Unpin'}}{{else}}{{localize 'GWORLD.SheetV2.Pin'}}{{/if}}">{{> "gworld.v2icon.star"}}</button>
                    {{else}}
                      <span class="v2-pin{{#if row.pinned}} on{{/if}}" aria-hidden="true">{{> "gworld.v2icon.star"}}</span>
                    {{/if}}
                  {{else}}
                    <span class="v2-pin" aria-hidden="true"></span>
                  {{/if}}
                  <span class="v2-row-name">
                    {{row.name}}
                    {{#if row.techLevel}}<span class="v2-tag">TL{{row.techLevel}}</span>{{/if}}
                    {{#unless row.trained}}<span class="v2-tag" data-tooltip="{{localize 'GWORLD.Section.RolledAtDefault'}}">{{localize "GWORLD.Skill.Untrained"}}</span>{{/unless}}
                  </span>
                  <span class="v2-row-type">
                    {{#if (eq row.kind "skill")}}{{row.attribute}}/{{row.difficulty}}{{else}}{{#if row.kindLabel}}{{row.kindLabel}}{{else}}{{row.defaultLabel}}{{/if}}{{/if}}
                  </span>
                  <span class="v2-row-points">
                    {{#if @root.editable}}
                      <span class="ptstep">
                        <button type="button" data-action="stepPoints" data-step="down" id="{{@root.sheetId}}-{{row.id}}-down"
                                aria-label="{{localize 'GWORLD.Skill.SpendLess'}}" title="{{localize 'GWORLD.Skill.SpendLess'}}">&minus;</button>
                        <input type="number" class="npts" min="0" step="1" id="{{@root.sheetId}}-{{row.id}}-pts"
                               value="{{row.points}}" data-item-field="system.points" aria-label="{{localize 'GWORLD.Column.Pts'}}">
                        <button type="button" data-action="stepPoints" data-step="up" id="{{@root.sheetId}}-{{row.id}}-up"
                                aria-label="{{localize 'GWORLD.Skill.SpendMore'}}" title="{{localize 'GWORLD.Skill.SpendMore'}}">+</button>
                      </span>
                    {{else}}{{row.points}} {{localize "GWORLD.Column.Pts"}}{{/if}}
                  </span>
                  {{#if row.rollable}}
                    <button type="button" class="v2-row-level rollable" data-action="roll" data-roll-type="skill"
                            data-roll-label="{{row.name}}" data-roll-target="{{row.level}}" {{#if row.attribute}}data-based-on="{{row.attribute}}"{{/if}}
                            {{#if row.bonusLines.length}}data-tooltip="{{bonusLines row.bonusLines}}"{{/if}}
                            aria-label="{{localize 'GWORLD.SheetV2.RollSkill' name=row.name level=row.level}}">{{row.level}}{{#if row.boughtUpFromDefault}}<sup class="v2-from-default" data-tooltip="{{localize 'GWORLD.Skill.BoughtUpFromDefault'}}" aria-label="{{localize 'GWORLD.Skill.BoughtUpFromDefault'}}">&uarr;</sup>{{/if}}</button>
                  {{else if row.open}}
                    {{#if @root.editable}}
                      <button type="button" class="v2-badge v2-badge-muted" data-action="chooseTechniqueSkill"
                              data-tooltip="{{localize 'GWORLD.Technique.Open.ChooseHint'}}">{{localize "GWORLD.Technique.Open.Choose"}}</button>
                    {{else}}<span class="v2-row-level v2-muted">&mdash;</span>{{/if}}
                  {{else}}
                    <span class="v2-row-level v2-muted" data-tooltip="{{localize 'GWORLD.Skill.NoDefault'}}">&mdash;</span>
                  {{/if}}
                  {{!-- Roll and delete without opening the panel. Add-on row actions go before delete. --}}
                  <span class="v2-row-actions">
                    {{#if row.rollable}}
                      <button type="button" class="v2-row-icon rollable" data-action="roll" data-roll-type="skill"
                              data-roll-label="{{row.name}}" data-roll-target="{{row.level}}" {{#if row.attribute}}data-based-on="{{row.attribute}}"{{/if}}
                              data-tooltip="{{localize 'GWORLD.SheetV2.RollSkill' name=row.name level=row.level}}"
                              aria-label="{{localize 'GWORLD.SheetV2.RollSkill' name=row.name level=row.level}}">{{> "gworld.die"}}</button>
                    {{/if}}
                    {{#if @root.editable}}
                      <button type="button" class="v2-row-icon v2-row-delete" data-action="deleteItem"
                              data-tooltip="{{localize 'GWORLD.SheetV2.DeleteNamed' name=row.name}}"
                              aria-label="{{localize 'GWORLD.SheetV2.DeleteNamed' name=row.name}}">{{> "gworld.trash"}}</button>
                    {{/if}}
                  </span>
                </div>
              {{/each}}
            </div>
          </details>
        {{else}}
          <p class="v2-empty v2-empty-frame">{{localize "GWORLD.SheetV2.NoSkillsYet"}}</p>
        {{/each}}

        {{!-- Languages, with the skills a character speaks through. --}}
        <div class="v2-panel v2-group-panel{{#unless (or (eq v2.skills.chip 'all') (eq v2.skills.chip 'languages'))}} v2-off{{/unless}}" data-v2-chip-group="skills:languages">
          {{> "gworld.part.description-languages"}}
        </div>
      </div>

      <p class="v2-footnote">
        {{v2.skills.trainedCount}} {{localize "GWORLD.Skill.Trained"}} &middot; {{v2.skills.points}} {{localize "GWORLD.Points.PointsLabel"}}
      </p>
      {{> "gworld.addonSections"}}
    </div>

    {{!-- The selected skill in full. Every panel is drawn; the one selected shows. --}}
    <aside class="v2-detail-col" aria-live="polite">
      {{#each v2.skills.rows as |row|}}
        <article class="v2-panel v2-detail" data-v2-detail="skills:{{row.key}}" data-item-id="{{row.id}}" {{#unless row.selected}}hidden{{/unless}}>
          <header class="v2-detail-head v2-detail-steel">
            <h3>{{row.name}}</h3>
            <span>{{#if (eq row.kind "skill")}}{{row.attribute}}/{{row.difficulty}}{{else}}{{localize "GWORLD.Section.Techniques"}}{{/if}} &middot; {{row.points}} {{localize "GWORLD.Column.Pts"}}</span>
          </header>
          <div class="v2-detail-stats">
            <div>
              <span class="v2-stat-label">{{localize "GWORLD.SheetV2.Effective"}}</span>
              <span class="v2-detail-big">{{#if row.chance}}{{row.level}}{{else}}&mdash;{{/if}}</span>
            </div>
            {{#if row.chance}}
              <div data-tooltip="{{localize 'GWORLD.SheetV2.CriticalsHint' success=row.chance.criticalSuccess failure=row.chance.criticalFailure}}">
                <span class="v2-stat-label">3d6</span>
                <span class="v2-detail-big">{{row.chance.success}}%</span>
                <span class="v2-stat-note">{{localize "GWORLD.SheetV2.SuccessChance"}}</span>
              </div>
            {{/if}}
          </div>
          <ul class="v2-breakdown">
            {{#if (eq row.kind "skill")}}
              <li><span>{{localize "GWORLD.Column.Relative"}}</span><b>{{relativeLabel row.item}}</b></li>
            {{else}}
              <li><span>{{localize "GWORLD.SheetV2.Default"}}</span><b>{{row.defaultLabel}}</b></li>
            {{/if}}
            {{#if row.talentBonus}}<li><span>{{localize "GWORLD.SheetV2.Talent"}}</span><b>{{signed row.talentBonus}}</b></li>{{/if}}
            {{#if row.toolBonus}}<li><span>{{localize "GWORLD.SheetV2.Equipment"}}</span><b>{{signed row.toolBonus}}</b></li>{{/if}}
            {{#each row.bonusLines as |line|}}<li><span>{{line.label}}{{#if line.reason}} <em>({{line.reason}})</em>{{/if}}</span><b>{{signed line.value}}</b></li>{{/each}}
          </ul>
          {{#if row.descriptionHtml}}
            <div class="v2-prose">{{{row.descriptionHtml}}}</div>
          {{/if}}
          {{#if row.reference}}<p class="v2-reference">{{row.reference}}</p>{{/if}}
          <div class="v2-detail-actions">
            {{#if row.rollable}}
              <button type="button" class="v2-button v2-button-steel rollable" data-action="roll" data-roll-type="skill"
                      data-roll-label="{{row.name}}" data-roll-target="{{row.level}}" {{#if row.attribute}}data-based-on="{{row.attribute}}"{{/if}}>{{> "gworld.die"}} {{localize "GWORLD.SheetV2.RollIt"}}</button>
            {{/if}}
            {{#if (and @root.editable (eq row.kind "skill"))}}
              <button type="button" class="v2-button" data-action="v2PinSkill">{{#if row.pinned}}{{localize "GWORLD.SheetV2.Unpin"}}{{else}}{{localize "GWORLD.SheetV2.Pin"}}{{/if}}</button>
            {{/if}}
            <button type="button" class="v2-button" data-action="editItem">{{localize "GWORLD.SheetV2.Edit"}}</button>
            {{#if @root.editable}}
              <button type="button" class="v2-button v2-button-red" data-action="deleteItem">{{> "gworld.trash"}} {{localize "GWORLD.Action.Delete"}}</button>
            {{/if}}
          </div>
          {{#if row.improve}}
            <div class="v2-improve{{#if row.improve.overspends}} over{{/if}}">
              <div class="v2-improve-text">
                <strong>{{localize "GWORLD.SheetV2.Improve" name=row.name}}</strong>
                <span>{{row.improve.from}} &rarr; {{row.improve.to}} {{localize "GWORLD.Column.Pts"}}{{#if row.improve.levelTo}} &middot; {{localize "GWORLD.SheetV2.LevelStep" from=row.improve.levelFrom to=row.improve.levelTo}}{{/if}}</span>
                <span>{{localize "GWORLD.SheetV2.CostCp" cost=row.improve.cost}}{{#if row.improve.overspends}} &middot; <b class="v2-bad">{{localize "GWORLD.SheetV2.WouldOverspend" points=row.improve.overBy}}</b>{{/if}}</span>
              </div>
              {{#if @root.editable}}
                <span class="v2-improve-buttons">
                  <button type="button" class="v2-button" data-action="stepPoints" data-step="down"
                          aria-label="{{localize 'GWORLD.Skill.SpendLess'}}">&minus;</button>
                  <button type="button" class="v2-button v2-button-gold" data-action="stepPoints" data-step="up">{{localize "GWORLD.SheetV2.Upgrade"}}</button>
                </span>
              {{/if}}
            </div>
          {{/if}}
        </article>
      {{else}}
        <div class="v2-panel v2-detail"><p class="v2-empty">{{localize "GWORLD.SheetV2.SelectSomething"}}</p></div>
      {{/each}}
    </aside>
  </div>
</section>
