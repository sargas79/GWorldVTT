<section class="tab v2-tab v2-list-tab v2-inventory{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> "gworld.addonSheetSections" sections=addonSheetSections.start}}

  {{!-- What the load comes to, and what it costs in Move and Dodge. --}}
  <div class="v2-load-strip">
    <span>{{localize "GWORLD.Gear.Carried"}} <b>{{decimal v2.inventory.strip.carried 1}} lb</b> / {{localize "GWORLD.Secondary.BasicLift"}} <b>{{v2.inventory.strip.basicLift}} lb</b></span>
    <span class="v2-load-pill{{#if v2.inventory.strip.encumbered}} heavy{{/if}}{{#if v2.inventory.strip.overloaded}} over{{/if}}"
          data-tooltip="{{#if v2.inventory.strip.overloaded}}{{localize 'GWORLD.Hint.Overloaded'}}{{/if}}">{{v2.inventory.strip.level}}</span>
    <span>{{localize "GWORLD.Secondary.Move"}} <b>{{v2.inventory.strip.move}}</b></span>
    <span>{{localize "GWORLD.Secondary.Dodge"}} <b>{{#if v2.inventory.strip.dodge}}{{v2.inventory.strip.dodge}}{{else}}&mdash;{{/if}}</b>{{#if v2.inventory.strip.dodgePenalty}} <em class="v2-warn">({{v2.inventory.strip.dodgePenalty}})</em>{{/if}}</span>
    <span class="v2-load-money">{{localize "GWORLD.Life.Cash"}} <b>${{v2.inventory.strip.money}}</b></span>
  </div>
  <div class="v2-tiers">
    {{#each v2.inventory.strip.tiers as |tier|}}
      <span class="v2-tier{{#if tier.active}} active{{/if}}"><b>{{localize tier.label}}</b> &le; {{tier.limit}} lb &middot; {{localize "GWORLD.Secondary.Move"}} {{tier.move}}</span>
    {{/each}}
  </div>

  <div class="v2-split">
    <div class="v2-list-col">
      {{!-- Search, the kinds to narrow to, and what can be added, in one toolbar. --}}
      <div class="v2-toolbar">
        <label class="v2-search v2-search-wide">
          {{> "gworld.search"}}
          <input type="search" data-v2-filter="inventory" placeholder="{{localize 'GWORLD.SheetV2.SearchGear'}}…"
                 aria-label="{{localize 'GWORLD.SheetV2.SearchGear'}}" autocomplete="off">
        </label>
        {{#if editable}}
          <span class="v2-toolbar-end">
            {{!-- Each opens the list of what the books offer, with an entry of your own at its foot. --}}
            <button type="button" class="v2-button" data-action="browseCompendium" data-item-types="equipment" data-browse-title="GWORLD.Picker.Equipment" data-custom-type="equipment">{{> "gworld.plus"}} {{localize "GWORLD.Action.AddEquipment"}}</button>
            <button type="button" class="v2-button" data-action="browseCompendium" data-item-types="armor" data-browse-title="GWORLD.Picker.Armor" data-custom-type="armor">{{> "gworld.plus"}} {{localize "GWORLD.Action.AddArmor"}}</button>
            <button type="button" class="v2-button" data-action="browseCompendium" data-item-types="shield" data-browse-title="GWORLD.Picker.Shield" data-custom-type="shield">{{> "gworld.plus"}} {{localize "GWORLD.Action.AddShield"}}</button>
          </span>
        {{/if}}
      </div>
      <div class="v2-chips v2-chip-row" role="toolbar" aria-label="{{localize 'GWORLD.SheetV2.Filter'}}">
        {{#each v2.inventory.chips as |chip|}}
          <button type="button" class="v2-filter-chip{{#if chip.active}} active{{/if}}" data-action="v2Chip" data-v2-chip="inventory:{{chip.key}}"
                  aria-pressed="{{#if chip.active}}true{{else}}false{{/if}}">{{chip.label}}{{#if chip.count}} <span>{{chip.count}}</span>{{/if}}</button>
        {{/each}}
      </div>

      {{!-- Everything carried, by kind, then what is stored: a list like the Skills and Traits tabs. --}}
      <div class="v2-groups" data-v2-list="inventory">
        <div class="v2-gear-head" role="presentation">
          <span></span>
          {{#each v2.inventory.columns as |col|}}
            <button type="button" class="v2-sort v2-sort-{{col.key}}{{#if col.active}} active{{/if}}" data-action="v2GearSort" data-v2-gear-sort="{{col.key}}"
                    aria-label="{{localize 'GWORLD.SheetV2.SortByColumn' column=col.label}}">{{col.label}}{{#if col.active}}{{#if col.descending}} &uarr;{{else}} &darr;{{/if}}{{/if}}</button>
          {{/each}}
          <span></span>
        </div>

        {{#each v2.inventory.carriedGroups as |group|}}
          <details class="v2-group{{#unless (or (eq @root.v2.inventory.chip 'all') (eq @root.v2.inventory.chip group.key))}} v2-off{{/unless}}"
                   data-v2-fold="inventory:{{group.key}}" data-v2-group data-v2-chip-group="inventory:{{group.key}}" data-v2-drop="carried"
                   {{#unless (includes @root.v2.folded (concat "inventory:" group.key))}}open{{/unless}}>
            <summary class="v2-group-head">
              <span class="v2-group-title">{{localize group.label}}</span>
              <span class="v2-group-sub">{{group.rows.length}}</span>
              <span class="v2-chevron" aria-hidden="true">{{> "gworld.v2icon.chevron"}}</span>
            </summary>
            <div class="v2-rows" role="listbox" aria-label="{{localize group.label}}">
              {{#each group.rows as |row|}}
                {{> "gworld.v2.gearRow" row=row stored=false}}
              {{/each}}
            </div>
          </details>
        {{/each}}

        <details class="v2-group v2-stored{{#unless (or (eq v2.inventory.chip 'all') (eq v2.inventory.chip 'stored'))}} v2-off{{/unless}}"
                 data-v2-fold="inventory:stored" data-v2-group data-v2-chip-group="inventory:stored" data-v2-drop="stored"
                 {{#unless (includes v2.folded "inventory:stored")}}open{{/unless}}>
          <summary class="v2-group-head">
            <span class="v2-group-title">{{localize "GWORLD.Gear.Stored"}}</span>
            <span class="v2-group-sub">{{localize "GWORLD.Hint.StoredNoEncumbrance"}}</span>
            <span class="v2-chevron" aria-hidden="true">{{> "gworld.v2icon.chevron"}}</span>
          </summary>
          <div class="v2-rows" role="listbox" aria-label="{{localize 'GWORLD.Gear.Stored'}}">
            {{#each v2.inventory.stored as |row|}}
              {{> "gworld.v2.gearRow" row=row stored=true}}
            {{else}}
              <p class="v2-empty">{{localize "GWORLD.SheetV2.DragToStore"}}</p>
            {{/each}}
          </div>
        </details>
      </div>

      <div class="v2-inventory-grid">
        {{!-- What is ready to hand. --}}
        <div class="v2-panel v2-panel-dark v2-readied-items">
          <h2 class="v2-ph">{{localize "GWORLD.SheetV2.Readied"}}</h2>
          {{#if v2.inventory.readied.length}}
            <div class="v2-quick-slots">
              {{#each v2.inventory.readied as |item|}}
                <div class="v2-slot{{#if item.selected}} selected{{/if}}" data-item-id="{{item.id}}" data-v2-row="inventory:{{item.key}}" data-action="v2Select" tabindex="0">
                  <img src="{{item.img}}" alt="">
                  <span class="v2-slot-name">{{item.name}}</span>
                  <span class="v2-slot-meta">{{#if (gt item.quantity 1)}}&times;{{item.quantity}} &middot; {{/if}}{{decimal item.weight 1}} lb &middot; {{#if item.equipped}}{{localize "GWORLD.Item.Readied"}}{{else}}{{localize "GWORLD.Gear.Carried"}}{{/if}}</span>
                  {{#if @root.editable}}
                    <span class="v2-slot-buttons">
                      <button type="button" class="v2-button v2-button-small{{#if item.equipped}} v2-button-gold{{/if}}" data-action="toggleEquipped">{{#if item.equipped}}{{localize "GWORLD.SheetV2.Unequip"}}{{else}}{{localize "GWORLD.SheetV2.Equip"}}{{/if}}</button>
                      {{#if item.canCarry}}
                        <button type="button" class="v2-button v2-button-small" data-action="v2ToggleCarried">{{localize "GWORLD.SheetV2.Stow"}}</button>
                      {{/if}}
                    </span>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          {{else}}
            <p class="v2-empty">{{localize "GWORLD.SheetV2.NothingReady"}}</p>
          {{/if}}
        </div>

        {{!-- What is worn, area by area. --}}
        <div class="v2-panel v2-equipped">
          <h2 class="v2-ph">{{localize "GWORLD.SheetV2.Equipped"}}</h2>
          <ul class="v2-areas">
            {{#each v2.inventory.areas as |area|}}
              <li class="v2-area{{#unless area.pieces.length}} empty{{/unless}}">
                <span class="v2-area-name">{{area.label}}</span>
                {{#each area.pieces as |piece|}}
                  <button type="button" class="v2-area-piece" data-item-id="{{piece.id}}" data-v2-row="inventory:item:{{piece.id}}" data-action="v2Select">
                    {{piece.name}} <span>(DR {{piece.dr}})</span>
                  </button>
                {{else}}
                  <span class="v2-muted">{{localize "GWORLD.SheetV2.Nothing"}}</span>
                {{/each}}
              </li>
            {{/each}}
            {{#each v2.inventory.shields as |shield|}}
              <li class="v2-area">
                <span class="v2-area-name">{{localize "TYPES.Item.shield"}}</span>
                <button type="button" class="v2-area-piece" data-item-id="{{shield.id}}" data-v2-row="inventory:item:{{shield.id}}" data-action="v2Select">
                  {{shield.name}} <span>(DB {{shield.db}})</span>
                </button>
              </li>
            {{/each}}
          </ul>
        </div>
      </div>

      <div class="v2-panel">
        {{> "gworld.v2.money"}}
      </div>
      {{> "gworld.addonSections"}}
    </div>

    {{!-- The selected item in full. --}}
    <aside class="v2-detail-col" aria-live="polite">
      {{#each v2.inventory.details as |item|}}
        <article class="v2-panel v2-detail v2-item-detail" data-v2-detail="inventory:{{item.key}}" data-item-id="{{item.id}}" {{#unless item.selected}}hidden{{/unless}}>
          <header class="v2-detail-head v2-detail-red">
            <h3>{{item.name}}</h3>
          </header>
          <span class="v2-detail-sub">{{item.typeLabel}} &middot; {{item.groupLabel}}</span>
          {{!-- The equipment's own figures: armour, shield, vehicle or ammunition. A weapon's
               attack rows are on the Combat tab, with what it is loaded with. --}}
          {{#each item.stats.blocks as |block|}}
            <div class="v2-box v2-stat-block">
              <h4>{{block.title}}</h4>
              <dl class="v2-stat-grid">
                {{#each block.lines as |line|}}<dt>{{line.label}}</dt><dd{{#if line.words}} class="v2-stat-words"{{/if}}>{{line.value}}</dd>{{/each}}
              </dl>
            </div>
          {{/each}}
          <ul class="v2-breakdown">
            <li><span>{{localize "GWORLD.Column.Weight"}}</span><b>{{decimal item.weight 1}} lb{{#if (gt item.quantity 1)}} &times; {{item.quantity}}{{/if}}</b></li>
            <li><span>{{localize "GWORLD.Column.Cost"}}</span><b>${{item.cost}}{{#if (gt item.quantity 1)}} &times; {{item.quantity}}{{/if}}</b></li>
            {{#each item.stats.lines as |line|}}<li><span>{{line.label}}</span><b>{{line.value}}</b></li>{{/each}}
            {{#if item.isAmmunition}}
              {{!-- Rounds in the box: bought, found and lost between fights, so edited here. --}}
              <li><span>{{localize "GWORLD.Ammunition.Rounds"}}</span>
                <b>{{#if @root.editable}}{{> "gworld.stepper" itemField="system.quantity" value=item.quantity min=0 step=1
                       id=(concat @root.sheetId "-" item.id "-rounds") label=(localize "GWORLD.Ammunition.Rounds") tooltip=(localize "GWORLD.Ammunition.RoundsHint") editable=true}}{{else}}{{item.quantity}}{{/if}}</b></li>
            {{/if}}
            {{#if item.legality.label}}
              <li><span>{{localize "GWORLD.SheetV2.Legality"}}</span><b class="{{#if item.legality.restricted}}v2-bad{{/if}}">{{item.legality.label}}{{#if item.legality.status}} &middot; {{localize (concat 'GWORLD.Legality.Short.' item.legality.status)}}{{/if}}</b></li>
            {{/if}}
          </ul>
          {{#if item.descriptionHtml}}<div class="v2-prose">{{{item.descriptionHtml}}}</div>{{/if}}
          {{#if item.reference}}<p class="v2-reference">{{item.reference}}</p>{{/if}}
          {{#if item.vehicle}}
            <div class="v2-detail-actions">
              <button type="button" class="v2-button" data-action="controlVehicle">{{> "gworld.die"}} {{localize "GWORLD.Hazard.Control"}}</button>
              <button type="button" class="v2-button" data-action="shotAtVehicle">{{> "gworld.die"}} {{localize "GWORLD.Vehicle.ShotAt"}}</button>
              {{#if @root.rules.vehicleManeuvers}}
                <button type="button" class="v2-button" data-action="jumpOutOfVehicle"
                        data-tooltip="{{localize 'GWORLD.Hazard.JumpOutHint'}}">{{> "gworld.die"}} {{localize "GWORLD.Hazard.JumpOut"}}</button>
              {{/if}}
            </div>
          {{/if}}
          <div class="v2-detail-actions v2-stacked">
            {{#if @root.editable}}
              {{#if item.loadable}}
                {{!-- Buying rounds is shopping and stays here; loading them is on the Combat tab. --}}
                <button type="button" class="v2-button" data-action="buyAmmunition" data-mode-index="{{item.loadModeIndex}}"
                        data-tooltip="{{localize 'GWORLD.Ammunition.BuyHint'}}">{{localize "GWORLD.Ammunition.Buy"}}</button>
              {{/if}}
              {{!-- More of it, paid for out of the cash on the sheet. --}}
              <button type="button" class="v2-button v2-button-gold" data-action="buyItem"
                      data-tooltip="{{localize 'GWORLD.Shopping.BuyMoreHint'}}">{{localize "GWORLD.Shopping.BuyMore"}}</button>
              {{#if item.equippable}}
                <button type="button" class="v2-button v2-button-steel" data-action="toggleEquipped">{{#if item.equipped}}{{localize "GWORLD.SheetV2.Unequip"}}{{else}}{{localize "GWORLD.SheetV2.Equip"}}{{/if}}</button>
              {{/if}}
              {{#if item.canCarry}}
                <button type="button" class="v2-button v2-button-steel" data-action="v2ToggleCarried">{{#if item.carried}}{{localize "GWORLD.SheetV2.MoveToStorage"}}{{else}}{{localize "GWORLD.SheetV2.Carry"}}{{/if}}</button>
              {{/if}}
            {{/if}}
            <button type="button" class="v2-button" data-action="editItem">{{localize "GWORLD.SheetV2.Edit"}}</button>
            {{#if @root.editable}}
              <button type="button" class="v2-button v2-button-red" data-action="deleteItem">{{localize "GWORLD.SheetV2.Drop"}}</button>
            {{/if}}
          </div>
        </article>
      {{else}}
        <div class="v2-panel v2-detail"><p class="v2-empty">{{localize "GWORLD.SheetV2.NothingCarried"}}</p></div>
      {{/each}}
    </aside>
  </div>
</section>
