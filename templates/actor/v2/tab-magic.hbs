<section class="tab v2-tab v2-magic{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> "gworld.addonSheetSections" sections=addonSheetSections.start}}

  {{!-- The Magic tab's content, from its partial: Magery and
        style, mana, a spell in hand, magic items, running spells, and the
        spells by college. --}}
  <div class="v2-panel v2-magic-body">
    {{> "gworld.part.magic-body"}}
  </div>

  {{> "gworld.addonSections"}}
</section>
