{{!-- What an attack row carries beyond its damage: a follow-up attack to roll
     after the first, and notes for effects the GM adjudicates. --}}
{{#if atk.followUp}}
  {{!-- A second attack that lands with this one (Characters p. 106), not
        instead of it. Its own tooltip says which of the two it is. --}}
  {{#with atk.followUp as |second|}}
    {{#if second.affliction}}
      {{!-- A linked affliction is resisted, not rolled for damage: the
            electrolaser's shot burns and shocks on the one attack. --}}
      <span class="tag rollable" data-action="affliction"
            data-resist="{{second.afflictionAttribute}}"
            data-resist-modifier="{{second.afflictionModifier}}"
            data-item-id="{{atk.itemId}}" data-mode-index="{{atk.modeIndex}}"
            data-damage-type="{{second.damageType}}"
            data-half-damage-range="{{atk.halfDamageRange}}"
            data-affliction-label="{{atk.name}} {{#if second.label}}{{second.label}}{{else}}{{localize 'GWORLD.Attack.Linked'}}{{/if}}"
            data-tooltip="{{#if second.followUp}}{{localize 'GWORLD.Attack.FollowUpHint'}}{{else}}{{localize 'GWORLD.Attack.LinkedHint'}}{{/if}}"
            >{{second.afflictionAttribute}}{{second.afflictionModifier}}{{#unless (eq second.armorDivisor 1)}} ({{second.armorDivisor}}){{/unless}} {{localize "GWORLD.Affliction.Short"}}</span>
    {{else}}
      <span class="tag rollable" data-action="rollDamage"
            data-damage-formula="{{second.damage}}" data-damage-type="{{second.damageType}}"
            data-damage-label="{{atk.name}} {{#if second.label}}{{second.label}}{{else}}{{localize 'GWORLD.Attack.FollowUp'}}{{/if}}"
            data-armor-divisor="{{#if second.armorDivisor}}{{second.armorDivisor}}{{else}}1{{/if}}"
            data-explosive="{{#if second.explosive}}1{{/if}}" data-fragmentation="{{second.fragmentation}}"
            data-tooltip="{{#if second.followUp}}{{localize 'GWORLD.Attack.FollowUpHint'}}{{else}}{{localize 'GWORLD.Attack.LinkedHint'}}{{/if}}"
            >+{{second.damage}} {{second.damageType}}</span>
    {{/if}}
  {{/with}}
{{/if}}
{{!-- The damage modifiers of Characters pp. 104-105 that the apply acts on:
     shown so a GM can see what a blow carries before pressing it. --}}
{{#if atk.ignoresDr}}<span class="tag" data-tooltip="{{localize 'GWORLD.Malediction.IgnoresDrHint'}}">{{localize "GWORLD.Malediction.IgnoresDr"}}</span>{{/if}}
{{#if atk.incendiary}}<span class="tag" data-tooltip="{{localize 'GWORLD.Item.IncendiaryHint'}}">{{localize "GWORLD.Item.Incendiary"}}</span>{{/if}}
{{#if atk.radiation}}<span class="tag" data-tooltip="{{localize 'GWORLD.Item.RadiationHint'}}">{{localize "GWORLD.Item.Radiation"}}</span>{{/if}}
{{#if atk.doubleKnockback}}<span class="tag" data-tooltip="{{localize 'GWORLD.Item.DoubleKnockbackHint'}}">{{localize "GWORLD.Item.DoubleKnockback"}}</span>{{/if}}
{{#if atk.noKnockback}}<span class="tag" data-tooltip="{{localize 'GWORLD.Item.NoKnockbackHint'}}">{{localize "GWORLD.Item.NoKnockback"}}</span>{{/if}}
{{#each atk.notes as |n|}}<span class="tag" data-tooltip="{{n.hint}}">{{n.label}}</span>{{/each}}
