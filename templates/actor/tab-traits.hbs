<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> "gworld.addonSheetSections" sections=addonSheetSections.start}}

  {{#each traitGroups as |group|}}
    <div class="isec">
      <div class="ish">
        <span class="num">{{group.num}}</span>{{localize group.label}}
        <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
          {{group.total}} pts
        </span>
      </div>

      {{#each group.traits as |trait|}}
        <div class="trait blueprint" data-item-id="{{trait.id}}">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <span class="tn">
            <span data-action="editItem">{{trait.name}}</span>
            {{#if trait.levelled}}
              {{#if @root.editable}}
                {{!-- Ids so focus survives the redraw that follows every edit. --}}
                <span class="tag taglevels ptstep">
                  <button type="button" data-action="stepLevels" data-step="down"
                          id="{{@root.sheetId}}-{{trait.id}}-down"
                          aria-label="{{localize "GWORLD.Trait.OneLess"}}"
                          title="{{localize "GWORLD.Trait.OneLess"}}">&minus;</button>
                  <input type="number" min="0" step="1" value="{{trait.system.levels}}"
                         id="{{@root.sheetId}}-{{trait.id}}-levels"
                         data-item-field="system.levels"
                         aria-label="{{localize "GWORLD.Trait.Levels"}}" />
                  <button type="button" data-action="stepLevels" data-step="up"
                          id="{{@root.sheetId}}-{{trait.id}}-up"
                          aria-label="{{localize "GWORLD.Trait.OneMore"}}"
                          title="{{localize "GWORLD.Trait.OneMore"}}">+</button>
                  <span>{{#if trait.levelName}}{{trait.levelName}}{{else}}{{localize "GWORLD.Trait.Levels"}}{{/if}}</span>
                </span>
              {{else}}
                <span class="tag">
                  {{trait.system.levels}}
                  {{#if trait.levelName}}{{trait.levelName}}{{else}}{{localize "GWORLD.Trait.Levels"}}{{/if}}
                </span>
              {{/if}}
            {{/if}}
            {{#if trait.applied}}
              <span class="tag tag-accent" data-tooltip="{{localize "GWORLD.Trait.AppliedHint"}}">
                {{localize "GWORLD.Trait.Applied"}}
              </span>
            {{/if}}
            {{#if trait.system.reactionModifier}}
              <span class="tag tag-accent">{{signed trait.system.reactionModifier}} {{localize "GWORLD.Trait.Reaction"}}</span>
            {{/if}}
            {{#if trait.system.selfControl}}
              <span class="tag">CR {{trait.system.selfControl}}</span>
            {{/if}}
            {{#if trait.weakness}}
              <button type="button" class="tag rollable" data-action="weaknessExposure"
                      data-tooltip="{{localize "GWORLD.Weakness.ExposedHint"}}">{{localize "GWORLD.Weakness.Exposed"}}</button>
            {{/if}}
            {{#each trait.system.modifiers as |m|}}
              <span class="tag">{{signed m.value}}%{{#if m.name}} {{m.name}}{{/if}}</span>
            {{/each}}
          </span>
          <span class="tp {{#if group.negative}}neg{{/if}}">{{trait.system.totalPoints}}</span>
          {{#if @root.editable}}
            <button type="button" class="tdel rollable iconbtn" data-action="deleteItem"
                  title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
          {{/if}}
          {{#if trait.system.description}}
            {{#if trait.description.more}}
              {{!-- Folded to its first line. A native disclosure: the summary
                    takes focus, toggles on Enter or Space, and is announced
                    as expanded or collapsed without any script. --}}
              <details class="td tdfold" data-description-for="{{trait.id}}" {{#if trait.description.open}}open{{/if}}>
                <summary title="{{localize "GWORLD.Trait.DescriptionHint"}}">
                  <span class="tdfirst">{{trait.description.first}}</span>
                  <span class="tdless">{{localize "GWORLD.Trait.ShowLess"}}</span>
                </summary>
                <div class="tdfull">{{{trait.system.description}}}</div>
              </details>
            {{else}}
              <span class="td">{{{trait.system.description}}}</span>
            {{/if}}
          {{/if}}
        </div>
      {{/each}}

      {{#if @root.editable}}
        <div class="toolbar" style="align-self: flex-start">
          <button type="button" class="ibtn"
                  data-action="createItem" data-item-type="trait" data-category="{{group.category}}">
            + {{localize group.addLabel}}
          </button>
          <button type="button" class="ibtn" data-action="browseCompendium"
                  data-item-types="trait" data-categories="{{group.categories}}"
                  data-browse-title="{{group.browseTitle}}">
            {{> "gworld.search"}} {{localize "GWORLD.Action.BrowseTraits"}}
          </button>
        </div>
      {{/if}}
    </div>
  {{/each}}

  {{!-- What this character was built from. A template is not a thing they own,
        so it is listed here rather than sitting in the trait list. --}}
  <div class="isec">
    <div class="ish">
      <span class="num">{{templateSectionNum}}</span>{{localize "GWORLD.Template.Title"}}
      {{#if derived.points.templates}}
        <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
          {{derived.points.templates}} pts
        </span>
      {{/if}}
    </div>

    {{#each appliedTemplates as |applied i|}}
      <div class="cell">
        <span class="cl">{{localize (concat "GWORLD.Template." applied.kind)}}</span>
        <span class="cv" style="font-size: 16px">
          {{#if applied.uuid}}
            <a data-action="openTemplate" data-uuid="{{applied.uuid}}">{{applied.name}}</a>
          {{else}}
            {{applied.name}}
          {{/if}}
        </span>
        <span class="cd">
          {{#if applied.attributeCost}}
            {{localize "GWORLD.Template.Billed" points=applied.attributeCost}} &middot;
          {{/if}}
          {{localize "GWORLD.Template.Granted" count=applied.itemIds.length}}
        </span>
        {{!-- The template's own text, folded to its first line as a trait's is. --}}
        {{#if applied.descriptionHtml}}
          {{#if applied.description.more}}
            <details class="td tdfold" data-description-for="{{applied.descriptionKey}}" {{#if applied.description.open}}open{{/if}}>
              <summary title="{{localize "GWORLD.Trait.DescriptionHint"}}">
                <span class="tdfirst">{{applied.description.first}}</span>
                <span class="tdless">{{localize "GWORLD.Trait.ShowLess"}}</span>
              </summary>
              <div class="tdfull">{{{applied.descriptionHtml}}}</div>
            </details>
          {{else}}
            <span class="td">{{{applied.descriptionHtml}}}</span>
          {{/if}}
        {{/if}}
        {{#if @root.editable}}
          <div class="toolbar">
            <button type="button" class="ibtn tiny" data-action="removeTemplate" data-index="{{i}}">
              {{localize "GWORLD.Template.Remove"}}
            </button>
          </div>
        {{/if}}
      </div>
    {{else}}
      <p class="ihint">{{localize "GWORLD.Template.NoneApplied"}}</p>
    {{/each}}

    {{#if editable}}
      <div class="toolbar">
        <button type="button" class="ibtn" data-action="applyTemplate"
                data-tooltip="{{localize "GWORLD.Template.ApplyHint"}}">
          {{localize "GWORLD.Template.Apply"}}
        </button>
      </div>
    {{/if}}
  </div>

  <div class="meterwrap">
    <div style="display: flex; justify-content: space-between; font-size: 11px">
      <span class="fl">{{localize "GWORLD.Section.DisadvantageLimit"}}</span>
      <span><strong>{{derived.points.disadvantageTotal}}</strong> of {{derived.points.disadvantageLimit}}</span>
    </div>
    <div class="meter">
      <div class="mfill {{#if disadvantageOverLimit}}over{{/if}}"
           style="width: {{percent derived.points.disadvantageTotal derived.points.disadvantageLimit}}%"></div>
    </div>
    <div style="font-size: 11px; color: var(--color-neutral-700)">
      {{localize "GWORLD.Hint.DisadvantageLimit"}}
    </div>
  </div>

  {{#if unpoweredPsi.length}}
    {{!-- A psi ability bought without its power modifier is not psionic (p. 254). --}}
    <div class="isec">
      {{#each unpoweredPsi as |u|}}
        <p class="ihint warn">{{localize "GWORLD.Psi.Unpowered" trait=u.trait power=u.powerLabel}}</p>
      {{/each}}
    </div>
  {{/if}}

  {{#if psionics.length}}
    {{!-- The powers this character holds, what each Talent is worth, and a
         roll to use each: IQ, Will or Perception with the Talent on top
         (Characters pp. 254-255). --}}
    <div class="isec">
      <div class="ish">{{localize "GWORLD.Psi.Powers"}}</div>
      {{#each psionics as |power|}}
        <div class="trait blueprint">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <span class="tn">
            <span>{{power.label}}</span>
            {{#if power.talent}}
              <span class="tag" data-tooltip="{{localize 'GWORLD.Psi.TalentHint'}}">
                {{localize "GWORLD.Psi.Talent" bonus=power.signed}}
              </span>
              {{#if power.talentNeedsPermission}}
                <span class="tag warn" data-tooltip="{{localize 'GWORLD.Psi.OverCapHint' cap=power.talentCap}}">
                  {{localize "GWORLD.Psi.OverCap" cap=power.talentCap}}
                </span>
              {{/if}}
            {{else if power.talentName}}
              <span class="tag" data-tooltip="{{localize 'GWORLD.Psi.TalentHint'}}">
                {{localize "GWORLD.Psi.HelpedBy" talent=power.talentName}}
              </span>
            {{/if}}
            {{#if power.latent}}
              <span class="tag" data-tooltip="{{localize 'GWORLD.Psi.LatentHint'}}">
                {{localize "GWORLD.Psi.Latent"}}
              </span>
            {{/if}}
            {{#each power.rollButtons as |roll|}}
              <span class="tag rollable" data-action="roll" data-roll-type="attribute"
                    data-roll-label="{{roll.label}}" data-roll-target="{{roll.target}}"
                    data-tooltip="{{localize 'GWORLD.Psi.UseRollHint'}}">{{roll.key}} {{roll.target}}</span>
            {{/each}}
          </span>
          <span class="td">
            {{#if power.abilities.length}}
              {{#each power.abilities as |name|}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}
            {{else}}
              {{localize "GWORLD.Psi.NoAbilities"}}
              {{#if power.couldManifestText}}
                <span class="ihint">{{localize "GWORLD.Psi.CouldManifest" abilities=power.couldManifestText}}</span>
              {{/if}}
            {{/if}}
          </span>
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{> "gworld.addonSections"}}

</section>
