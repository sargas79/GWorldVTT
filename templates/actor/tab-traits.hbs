<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{#each traitGroups as |group|}}
    <div class="isec">
      <div class="ish">
        <span class="num">{{group.num}}</span>{{localize group.label}}
        <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
          {{group.total}} pts
        </span>
      </div>

      {{#each group.traits as |trait|}}
        <div class="trait blueprint" data-item-id="{{trait.id}}">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <span class="tn">
            <span data-action="editItem">{{trait.name}}</span>
            {{#if trait.levelled}}
              {{#if @root.editable}}
                {{!-- Ids so focus survives the redraw that follows every edit. --}}
                <span class="tag taglevels ptstep">
                  <button type="button" data-action="stepLevels" data-step="down"
                          id="{{@root.sheetId}}-{{trait.id}}-down"
                          aria-label="{{localize "GWORLD.Trait.OneLess"}}"
                          title="{{localize "GWORLD.Trait.OneLess"}}">&minus;</button>
                  <input type="number" min="0" step="1" value="{{trait.system.levels}}"
                         id="{{@root.sheetId}}-{{trait.id}}-levels"
                         data-item-field="system.levels"
                         aria-label="{{localize "GWORLD.Trait.Levels"}}" />
                  <button type="button" data-action="stepLevels" data-step="up"
                          id="{{@root.sheetId}}-{{trait.id}}-up"
                          aria-label="{{localize "GWORLD.Trait.OneMore"}}"
                          title="{{localize "GWORLD.Trait.OneMore"}}">+</button>
                  <span>{{#if trait.levelName}}{{trait.levelName}}{{else}}{{localize "GWORLD.Trait.Levels"}}{{/if}}</span>
                </span>
              {{else}}
                <span class="tag">
                  {{trait.system.levels}}
                  {{#if trait.levelName}}{{trait.levelName}}{{else}}{{localize "GWORLD.Trait.Levels"}}{{/if}}
                </span>
              {{/if}}
            {{/if}}
            {{#if trait.applied}}
              <span class="tag tag-accent" data-tooltip="{{localize "GWORLD.Trait.AppliedHint"}}">
                {{localize "GWORLD.Trait.Applied"}}
              </span>
            {{/if}}
            {{#if trait.system.reactionModifier}}
              <span class="tag tag-accent">{{signed trait.system.reactionModifier}} {{localize "GWORLD.Trait.Reaction"}}</span>
            {{/if}}
          </span>
          <span class="tp {{#if group.negative}}neg{{/if}}">{{trait.system.totalPoints}}</span>
          {{#if @root.editable}}
            <button type="button" class="tdel rollable iconbtn" data-action="deleteItem"
                  title="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
          {{/if}}
          {{#if trait.system.description}}
            <span class="td">{{{trait.system.description}}}</span>
          {{/if}}
        </div>
      {{/each}}

      {{#if @root.editable}}
        <div class="toolbar" style="align-self: flex-start">
          <button type="button" class="ibtn"
                  data-action="createItem" data-item-type="trait" data-category="{{group.category}}">
            + {{localize group.addLabel}}
          </button>
          <button type="button" class="ibtn" data-action="browseCompendium"
                  data-item-types="trait" data-categories="{{group.categories}}"
                  data-browse-title="{{group.browseTitle}}">
            {{> "gworld.search"}} {{localize "GWORLD.Action.BrowseTraits"}}
          </button>
        </div>
      {{/if}}
    </div>
  {{/each}}

  <div class="meterwrap">
    <div style="display: flex; justify-content: space-between; font-size: 11px">
      <span class="fl">{{localize "GWORLD.Section.DisadvantageLimit"}}</span>
      <span><strong>{{derived.points.disadvantageTotal}}</strong> of {{derived.points.disadvantageLimit}}</span>
    </div>
    <div class="meter">
      <div class="mfill {{#if disadvantageOverLimit}}over{{/if}}"
           style="width: {{percent derived.points.disadvantageTotal derived.points.disadvantageLimit}}%"></div>
    </div>
    <div style="font-size: 11px; color: var(--color-neutral-700)">
      {{localize "GWORLD.Hint.DisadvantageLimit"}}
    </div>
  </div>

</section>
