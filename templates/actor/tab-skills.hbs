<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="toolbar">
    <div class="srch">
      {{> "gworld.search"}}
      <input type="search" class="gworld-skill-filter" placeholder="{{localize 'GWORLD.Action.FilterSkills'}}"
             autocomplete="off" data-tooltip="{{localize 'GWORLD.Action.FilterSkills'}}">
    </div>
    {{!-- One list or six: by attribute as the printed sheet has it, or one
         alphabetical run for people who know their skills by name. --}}
    <button type="button" class="ibtn" data-action="toggleSkillOrder"
            data-tooltip="{{localize 'GWORLD.Settings.SkillOrder.Hint'}}">
      {{#if skillOrderAlphabetical}}{{localize "GWORLD.Action.OrderByAttribute"}}{{else}}{{localize "GWORLD.Action.OrderByName"}}{{/if}}
    </button>
    {{#if editable}}
      <button type="button" class="ibtn" data-action="createItem" data-item-type="technique">
        {{> "gworld.plus"}} {{localize "GWORLD.Action.AddTechnique"}}
      </button>
      <button type="button" class="ibtn" data-action="createItem" data-item-type="skill">
        {{> "gworld.plus"}} {{localize "GWORLD.Action.AddSkill"}}
      </button>
      <button type="button" class="ibtn" data-action="browseCompendium"
              data-item-types="skill,technique" data-browse-title="GWORLD.Picker.Skills">
        {{> "gworld.search"}} {{localize "GWORLD.Action.BrowseSkills"}}
      </button>
      {{#if rules.study}}
        <button type="button" class="ibtn" data-action="study"
                data-tooltip="{{localize 'GWORLD.Life.StudyHint'}}">
          {{localize "GWORLD.Life.Study"}}
        </button>
      {{/if}}
    {{/if}}
  </div>

  {{!-- Every skill sits in its group, trained or not. An untrained one is
       dimmed and marked as rolled at default, rather than filed under a
       heading of its own that it leaves the moment a point is spent. --}}
  {{#each items.skillGroups as |group|}}
    <div class="isec" style="gap: 0">
      <div class="grph">
        {{#if group.attribute}}
          {{group.attribute}}-{{localize "GWORLD.Section.Based"}}
          <span class="sub">{{group.attribute}} {{group.score}}</span>
        {{else}}
          {{localize "GWORLD.Section.AllSkills"}}
          <span class="sub">{{localize "GWORLD.Section.Alphabetical"}}</span>
        {{/if}}
      </div>
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Skill"}}</th>
            <th>{{localize "GWORLD.Column.Type"}}</th>
            <th class="n">{{localize "GWORLD.Column.Pts"}}</th>
            <th class="n">{{localize "GWORLD.Column.Relative"}}</th>
            <th class="n">{{localize "GWORLD.Column.Level"}}</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each group.rows as |row|}}
            {{#with row.skill.item as |skill|}}
            <tr data-item-id="{{skill.id}}" {{#unless row.trained}}class="dim"{{/unless}}>
              <td>
                <span class="wname" data-action="editItem">{{skill.name}}</span>
                {{#if skill.system.techLevel}}<span class="wmode">TL{{skill.system.techLevel}}</span>{{/if}}
                {{#unless row.trained}}
                  <span class="tag" data-tooltip="{{localize 'GWORLD.Section.RolledAtDefault'}}">{{localize "GWORLD.Skill.Untrained"}}</span>
                {{/unless}}
              </td>
              <td class="wmode">{{skill.system.attribute}}/{{skill.system.difficulty}}</td>
              <td class="n">
                {{#if @root.editable}}
                  {{!-- Each control carries an id so focus survives the redraw
                       that follows every edit; without one, Tab from the points
                       field lands nowhere. --}}
                  <span class="ptstep">
                    <button type="button" data-action="stepPoints" data-step="down"
                            id="{{@root.sheetId}}-{{skill.id}}-down"
                            aria-label="{{localize "GWORLD.Skill.SpendLess"}}"
                            title="{{localize "GWORLD.Skill.SpendLess"}}">&minus;</button>
                    <input type="number" class="npts" min="0" step="1"
                           id="{{@root.sheetId}}-{{skill.id}}-pts"
                           value="{{skill.system.points}}" data-item-field="system.points"
                           aria-label="{{localize "GWORLD.Column.Pts"}}" />
                    <button type="button" data-action="stepPoints" data-step="up"
                            id="{{@root.sheetId}}-{{skill.id}}-up"
                            aria-label="{{localize "GWORLD.Skill.SpendMore"}}"
                            title="{{localize "GWORLD.Skill.SpendMore"}}">+</button>
                  </span>
                {{else}}{{#if row.trained}}{{skill.system.points}}{{else}}&mdash;{{/if}}{{/if}}
              </td>
              <td class="n wmode">{{relativeLabel skill}}</td>
              <td class="n">
                {{#if row.rollable}}
                  <span class="lvl">{{skill.system.derived.level}}</span>
                {{else}}
                  <span class="tag tag-danger">{{localize "GWORLD.Skill.NoDefault"}}</span>
                {{/if}}
              </td>
              <td class="c">
                {{#if row.rollable}}
                  <span class="rollable" data-action="roll" data-roll-type="skill"
                        data-roll-label="{{skill.name}}" data-roll-target="{{skill.system.derived.level}}"
                        data-based-on="{{skill.system.attribute}}">
                    {{> "gworld.die"}}
                  </span>
                {{/if}}
              </td>
              <td class="c">
                {{#if @root.editable}}
                  <button type="button" class="rollable iconbtn" data-action="deleteItem" title="{{localize 'GWORLD.Action.Delete'}}">
                    {{> "gworld.trash"}}
                  </button>
                {{/if}}
              </td>
            </tr>
            {{/with}}
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/each}}

  {{#if items.techniques.length}}
    <div class="isec" style="gap: 0">
      <div class="grph">
        {{localize "GWORLD.Section.Techniques"}}
        <span class="sub">{{localize "GWORLD.Hint.Techniques"}}</span>
      </div>
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Skill"}}</th>
            <th>{{localize "GWORLD.Column.Type"}}</th>
            <th class="n">{{localize "GWORLD.Column.Pts"}}</th>
            <th class="n">{{localize "GWORLD.Column.Relative"}}</th>
            <th class="n">{{localize "GWORLD.Column.Level"}}</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each items.techniques as |entry|}}
            <tr data-item-id="{{entry.item.id}}" {{#unless entry.resolved}}class="dim"{{/unless}}>
              <td>
                <span class="wname" data-action="editItem">{{entry.item.name}}</span>
                {{#if entry.item.system.derived.cappedByPrerequisite}}
                  <span class="tag">{{localize "GWORLD.Skill.CappedByPrerequisite"}}</span>
                {{/if}}
              </td>
              <td class="wmode">Tech/{{entry.item.system.difficulty}}</td>
              <td class="n">
                {{#if @root.editable}}
                  <span class="ptstep">
                    <button type="button" data-action="stepPoints" data-step="down"
                            id="{{@root.sheetId}}-{{entry.item.id}}-down"
                            aria-label="{{localize "GWORLD.Skill.SpendLess"}}"
                            title="{{localize "GWORLD.Skill.SpendLess"}}">&minus;</button>
                    <input type="number" class="npts" min="0" step="1"
                           id="{{@root.sheetId}}-{{entry.item.id}}-pts"
                           value="{{entry.item.system.points}}" data-item-field="system.points"
                           aria-label="{{localize "GWORLD.Column.Pts"}}" />
                    <button type="button" data-action="stepPoints" data-step="up"
                            id="{{@root.sheetId}}-{{entry.item.id}}-up"
                            aria-label="{{localize "GWORLD.Skill.SpendMore"}}"
                            title="{{localize "GWORLD.Skill.SpendMore"}}">+</button>
                  </span>
                {{else}}{{entry.item.system.points}}{{/if}}
              </td>
              <td class="n wmode">{{entry.item.system.prerequisite}}{{entry.item.system.defaultModifier}}</td>
              <td class="n">
                {{#if entry.resolved}}
                  <span class="lvl">{{entry.item.system.derived.level}}</span>
                {{else}}
                  <span class="tag tag-danger">{{localize "GWORLD.Skill.NoPrerequisite"}}</span>
                {{/if}}
              </td>
              <td class="c">
                {{#if entry.resolved}}
                  <span class="rollable" data-action="roll" data-roll-type="skill"
                        data-roll-label="{{entry.item.name}}" data-roll-target="{{entry.item.system.derived.level}}">
                    {{> "gworld.die"}}
                  </span>
                {{/if}}
              </td>
              <td class="c">
                {{#if @root.editable}}
                  <button type="button" class="rollable iconbtn" data-action="deleteItem" title="{{localize 'GWORLD.Action.Delete'}}">
                    {{> "gworld.trash"}}
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{/if}}

  <div class="npcline" style="justify-content: space-between; color: var(--color-neutral-700)">
    <span>{{skillSummary.count}} {{localize "GWORLD.Skill.Trained"}}</span>
    <span>{{derived.points.skills}} {{localize "GWORLD.Points.PointsLabel"}}</span>
  </div>

</section>
