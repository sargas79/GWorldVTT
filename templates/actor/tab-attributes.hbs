<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="isec">
    <div class="ish"><span class="num">01</span>{{localize "GWORLD.Section.BasicAttributes"}}</div>
    <div class="g4">
      {{#each attributeCards as |attr|}}
        <div class="attr blueprint">
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          <span class="iroll rollable" data-action="roll" data-roll-type="attribute"
                data-roll-label="{{attr.label}}" data-roll-target="{{attr.value}}">
            {{> "gworld.die"}}
          </span>
          <span class="al">{{attr.key}}</span>
          <input class="av" type="number" name="system.attributes.{{attr.key}}" value="{{attr.value}}"
                 {{#unless @root.editable}}disabled{{/unless}}>
          <span class="ac">{{attr.cost}} pts</span>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">02</span>{{localize "GWORLD.Section.Secondary"}}</div>
    <div class="cellgrid">
      {{#each secondaryCells as |cell|}}
        <div class="cell">
          <span class="cl">{{cell.label}}</span>
          {{#if cell.editable}}
            <span style="display: flex; align-items: baseline; gap: 6px">
              <span class="cv">{{cell.value}}</span>
              <input type="number" name="system.purchased.{{cell.key}}" value="{{cell.purchased}}"
                     step="{{cell.step}}" title="{{localize 'GWORLD.Secondary.AdjustHint'}}"
                     style="width: 46px; background: none; border: 1px solid var(--color-divider); font: inherit; color: var(--color-accent-700)"
                     {{#unless @root.editable}}disabled{{/unless}}>
            </span>
          {{else}}
            <span class="cv">{{cell.value}}</span>
          {{/if}}
          <span class="cd">{{cell.derivation}}{{#if cell.cost}} &middot; {{cell.cost}} pts{{/if}}{{#if cell.granted}} &middot; {{signed cell.granted}} {{localize "GWORLD.Secondary.Granted"}}{{/if}}</span>
        </div>
      {{/each}}
    </div>
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">03</span>{{localize "GWORLD.Section.DamageBearing"}}</div>
    <div class="g3">
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.ThrustSwing"}}</span>
        <div class="fi">
          <span class="dmg">{{derived.thrust}} / {{derived.swing}}</span>
          {{> "gworld.die"}}
        </div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Posture"}}</span>
        <div class="fi">
          <select name="system.posture" {{#unless editable}}disabled{{/unless}}>
            {{#each postures as |posture|}}
              <option value="{{posture.key}}" {{#if posture.selected}}selected{{/if}}>{{posture.label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Encumbrance"}}</span>
        <div class="fi">
          <span>{{localize (concat "GWORLD.Encumbrance." derived.encumbrance.key)}} &middot; {{decimal derived.encumbrance.carriedWeight 1}} lb</span>
          {{#if derived.encumbrance.dodgePenalty}}
            <span style="font-size: 10px; letter-spacing: .06em; color: var(--color-accent-700)">
              {{derived.encumbrance.dodgePenalty}} DODGE
            </span>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  {{#if rules.physicalActivities}}
  <div class="isec">
    <div class="ish"><span class="num">04</span>{{localize "GWORLD.Section.PhysicalFeats"}}</div>
    <div class="cellgrid">
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.HighJump"}}</span>
        <span class="cv">{{derived.feats.jumping.high}}"</span>
        <span class="cd">{{localize "GWORLD.Feats.WithRun" value=derived.feats.jumping.highRunning}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.BroadJump"}}</span>
        <span class="cv">{{derived.feats.jumping.broad}} ft</span>
        <span class="cd">{{localize "GWORLD.Feats.WithRun" value=derived.feats.jumping.broadRunning}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.Lift"}}</span>
        <span class="cv">{{derived.feats.lift.twoHanded}} lb</span>
        <span class="cd">{{localize "GWORLD.Feats.OneHanded" value=derived.feats.lift.oneHanded}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.Shove"}}</span>
        <span class="cv">{{derived.feats.lift.shove}} lb</span>
        <span class="cd">{{localize "GWORLD.Feats.Running" value=derived.feats.lift.runningShove}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.CarryOnBack"}}</span>
        <span class="cv">{{derived.feats.lift.carryOnBack}} lb</span>
        <span class="cd">{{localize "GWORLD.Feats.Shift" value=derived.feats.lift.shiftSlightly}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.Sprint"}}</span>
        <span class="cv">{{derived.feats.running.sprint}}</span>
        <span class="cd">{{localize "GWORLD.Feats.Paced"}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.WaterMove"}}</span>
        <span class="cv">{{derived.feats.swimming.move}}</span>
        <span class="cd">{{localize "GWORLD.Feats.SwimSkill"}} {{derived.feats.swimming.skill}}</span>
      </div>
      <div class="cell">
        <span class="cl">{{localize "GWORLD.Feats.Climbing"}}</span>
        <span class="cv">{{derived.feats.climbing.skill}}</span>
        <span class="cd">{{localize "GWORLD.Feats.ClimbDefault"}}</span>
      </div>
    </div>
    <div class="toolbar">
      <button type="button" class="ibtn" data-action="climb">
        {{localize "GWORLD.Feats.Climbing"}}
      </button>
      <button type="button" class="ibtn" data-action="swim">
        {{localize "GWORLD.Feats.Swimming"}}
      </button>
      <button type="button" class="ibtn" data-action="throwObject">
        {{localize "GWORLD.Feats.Throw"}}
      </button>
    </div>
    <p class="ihint">{{localize "GWORLD.Feats.Hint"}}</p>
  </div>
  {{/if}}

  <div class="isec">
    <div class="ish"><span class="num">05</span>{{localize "GWORLD.Section.Campaign"}}</div>
    <div class="g4">
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.TechLevel"}}</span>
        <div class="fi">
          <input type="number" name="system.tl" value="{{system.tl}}" step="1" min="0"
                 style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                 {{#unless editable}}disabled{{/unless}}>
        </div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.SizeModifier"}}</span>
        <div class="fi">
          <input type="number" name="system.sm" value="{{system.sm}}" step="1"
                 style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                 {{#unless editable}}disabled{{/unless}}>
        </div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.StartingPoints"}}</span>
        <div class="fi">
          <input type="number" name="system.points.starting" value="{{system.points.starting}}" step="5" min="0"
                 style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                 {{#unless editable}}disabled{{/unless}}>
        </div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.DisadvantageLimit"}}</span>
        <div class="fi">
          <input type="number" name="system.points.disadvantageLimit" value="{{system.points.disadvantageLimit}}" step="5" min="0"
                 style="background: none; border: 0; font: inherit; color: inherit; width: 100%"
                 {{#unless editable}}disabled{{/unless}}>
        </div>
      </div>
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">06</span>{{localize "GWORLD.Section.CharacterPoints"}}</div>
    {{#if editable}}
      <div class="toolbar">
        <button type="button" class="ibtn" data-action="openBuilder">
          {{> "gworld.plus"}} {{localize "GWORLD.Builder.Open"}}
        </button>
      </div>
    {{/if}}
    <div class="ledger">
      <div class="lrow"><span>{{localize "GWORLD.Points.Attributes"}}</span><span>{{derived.points.attributes}}</span></div>
      <div class="lrow"><span>{{localize "GWORLD.Points.Secondaries"}}</span><span>{{derived.points.secondaries}}</span></div>
      <div class="lrow"><span>{{localize "GWORLD.Points.Advantages"}}</span><span>{{derived.points.advantages}}</span></div>
      <div class="lrow"><span>{{localize "GWORLD.Points.Disadvantages"}}</span><span class="neg">{{derived.points.disadvantages}}</span></div>
      <div class="lrow"><span>{{localize "GWORLD.Points.Quirks"}}</span><span class="neg">{{derived.points.quirks}}</span></div>
      <div class="lrow"><span>{{localize "GWORLD.Points.Languages"}}</span><span>{{derived.points.languages}}</span></div>
      <div class="lrow"><span>{{localize "GWORLD.Points.Skills"}}</span><span>{{derived.points.skills}}</span></div>
      <div class="lrow"><span>{{localize "GWORLD.Points.Techniques"}}</span><span>{{derived.points.techniques}}</span></div>
      <div class="lrow ltot"><span>{{localize "GWORLD.Points.Spent"}}</span><span class="{{#if overBudget}}over{{/if}}">{{derived.points.spent}} / {{derived.points.starting}}</span></div>
    </div>
    <div class="inote {{#if pointsWarning.over}}warn{{/if}}">
      {{> "gworld.info"}}
      <span>{{pointsWarning.text}}</span>
    </div>
  </div>
</section>
