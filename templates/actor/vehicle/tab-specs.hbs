{{!-- The table's columns as fields, for a vehicle the table is writing down
     itself (Campaigns pp. 462-465). Read-only for anyone who cannot edit. --}}
<section class="tab v2-tab vehicle-tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="v2-panel vehicle-specs">
    <h2 class="v2-ph">{{localize "GWORLD.Vehicle.Edit"}}</h2>
    <p class="v2-note">{{localize "GWORLD.Vehicle.SpecsHint"}}</p>
    <div class="vehicle-fields">
      {{#each specFields as |f|}}
        {{#if f.checks}}
          {{!-- A set of codes, each its own box: a label cannot hold labels. --}}
          <div class="vehicle-field"{{#if f.hint}} data-tooltip="{{f.hint}}"{{/if}}>
            <span class="v2-stat-label">{{f.label}}</span>
            <span class="vehicle-checks">
              {{#each f.checks as |c|}}
                <label class="vehicle-check"><input type="checkbox" name="{{c.name}}" value="{{c.value}}" {{#if c.checked}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}> {{c.label}}</label>
              {{/each}}
            </span>
          </div>
        {{else}}
        <label class="vehicle-field"{{#if f.hint}} data-tooltip="{{f.hint}}"{{/if}}>
          <span class="v2-stat-label">{{f.label}}</span>
          {{#if f.options}}
            <select name="{{f.name}}" {{#unless @root.editable}}disabled{{/unless}}>
              {{#each f.options as |o|}}<option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
            </select>
          {{else if f.checkbox}}
            <input type="checkbox" name="{{f.name}}" {{#if f.value}}checked{{/if}} {{#unless @root.editable}}disabled{{/unless}}>
          {{else}}
            <input type="{{f.type}}" name="{{f.name}}" value="{{f.value}}"
                   {{#if f.hasMin}}min="{{f.min}}"{{/if}} {{#if f.step}}step="{{f.step}}"{{/if}}
                   {{#unless @root.editable}}disabled{{/unless}}>
          {{/if}}
        </label>
        {{/if}}
      {{/each}}
    </div>
  </div>
  {{!-- DR by face and location (Campaigns pp. 462, 554-555); empty is the table's figure. --}}
  <div class="v2-panel vehicle-specs vehicle-dr">
    <h2 class="v2-ph">{{localize "GWORLD.Vehicle.DrFaces"}}</h2>
    <p class="v2-note">{{localize "GWORLD.Vehicle.DrFacesHint"}}</p>
    <div class="vehicle-fields">
      {{#each drFields as |f|}}
        <label class="vehicle-field">
          <span class="v2-stat-label">{{f.label}}</span>
          <input type="number" name="{{f.name}}" value="{{f.value}}" placeholder="{{f.placeholder}}" min="0" step="1"
                 {{#unless @root.editable}}disabled{{/unless}}>
        </label>
      {{/each}}
    </div>
    {{#if drLocations.length}}
      {{!-- A location's own DR, by face, and the arcs it covers where it covers only some. --}}
      <h3 class="v2-ph">{{localize "GWORLD.Vehicle.DrLocations"}}</h3>
      <p class="v2-note">{{localize "GWORLD.Vehicle.DrLocationsHint"}}</p>
      <table class="vehicle-dr-locations">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Vehicle.DrLocationColumn"}}</th>
            <th>{{localize "GWORLD.Vehicle.DrLocationFront"}}</th>
            <th>{{localize "GWORLD.Vehicle.DrLocationOther"}}</th>
            <th>{{localize "GWORLD.Vehicle.DrLocationTop"}}</th>
            <th>{{localize "GWORLD.Vehicle.DrLocationArcs"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each drLocations as |row|}}
            <tr>
              <th scope="row">{{row.label}}</th>
              {{#each row.faces as |f|}}
                <td><input type="number" name="{{f.name}}" value="{{f.value}}" placeholder="{{f.placeholder}}" min="0" step="1"
                           {{#unless @root.editable}}disabled{{/unless}}></td>
              {{/each}}
              <td class="vehicle-checks">
                {{#each row.arcs as |arc|}}
                  <label class="vehicle-check"><input type="checkbox" name="{{row.arcsName}}" value="{{arc.key}}" {{#if arc.checked}}checked{{/if}}
                         {{#unless @root.editable}}disabled{{/unless}}> {{arc.label}}</label>
                {{/each}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{/if}}
  </div>
</section>
