<section class="tab ibody{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> "gworld.addonSheetSections" sections=addonSheetSections.start}}

  {{#if npc}}
    {{!-- What only an NPC has: the one-pane NPC sheet shows these, and this
         is where they are changed. --}}
    <div class="isec">
      <div class="ish"><span class="num">00</span>{{localize "GWORLD.Npc.Section"}}</div>
      <div class="g4">
        <div class="fld">
          <span class="fl">{{localize "GWORLD.Npc.GroupSize"}}</span>
          <div class="fi"><input type="number" name="system.groupSize" value="{{system.groupSize}}" min="1" step="1" {{#unless editable}}disabled{{/unless}}></div>
        </div>
        <div class="fld" style="grid-column: span 3">
          <span class="fl">{{localize "GWORLD.Npc.Tactics"}}</span>
          <div class="fi"><input type="text" name="system.tactics" value="{{system.tactics}}"
                                 placeholder="{{localize 'GWORLD.Npc.TacticsPlaceholder'}}" {{#unless editable}}disabled{{/unless}}></div>
        </div>
      </div>
      {{#if npc.cannonFodderInPlay}}
        <label class="inote icheck" data-tooltip="{{localize 'GWORLD.Cinematic.CannonFodderHint'}}">
          <input type="checkbox" name="system.cannonFodder" {{checked system.cannonFodder}} {{#unless editable}}disabled{{/unless}}>
          <span>{{localize "GWORLD.Cinematic.CannonFodder"}}</span>
        </label>
      {{/if}}
      <label class="inote icheck">
        <input type="checkbox" name="system.swarm.isSwarm" {{checked system.swarm.isSwarm}} {{#unless editable}}disabled{{/unless}}>
        <span>{{localize "GWORLD.Npc.IsSwarm"}}</span>
      </label>
      {{#if system.swarm.isSwarm}}
        <div class="g4">
          <div class="fld">
            <span class="fl">{{localize "GWORLD.Npc.SwarmKind"}}</span>
            <div class="fi">
              <select name="system.swarm.kind" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions npc.swarmKinds selected=system.swarm.kind localize=true}}
              </select>
            </div>
          </div>
          <div class="fld">
            <span class="fl">{{localize "GWORLD.Npc.SwarmDamage"}}</span>
            <div class="fi"><input type="text" name="system.swarm.damage" value="{{system.swarm.damage}}" placeholder="1d-2" {{#unless editable}}disabled{{/unless}}></div>
          </div>
          <div class="fld">
            <span class="fl">{{localize "GWORLD.Npc.SwarmFlatInjury"}}</span>
            <div class="fi"><input type="number" name="system.swarm.flatInjury" value="{{system.swarm.flatInjury}}" min="0" step="1" {{#unless editable}}disabled{{/unless}}></div>
          </div>
          <div class="fld">
            <span class="fl">{{localize "GWORLD.Npc.SwarmDamageType"}}</span>
            <div class="fi">
              <select name="system.swarm.damageType" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions npc.damageTypes selected=system.swarm.damageType localize=true}}
              </select>
            </div>
          </div>
        </div>
        <div class="g4">
          <div class="fld" style="grid-column: span 3">
            <span class="fl">{{localize "GWORLD.Npc.SwarmAbout"}}</span>
            <div class="fi"><input type="text" name="system.swarm.about" value="{{system.swarm.about}}"
                                   placeholder="{{localize 'GWORLD.Npc.SwarmAboutPlaceholder'}}" {{#unless editable}}disabled{{/unless}}></div>
          </div>
          <label class="inote icheck">
            <input type="checkbox" name="system.swarm.flying" {{checked system.swarm.flying}} {{#unless editable}}disabled{{/unless}}>
            <span>{{localize "GWORLD.Npc.SwarmFlying"}}</span>
          </label>
        </div>
      {{/if}}
    </div>
  {{/if}}

  <div class="isec">
    <div class="ish"><span class="num">01</span>{{localize "GWORLD.Section.VitalStatistics"}}</div>
    <div class="g4">
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Player"}}</span>
        <div class="fi"><input type="text" name="system.details.player" value="{{system.details.player}}" {{#unless editable}}disabled{{/unless}}></div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Height"}}</span>
        <div class="fi"><input type="text" name="system.details.height" value="{{system.details.height}}" {{#unless editable}}disabled{{/unless}}></div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Weight"}}</span>
        <div class="fi"><input type="text" name="system.details.weight" value="{{system.details.weight}}" {{#unless editable}}disabled{{/unless}}></div>
      </div>
      <div class="fld">
        <span class="fl">{{localize "GWORLD.Field.Age"}}</span>
        <div class="fi">
          <input type="text" name="system.details.age" value="{{system.details.age}}" {{#unless editable}}disabled{{/unless}}>
          {{#if (and rules.aging derived.aging.rollsPerYear)}}
            <button type="button" class="ibtn tiny" data-action="agingRoll"
                    data-tooltip="{{localize 'GWORLD.Life.AgingHint' rolls=derived.aging.rollsPerYear}}">
              {{localize "GWORLD.Life.Aging"}}
            </button>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">02</span>{{localize "GWORLD.Section.Appearance"}}</div>
    <div class="box prose">
      <input type="text" name="system.details.appearance" value="{{system.details.appearance}}"
             placeholder="{{localize 'GWORLD.Field.AppearancePlaceholder'}}"
             style="width: 100%; background: none; border: 0; font: inherit; color: inherit"
             {{#unless editable}}disabled{{/unless}}>
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">03</span>{{localize "GWORLD.Section.Languages"}}</div>
    {{#if items.languages.length}}
      <table class="gt">
        <thead>
          <tr>
            <th>{{localize "GWORLD.Column.Language"}}</th>
            <th class="n">{{localize "GWORLD.Column.Spoken"}}</th>
            <th class="n">{{localize "GWORLD.Column.Written"}}</th>
            <th class="n">{{localize "GWORLD.Column.Pts"}}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each items.languages as |lang|}}
            <tr data-item-id="{{lang.id}}">
              <td>
                <span class="wname" data-action="editItem">{{lang.name}}</span>
                {{#if lang.system.isNative}}<span class="tag">{{localize "GWORLD.Language.Native"}}</span>{{/if}}
              </td>
              <td class="n">{{localize (concat "GWORLD.Language." lang.system.spoken)}}</td>
              <td class="n">{{localize (concat "GWORLD.Language." lang.system.written)}}</td>
              <td class="n">{{lang.system.totalPoints}}</td>
              <td class="c">
                {{#if @root.editable}}
                  <button type="button" class="rollable iconbtn" data-action="deleteItem"
                          title="{{localize 'GWORLD.Action.Delete'}}"
                          aria-label="{{localize 'GWORLD.Action.Delete'}}">{{> "gworld.trash"}}</button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{/if}}
    {{#if editable}}
      <button type="button" class="ibtn" style="align-self: flex-start"
              data-action="createItem" data-item-type="language">
        {{> "gworld.plus"}} {{localize "GWORLD.Action.AddLanguage"}}
      </button>
    {{/if}}
    <div style="font-size: 11px; color: var(--color-neutral-700)">
      {{localize "GWORLD.Hint.Languages"}}
    </div>
  </div>

  <div class="isec">
    <div class="ish"><span class="num">04</span>{{localize "GWORLD.Section.Biography"}}</div>
    <prose-mirror class="box editor prose" name="system.details.biography"
                  value="{{system.details.biography}}" toggled
                  {{#unless editable}}disabled{{/unless}}>{{{biographyHTML}}}</prose-mirror>
  </div>

  {{#if isOwner}}
    <div class="isec">
      <div class="ish">
        <span class="num">05</span>{{localize "GWORLD.Section.Notes"}}
        <span style="font-family: var(--font-body); font-size: 11px; letter-spacing: .04em; text-transform: none; color: var(--color-neutral-700)">
          {{localize "GWORLD.Hint.GMOnly"}}
        </span>
      </div>
      <prose-mirror class="box editor prose" name="system.details.notes"
                    value="{{system.details.notes}}" toggled
                    {{#unless editable}}disabled{{/unless}}>{{{notesHTML}}}</prose-mirror>
    </div>
  {{/if}}

  {{> "gworld.addonSections"}}

</section>
