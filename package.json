{
  "name": "gworld",
  "version": "0.15.0",
  "private": true,
  "description": "A GURPS Lite (4th Edition) game system for Foundry Virtual Tabletop",
  "type": "module",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "vite build && npm run build:packs",
    "watch": "vite build --watch",
    "deploy": "node tools/deploy.mjs",
    "dev": "npm run build && npm run deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:packs": "node tools/validate-packs.mjs",
    "build:packs": "node tools/validate-packs.mjs && node tools/build-packs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@types/node": "^24.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
